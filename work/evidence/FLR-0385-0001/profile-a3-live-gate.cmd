status=0; identity=/run/user/1001/flr0385-0001-a3-app.identity; log=/run/user/1001/flr0385-0001-a3-app.log; read pid saved_uid saved_start wrapper < "$identity"; if [ -r /proc/$pid/status ]; then uid=$(awk '/^Uid:/{print $2; exit}' /proc/$pid/status); start=$(awk '{print $22}' /proc/$pid/stat); else uid=none; start=none; fi; count=$(pgrep -u 1001 -x flutter-auto | wc -l); ready=$(grep -c FLUORITE_SEQUOIA_LIT_MATERIAL_READY "$log" 2>/dev/null || true); bound=$(grep -c FLUORITE_SEQUOIA_LIT_MATERIAL_BOUND "$log" 2>/dev/null || true); present=$(grep -c QUEUE_PRESENT "$log" 2>/dev/null || true); printf 'A3_LIVE pid=%s uid=%s saved_uid=%s start=%s saved_start=%s app_count=%s READY=%s BOUND=%s QUEUE_PRESENT=%s\n' "$pid" "$uid" "$saved_uid" "$start" "$saved_start" "$count" "$ready" "$bound" "$present"; if [ "$uid" = 1001 ] && [ "$saved_uid" = 1001 ] && [ "$start" = "$saved_start" ] && [ "$count" -eq 1 ] && [ "$ready" -ge 1 ] && [ "$bound" -eq 24 ]; then ps -p "$pid" -o pid=,uid=,comm=,args=; echo A3_LIVE_GATE=PASS; else echo A3_LIVE_GATE=FAIL; status=1; fi; grep -Ei 'Application Id:|FLUORITE_SEQUOIA_LIT_MATERIAL_(READY|BOUND|BUILD_FAILED)|QUEUE_PRESENT|Oops|SIGSEGV|page fault' "$log" 2>/dev/null | tail -30; test "$status" -eq 0
