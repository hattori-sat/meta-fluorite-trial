identity=/run/user/1001/flr0385-0001-a4-app.identity; read pid saved_uid saved_start wrapper < "$identity"; apps=$(pgrep -u 1001 -x flutter-auto || true); set -- $apps; app_count=$#; if [ -r /proc/$pid/status ]; then uid=$(awk '/^Uid:/{print $2; exit}' /proc/$pid/status); start=$(awk '{print $22}' /proc/$pid/stat); else uid=none; start=none; fi; if [ "$uid" = 1001 ] && [ "$start" = "$saved_start" ] && [ "$app_count" -eq 1 ] && [ "$1" = "$pid" ]; then kill -TERM "$pid" && echo "A4_APP_STOP=SIGTERM_SENT pid=$pid uid=$uid start=$start"; sleep 2; else echo "A4_APP_STOP=NO_SIGNAL pid=$pid uid=$uid start=$start saved_start=$saved_start app_count=$app_count wrapper=$wrapper"; fi; apps=$(pgrep -u 1001 -x flutter-auto || true); set -- $apps; if [ "$#" -eq 0 ]; then echo A4_APP_RESIDUAL=0; else echo "A4_APP_RESIDUAL=$*"; exit 1; fi; if [ -r /proc/$wrapper/stat ]; then echo "A4_WRAPPER_RESIDUAL=present pid=$wrapper"; else echo A4_WRAPPER_RESIDUAL=0; fi; true
