( set -eu; run_id=flr0414-0001; identity=/run/user/1001/${run_id}.identity; app_log=/run/user/1001/${run_id}-app.log; gdb_log=/run/user/1001/${run_id}-gdb.log; read pid uid start fault_baseline < "$identity"; current_uid=$(awk '/^Uid:/ {print $2; exit}' "/proc/$pid/status" 2>/dev/null || true); current_start=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null || true); current_comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); if [ "$current_uid" = "$uid" ] && [ "$current_start" = "$start" ] && [ "$current_comm" = flutter-auto ]; then identity_status=LIVE; ps -L -p "$pid" -o pid=,tid=,stat=,wchan:28=,comm= | head -n 32 || true; else identity_status=CHANGED_OR_EXITED; fi; app_bytes=$(wc -c < "$app_log" | tr -d ' '); app_sha=$(sha256sum "$app_log" | awk '{print $1}'); printf 'FLR0414_EVIDENCE pid=%s uid=%s start=%s app_identity=%s app_log_bytes=%s app_log_sha256=%s fault_baseline=%s\n' "$pid" "$uid" "$start" "$identity_status" "$app_bytes" "$app_sha" "$fault_baseline"; for marker in FLR0026_SHAPE_READY FLR0026_VK_QUEUE_PRESENT_BEGIN 'FLR0026_VK_QUEUE_PRESENT result=' FLUORITE_VK_PRESENT_CALL_BEGIN FLUORITE_VK_QUEUE_PRESENT_ENTER FLUORITE_VK_QUEUE_PRESENT_RETURN FLUORITE_VK_PRESENT_DONE FLUORITE_NATIVE_WAYLAND_COMMIT; do count=$(grep -o "$marker" "$app_log" 2>/dev/null | wc -l | tr -d ' ' || true); printf 'FLR0414_COUNT marker=%s count=%s\n' "$marker" "${count:-0}"; done; if [ "$app_bytes" -le 700000 ]; then echo FLR0414_APP_LOG_BEGIN; cat "$app_log"; echo FLR0414_APP_LOG_END; else echo FLR0414_APP_LOG_TRUNCATED_HEAD_BEGIN; head -c 100000 "$app_log"; echo FLR0414_APP_LOG_HEAD_END; tail -c 600000 "$app_log"; echo FLR0414_APP_LOG_TAIL_END; fi; if [ -s "$gdb_log" ]; then echo FLR0414_GDB_LOG_BEGIN; cat "$gdb_log"; echo FLR0414_GDB_LOG_END; sha256sum "$gdb_log"; else echo FLR0414_GDB_LOG=MISSING; fi; echo FLR0414_DMESG_TAIL_BEGIN; /usr/bin/timeout --signal=TERM --kill-after=1s 2 dmesg 2>/dev/null | tail -n 100; echo FLR0414_DMESG_TAIL_END; echo FLR0414_JOURNAL_KERNEL_TAIL_BEGIN; /usr/bin/timeout --signal=TERM --kill-after=1s 2 journalctl -k -b -o short-monotonic --no-pager 2>/dev/null | tail -n 100; echo FLR0414_JOURNAL_KERNEL_TAIL_END; )
