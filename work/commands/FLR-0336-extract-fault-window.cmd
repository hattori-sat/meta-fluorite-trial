trace=/run/flr0336-pagefault.data; text=/run/flr0336-fault-window.trace.txt; timeout 20s perf script --ns --time '422.49,422.51' --max-stack 32 -i "$trace" >"$text" 2>&1; status=$?; echo perf_script_status=$status; echo fault_window_lines=$(wc -l < "$text"); sed -n '1,200p' "$text"; echo exact_kernel_oops; journalctl -k -b -o short-monotonic --no-pager | awk '/BUG: unable to handle page fault|Oops:|CPU: 0 PID: 710|RIP: 0033:/ {active=1; left=24} active && left>0 {print; left--}' | tail -n 60; echo FLR0336_FAULT_WINDOW_DONE
