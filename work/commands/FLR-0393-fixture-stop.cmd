set -eu; identity=/run/user/1001/flr0393-0001-app.identity; read pid saved_uid saved_start wrapper < "$identity"; if [ -r "/proc/$pid/status" ]; then uid=$(stat -c %u "/proc/$pid"); start=$(awk '{print $22}' "/proc/$pid/stat"); apps=$(pgrep -u 1001 -x flutter-auto || true); set -- $apps; if [ "$uid" = "$saved_uid" ] && [ "$start" = "$saved_start" ] && [ "$#" -eq 1 ] && [ "$1" = "$pid" ]; then kill -TERM "$pid"; echo FLR0393_APP_STOP=SIGTERM_SENT; else echo FLR0393_APP_STOP=NO_SIGNAL identity_or_count_changed; fi; else echo FLR0393_APP_STOP=already_exited; fi; sleep 1; apps=$(pgrep -u 1001 -x flutter-auto || true); set -- $apps; echo FLR0393_APP_RESIDUAL=$#
