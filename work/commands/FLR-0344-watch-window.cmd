gdb_pidfile=/run/user/1001/flr0344-gdb-watch.pid; gdb_log=/run/user/1001/flr0344-gdb-watch.log; if [ ! -s "$gdb_pidfile" ] || ! grep -Fq FLR0344_WATCHPOINTS_ARMED=1 "$gdb_log"; then echo FLR0344_WATCH_WINDOW=FAIL precondition-not-armed; sed -n '1,80p' "$gdb_log"; else gp=$(cat "$gdb_pidfile"); start=$(cut -d' ' -f1 /proc/uptime); hit=0; expired=0; while :; do now=$(cut -d' ' -f1 /proc/uptime); expired=$(awk -v s="$start" -v n="$now" 'BEGIN { if (n-s >= 8.0) print 1; else print 0 }'); if [ "$expired" -eq 1 ]; then break; fi; if grep -Fq 'Old value = ' "$gdb_log"; then hit=1; break; fi; state=$(ps -p "$gp" -o stat= 2>/dev/null | tr -d ' '); if [ -z "$state" ] || [ "${state#Z}" != "$state" ] || [ "$(cat "/proc/$gp/comm" 2>/dev/null || true)" != gdb ]; then break; fi; sleep 0.1; done; elapsed=$(awk -v s="$start" -v n="$(cut -d' ' -f1 /proc/uptime)" 'BEGIN { printf "%.2f", n-s }'); state=$(ps -p "$gp" -o stat= 2>/dev/null | tr -d ' '); if [ "$hit" -eq 1 ]; then echo "FLR0344_WATCH_WINDOW=HIT elapsed=$elapsed"; elif [ "$expired" -eq 1 ]; then if [ -n "$state" ] && [ "${state#Z}" = "$state" ] && [ "$(cat "/proc/$gp/comm" 2>/dev/null || true)" = gdb ]; then kill -INT "$gp"; fi; echo "FLR0344_WATCH_WINDOW=NO_HIT_LIMIT_REACHED elapsed=$elapsed"; else echo "FLR0344_WATCH_WINDOW=GDB_EXITED_BEFORE_LIMIT elapsed=$elapsed"; fi; i=0; while [ "$i" -lt 10 ]; do state=$(ps -p "$gp" -o stat= 2>/dev/null | tr -d ' '); [ -n "$state" ] && [ "${state#Z}" = "$state" ] && [ "$(cat "/proc/$gp/comm" 2>/dev/null || true)" = gdb ] || break; sleep 0.2; i=$((i + 1)); done; state=$(ps -p "$gp" -o stat= 2>/dev/null | tr -d ' '); if [ -n "$state" ] && [ "${state#Z}" = "$state" ] && [ "$(cat "/proc/$gp/comm" 2>/dev/null || true)" = gdb ]; then kill -TERM "$gp"; echo FLR0344_GDB_TERM_FALLBACK=sent; fi; wait "$gp" 2>/dev/null || true; echo FLR0344_GDB_TRANSCRIPT_BEGIN; sed -n '1,100p' "$gdb_log"; echo FLR0344_GDB_TRANSCRIPT_END; fi
