printf '%s\n' RUNTIME_BOUNDARY; grep -n -E 'FLUORITE_NATIVE_(PURE_FIXTURE|MINIMAL_GEOMETRY|FIXTURE_LOCAL_CAMERA)|FLUORITE_VIEWTARGET_(EFFECTIVE_CONTRACT|DRAW_FRAME_BEGIN|BEGIN_FRAME|RENDER_RETURN|END_FRAME)|FLR0026_(PIPELINE_STATE|TARGET_DRAW2|VK_(SWAPCHAIN_PIXEL|QUEUE_PRESENT|PRESENT_BOUNDARY|READBACK|COMMIT|WAYLAND))|wl_(surface|subsurface).*\.(attach|damage|frame|commit|set_position)|ERROR|FATAL|segfault|SIGSEGV|failed|FAIL' /tmp/flr0200-runtime.log | tail -n 260 || true; printf '%s\n' PROCESS; ps -o pid,ppid,user,stat,etime,wchan:32,comm,args -p "$(cat /tmp/flr0200-app.pid 2>/dev/null)" 2>/dev/null || true; printf '%s\n' COREDUMP; coredumpctl list --no-legend 2>/dev/null | tail -n 20 || true; printf '%s\n' JOURNAL_ERRORS; journalctl -b -p err..alert --no-pager -n 20 2>/dev/null || true
