waitfile=/run/user/1001/flr0350-matched-wait; symbolfile=/run/user/1001/flr0350-symbols-ready; pid=$(cat /run/user/1001/flr0350-flutter.pid 2>/dev/null || true); gpid=$(cat /run/user/1001/flr0350-gdb.pid 2>/dev/null || true); expected=$(cat /run/user/1001/flr0350-wrapper.start 2>/dev/null || true); expected_gstart=$(cat /run/user/1001/flr0350-gdb.start 2>/dev/null || true); go_uptime=$(cat /run/user/1001/flr0350-go-uptime 2>/dev/null || true); outcome=OPEN; i=0; if ! grep -q '^FLR0350_SYMBOL_GATE=PASS ' "$symbolfile" 2>/dev/null; then cat "$symbolfile" 2>/dev/null || true; outcome=SYMBOL_GATE_FAILED; elif [ -z "$go_uptime" ]; then outcome=GO_TIME_UNKNOWN; else while [ "$i" -lt 32 ]; do gcomm=$(cat "/proc/$gpid/comm" 2>/dev/null || true); gstart=$(awk '{sub(/^.*\) /,""); print $20}' "/proc/$gpid/stat" 2>/dev/null || true); guid=$(awk '/^Uid:/ {print $2; exit}' "/proc/$gpid/status" 2>/dev/null || true); appcomm=$(cat "/proc/$pid/comm" 2>/dev/null || true); appstart=$(awk '{sub(/^.*\) /,""); print $20}' "/proc/$pid/stat" 2>/dev/null || true); appuid=$(awk '/^Uid:/ {print $2; exit}' "/proc/$pid/status" 2>/dev/null || true); tracer=$(awk '/^TracerPid:/ {print $2; exit}' "/proc/$pid/status" 2>/dev/null || true); if [ "$gcomm" != gdb ] || [ "$gstart" != "$expected_gstart" ] || [ "$guid" != 0 ] || [ "$appcomm" != flutter-auto ] || [ "$appstart" != "$expected" ] || [ "$appuid" != "$(id -u agl-driver)" ] || [ "$tracer" != "$gpid" ]; then outcome=PROCESS_IDENTITY_LOST; break; fi; if [ -s "$waitfile" ]; then if grep -q 'watchpoints=PASS' "$waitfile"; then outcome=PASS; else outcome=WATCHPOINTS_FAILED; fi; break; fi; elapsed=$(awk -v s="$go_uptime" -v n="$(cut -d' ' -f1 /proc/uptime)" 'BEGIN {printf "%.2f",n-s}'); expired=$(awk -v e="$elapsed" 'BEGIN {print (e >= 180.0) ? 1 : 0}'); if [ "$expired" -eq 1 ]; then outcome=WINDOW_EXPIRED; break; fi; sleep 0.5; i=$((i + 1)); done; fi; now=$(cut -d' ' -f1 /proc/uptime); elapsed=$(awk -v s="${go_uptime:-$now}" -v n="$now" 'BEGIN {printf "%.2f",n-s}'); if [ -s "$waitfile" ]; then cat "$waitfile"; fi; echo "FLR0350_WAIT_POLL=$outcome polls=$i elapsed_since_go=$elapsed guest_uptime=$now gdb_start=${gstart:-unknown} app_start=${appstart:-unknown}"
