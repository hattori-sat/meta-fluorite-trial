gdb_pidfile=/run/user/1001/flr0344-gdb-watch.pid; gdb_log=/run/user/1001/flr0344-gdb-watch.log; if [ -s "$gdb_pidfile" ]; then gp=$(cat "$gdb_pidfile"); comm=$(cat "/proc/$gp/comm" 2>/dev/null || true); [ -n "$comm" ] || comm=exited; echo "gdb_comm=$comm"; else echo gdb_pid_file=missing; fi; if [ -s "$gdb_log" ]; then grep -E 'FLR0344_|Hardware watchpoint|Old value|New value|Program received signal|error:|Error|Cannot|cannot|ptrace|Undefined|No such|Failed|failed|Exception|^#([0-9]+) ' "$gdb_log" | tail -n 80 || { echo gdb_selected_lines=none; sed -n '1,80p' "$gdb_log"; }; else echo gdb_log=missing; fi
