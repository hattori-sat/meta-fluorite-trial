( set -eu; read pid saved_uid saved_start fault_baseline < /run/user/1001/flr0405-0003.identity; test "$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status")" = "$saved_uid"; test "$(awk '{print $22}' "/proc/$pid/stat")" = "$saved_start"; log=/run/user/1001/flr0405-0003-app.log; bytes=$(wc -c < "$log"); test "$bytes" -le 900000; printf 'FLR0405_APPLOG_BEGIN pid=%s start=%s bytes=%s fault_baseline=%s\n' "$pid" "$saved_start" "$bytes" "$fault_baseline"; cat "$log"; printf '\nFLR0405_APPLOG_END\n'; )
