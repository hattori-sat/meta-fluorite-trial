( set -eu; identity=/run/user/1001/fluorite-0408-0001.identity; log=/run/user/1001/fluorite-0408-0001-app.log; read pid uid start fault_baseline < "$identity"; current_uid=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status" 2>/dev/null || true); proc_state=$(awk '{print $3,$22}' "/proc/$pid/stat" 2>/dev/null || true); proc_comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); current_pids=$(pgrep -u 1001 -x flutter-auto 2>/dev/null || true); set -- $proc_state; if [ "$#" -ne 2 ] || [ "$current_uid" != "$uid" ] || [ "$2" != "$start" ] || [ "$proc_comm" != flutter-auto ] || [ "$current_pids" != "$pid" ] || [ "$1" = Z ] || [ "$1" = T ] || [ "$1" = t ]; then echo FLUORITE0408_IDENTITY status=CHANGED; exit 1; fi; bytes=$(wc -c < "$log"); test "$bytes" -le 900000; begins=$(grep -o 'FLR0026_VK_QUEUE_PRESENT_BEGIN' "$log" | wc -l | tr -d ' ' || true); returns=$(grep -o 'FLR0026_VK_QUEUE_PRESENT result=' "$log" | wc -l | tr -d ' ' || true); successes=$(grep -o 'FLR0026_VK_QUEUE_PRESENT result=0 ' "$log" | wc -l | tr -d ' ' || true); kernel_dump=$(/usr/bin/timeout --signal=TERM --kill-after=1s 2 dmesg 2>/dev/null); faults=$(printf '%s\n' "$kernel_dump" | grep -Ec 'BUG: unable to handle page fault|Oops:|kernel BUG|Out of memory|Killed process' || true); unset kernel_dump; printf 'FLUORITE0408_IDENTITY status=LIVE pid=%s uid=%s start=%s state=%s log_bytes=%s present_begin=%s present_return=%s present_success=%s kernel_faults=%s baseline=%s\n' "$pid" "$uid" "$start" "$1" "$bytes" "$begins" "$returns" "$successes" "$faults" "$fault_baseline"; grep -E 'FLUORITE0408_|FLR0026_MODEL_(SELECTED|LOAD_PLAN|STAGE_)|FLR0026_RENDERABLE_SAMPLE|FLR0026_VK_QUEUE_PRESENT|FLR0026_FRAME_BEGIN|FLR0026_WAYLAND_SUBSURFACE_PLACED_ABOVE|Oops:|BUG:|page fault|Out of memory|Killed process' "$log" | tail -n 80 || true; )
