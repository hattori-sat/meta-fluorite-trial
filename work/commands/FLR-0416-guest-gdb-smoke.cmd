( set -eu; r=/run/user/1001/flr0416-0001; test "$(id -u agl-driver)" = 1001; test -r "$r/FLR-0416-gdb-smoke.gdb"; test -r "$r/flr0416_gdb_observer.py"; test -r "$r/flr0416_gdb_callback.py"; test ! -e "$r/gdb-smoke.log"; test ! -e "$r/pidfd-smoke.log"; test -z "$(pgrep -u 1001 -x flutter-auto || true)"; test -z "$(pgrep -u 1001 -x gdb || true)"; python3 -c 'import os,signal; assert callable(getattr(os,"pidfd_open",None)); assert callable(getattr(signal,"pidfd_send_signal",None)); print("FLR0416_PIDFD_API=PASS")' > "$r/pidfd-smoke.log" 2>&1; grep -q '^FLR0416_PIDFD_API=PASS$' "$r/pidfd-smoke.log"; su -s /bin/sh agl-driver -c "env -i HOME=/home/agl-driver PATH=/usr/bin:/bin /usr/bin/timeout -k 1s 10s /usr/bin/gdb -q -nx -nh -batch -x $r/FLR-0416-gdb-smoke.gdb" > "$r/gdb-smoke.log" 2>&1; grep -q '^FLR0416_GDB_PYTHON_API=PASS$' "$r/gdb-smoke.log"; echo FLR0416_GDB_SMOKE=PASS app=NOT_STARTED hwbp=NOT_ATTEMPTED; )
