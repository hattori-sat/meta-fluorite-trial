fault=$(journalctl -k -b -o short-monotonic --no-pager -n 200 2>/dev/null | awk '/BUG: unable to handle page fault/ {t=$2; gsub(/[\[\]]/, "", t); print "time=" t; exit}'); printf 'guest_uptime='; cut -d' ' -f1 /proc/uptime; if [ -n "$fault" ]; then echo "fault_found=yes $fault"; echo FLR0337_FAULT_FOUND; else echo fault_found=no; echo FLR0337_FAULT_NOT_YET; fi; echo FLR0337_POLL_DONE
