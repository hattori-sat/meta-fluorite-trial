pidfile=/run/user/1001/flr0343-flutter.pid; gdb_pidfile=/run/user/1001/flr0343-gdb-watch.pid; gdb_log=/run/user/1001/flr0343-gdb-watch.log; gdb_script=/run/user/1001/flr0343-sync-watch.gdb; pid=$(cat "$pidfile" 2>/dev/null || true); comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); if [ "$comm" != flutter-auto ] || [ ! -r "$gdb_script" ] || [ -e "$gdb_pidfile" ] || [ -e "$gdb_log" ]; then echo FLR0343_GDB_START=FAIL precondition; else /bin/sh -c 'trap - INT; exec /usr/bin/gdb -q -batch -p "$1" -x "$2"' _ "$pid" "$gdb_script" </dev/null >"$gdb_log" 2>&1 & gp=$!; printf '%s\n' "$gp" >"$gdb_pidfile"; echo "FLR0343_GDB_PID=$gp"; armed=0; i=0; while [ "$i" -lt 40 ]; do if grep -Fq FLR0343_WATCHPOINTS_ARMED=1 "$gdb_log"; then armed=1; break; fi; if [ "$(cat "/proc/$gp/comm" 2>/dev/null || true)" != gdb ]; then break; fi; sleep 0.25; i=$((i + 1)); done; if [ "$armed" -ne 1 ]; then echo FLR0343_WATCH_SETUP=FAIL armed-marker-not-observed-within-10s; if [ "$(cat "/proc/$gp/comm" 2>/dev/null || true)" = gdb ]; then kill -INT "$gp"; fi; i=0; while [ "$i" -lt 10 ] && [ "$(cat "/proc/$gp/comm" 2>/dev/null || true)" = gdb ]; do sleep 0.2; i=$((i + 1)); done; if [ "$(cat "/proc/$gp/comm" 2>/dev/null || true)" = gdb ]; then kill -TERM "$gp"; fi; wait "$gp" 2>/dev/null || true; else echo FLR0343_WATCHPOINTS_ARMED=1; start=$(cut -d' ' -f1 /proc/uptime); hit=0; expired=0; while :; do now=$(cut -d' ' -f1 /proc/uptime); expired=$(awk -v s="$start" -v n="$now" 'BEGIN { if (n-s >= 8.0) print 1; else print 0 }'); if [ "$expired" -eq 1 ]; then break; fi; if grep -Fq 'Old value = ' "$gdb_log"; then hit=1; break; fi; if [ "$(cat "/proc/$gp/comm" 2>/dev/null || true)" != gdb ]; then break; fi; sleep 0.1; done; elapsed=$(awk -v s="$start" -v n="$(cut -d' ' -f1 /proc/uptime)" 'BEGIN { printf "%.2f", n-s }'); if [ "$hit" -eq 1 ]; then echo "FLR0343_WATCH_WINDOW=HIT elapsed=$elapsed"; elif [ "$expired" -eq 1 ]; then if [ "$(cat "/proc/$gp/comm" 2>/dev/null || true)" = gdb ]; then kill -INT "$gp"; fi; echo "FLR0343_WATCH_WINDOW=NO_HIT_LIMIT_REACHED elapsed=$elapsed"; else echo "FLR0343_WATCH_WINDOW=GDB_EXITED_BEFORE_LIMIT elapsed=$elapsed"; fi; i=0; while [ "$i" -lt 10 ] && [ "$(cat "/proc/$gp/comm" 2>/dev/null || true)" = gdb ]; do sleep 0.2; i=$((i + 1)); done; if [ "$(cat "/proc/$gp/comm" 2>/dev/null || true)" = gdb ]; then kill -TERM "$gp"; echo FLR0343_GDB_TERM_FALLBACK=sent; fi; wait "$gp" 2>/dev/null || true; grep -E 'FLR0343_|Hardware watchpoint|Old value|New value|Program received signal|#([0-9]+) .*lvp_pipe_sync_wait|#([0-9]+) .*wsi_common_queue_present' "$gdb_log" | tail -n 100 || true; fi; fi
