probe=/run/flr0336-perf-capability.data; probe_log=/run/flr0336-perf-capability.log; if [ -e "$probe" ] || [ -e "$probe_log" ]; then echo FLR0336_PERF_PROBE_COLLISION; exit 91; fi; if perf record --quiet -o "$probe" -a --call-graph fp -e exceptions:page_fault_kernel -- sleep 1 >"$probe_log" 2>&1; then echo perf_kernel_fault_record=PASS; perf script -i "$probe" --max-stack 8 2>&1 | head -n 32 || true; else echo perf_kernel_fault_record=FAIL; sed -n '1,24p' "$probe_log"; fi; echo FLR0336_PERF_TRACE_CAPABILITY_DONE
