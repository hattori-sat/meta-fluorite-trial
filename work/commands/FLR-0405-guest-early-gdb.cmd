( set -eu; read pid saved_uid saved_start fault_baseline < /run/user/1001/flr0405-0001.identity; uid=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status"); start=$(awk '{print $22}' "/proc/$pid/stat"); test "$uid" = "$saved_uid"; test "$start" = "$saved_start"; test "$(cat "/proc/$pid/comm")" = flutter-auto; test -x /usr/bin/gdb; test -x /usr/bin/timeout; log=/run/user/1001/flr0405-0001-app.log; fault_pattern='BUG: unable to handle page fault|Oops:|kernel BUG|Out of memory|Killed process'; faults_before=$(dmesg | grep -Ec "$fault_pattern" || true); [ -n "$faults_before" ] || faults_before=0; uptime=$(awk '{print $1}' /proc/uptime); printf '\nFLR0405_GDB_BEGIN pid=%s uid=%s start=%s uptime=%s bound_seconds=30 kernel_faults_before=%s launch_baseline=%s\n' "$pid" "$uid" "$start" "$uptime" "$faults_before" "$fault_baseline" >> "$log"; if /usr/bin/timeout --signal=TERM --kill-after=2s 30 /usr/bin/gdb -q --batch -nx -ex 'set pagination off' -ex 'set print thread-events off' -ex 'set auto-solib-add off' -ex 'info threads' -ex 'thread apply all bt 6' -p "$pid" >> "$log" 2>&1; then gdb_rc=0; else gdb_rc=$?; fi; uid_after=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status"); start_after=$(awk '{print $22}' "/proc/$pid/stat"); test "$uid_after" = "$uid"; test "$start_after" = "$start"; stopped=0; for t in /proc/$pid/task/*; do [ -r "$t/stat" ] || continue; state=$(awk '{print $3}' "$t/stat"); case "$state" in T|t) stopped=$((stopped+1)) ;; esac; done; faults_after=$(dmesg | grep -Ec "$fault_pattern" || true); [ -n "$faults_after" ] || faults_after=0; new_faults=0; if [ "$faults_after" -gt "$fault_baseline" ]; then new_faults=$((faults_after-fault_baseline)); fi; uptime_after=$(awk '{print $1}' /proc/uptime); printf 'FLR0405_GDB_END rc=%s uptime=%s stopped_threads=%s kernel_faults_after=%s new_kernel_faults_since_launch=%s\n' "$gdb_rc" "$uptime_after" "$stopped" "$faults_after" "$new_faults" >> "$log"; maps=$(grep -E 'libLLVM|lavapipe|vulkan|filament' "/proc/$pid/maps" | head -n