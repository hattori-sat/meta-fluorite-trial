set -eu; log=/run/user/1001/flr0393-0001-app.log; identity=/run/user/1001/flr0393-0001-app.identity; read pid saved_uid saved_start wrapper < "$identity"; for i in $(seq 1 120); do branch=$(grep -c 'FLUORITE_NATIVE_MATERIAL_BRANCH hardcoded=true shading=lit source=constant' "$log" 2>/dev/null || true); returns=$(grep -c 'FLR0026_VK_QUEUE_PRESENT result=0' "$log" 2>/dev/null || true); if [ "$branch" -ge 1 ] && [ "$returns" -ge 1 ]; then break; fi; if [ ! -r "/proc/$pid/stat" ]; then break; fi; sleep 0.2; done; if [ -r "/proc/$pid/status" ]; then uid=$(stat -c %u "/proc/$pid"); start=$(awk '{print $22}' "/proc/$pid/stat"); else uid=none; start=none; fi; apps=$(pgrep -u 1001 -x flutter-auto || true); set -- $apps; count=$#; branch=$(grep -c 'FLUORITE_NATIVE_MATERIAL_BRANCH hardcoded=true shading=lit source=constant' "$log" 2>/dev/null || true); begins=$(grep -c 'FLR0026_VK_QUEUE_PRESENT_BEGIN' "$log" 2>/dev/null || true); returns=$(grep -c 'FLR0026_VK_QUEUE_PRESENT result=0' "$log" 2>/dev/null || true); done_count=$(grep -c 'FLR0026_VK_PRESENT_BOUNDARY_DONE' "$log" 2>/dev/null || true); printf 'FLR0393_GATE pid=%s uid=%s start=%s saved_start=%s app_count=%s constant_lit=%s PRESENT_BEGIN=%s PRESENT_RETURN=%s PRESENT_DONE=%s\n' "$pid" "$uid" "$start" "$saved_start" "$count" "$branch" "$begins" "$returns" "$done_count"; if [ "$uid" = "$saved_uid" ] && [ "$start" = "$saved_start" ] && [ "$count" -eq 1 ] && [ "$1" = "$pid" ] && [ "$branch" -ge 1 ] && [ "$returns" -ge 1 ]; then echo FLR0393_FIRST_PRESENT_GATE=PASS; else echo FLR0393_FIRST_PRESENT_GATE=FAIL; exit 1; fi
