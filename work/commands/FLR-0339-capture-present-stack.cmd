pidfile=/run/user/1001/flr0339-flutter.pid; log=/run/user/1001/flr0339-production.log; gdb_log=/run/user/1001/flr0339-gdb-stack.log; if [ -e "$gdb_log" ]; then echo FLR0339_GDB_LOG_COLLISION; exit 91; fi; pid=$(cat "$pidfile" 2>/dev/null || true); comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); if [ "$comm" != flutter-auto ]; then echo FLR0339_GDB_ATTACH=APP_NOT_RUNNING; exit 92; fi; enter=$(grep -c 'FLUORITE_VK_QUEUE_PRESENT_ENTER' "$log" 2>/dev/null || true); ret=$(grep -c 'FLUORITE_VK_QUEUE_PRESENT_RETURN' "$log" 2>/dev/null || true); if [ "$enter" -lt 1 ] || [ "$ret" -gt 0 ]; then echo "FLR0339_GDB_ATTACH=PRECONDITION_FAILED enter=$enter return=$ret"; exit 93; fi; echo "FLR0339_GDB_ATTACH_BEGIN pid=$pid enter=$enter"; if timeout -k 2s 20s /usr/bin/gdb -q -batch -p "$pid" -ex 'set pagination off' -ex 'set confirm off' -ex 'set print thread-events off' -ex 'info threads' -ex 'thread apply all bt 8' -ex 'detach' >"$gdb_log" 2>&1; then rc=0; else rc=$?; fi; echo "gdb_exit=$rc"; echo "gdb_log_sha256=$(sha256sum "$gdb_log" | cut -d' ' -f1)"; echo FLR0339_GDB_TRANSCRIPT_BEGIN; sed -n '1,420p' "$gdb_log"; echo FLR0339_GDB_TRANSCRIPT_END; echo "app_comm_after_gdb=$(cat "/proc/$pid/comm" 2>/dev/null || echo exited)"; echo FLR0339_GDB_ATTACH_DONE
