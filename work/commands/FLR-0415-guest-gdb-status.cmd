( set -eu; r=/run/user/1001/flr0415-0001; for suffix in -failure -hit -stop -armed; do f="$r$suffix"; if [ -s "$f" ]; then echo "FLR0415_EVENT$suffix=1"; head -n 3 "$f"; fi; done; if [ -s "$r-host.identity" ]; then read wrapper wstart gdbpid gstart baseline wall up bundle < "$r-host.identity"; if [ "$(awk '{print $22}' "/proc/$wrapper/stat" 2>/dev/null || true)" = "$wstart" ] && [ "$(cat "/proc/$wrapper/comm" 2>/dev/null || true)" = timeout ]; then echo FLR0415_GDB_WRAPPER=RUNNING; else echo FLR0415_GDB_WRAPPER=EXITED; fi; if [ "$(awk '{print $22}' "/proc/$gdbpid/stat" 2>/dev/null || true)" = "$gstart" ] && [ "$(cat "/proc/$gdbpid/comm" 2>/dev/null || true)" = gdb ]; then echo FLR0415_GDB=RUNNING; else echo FLR0415_GDB=EXITED; fi; fi; if [ -s "$r-log" ]; then grep -E 'FLR0415_|Program received signal|Hardware assisted breakpoint|Cannot insert|Oops:|BUG: unable to handle page fault|kernel BUG|present.*(begin|return|success)' "$r-log" | tail -n 30 || true; fi; )
