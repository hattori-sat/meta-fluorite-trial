( set -eu; r=/run/user/1001/flr0415-0001; if [ ! -s "$r-host.identity" ]; then if pgrep -x flutter-auto >/dev/null 2>&1 || pgrep -x gdb >/dev/null 2>&1; then echo FLR0415_PRELAUNCH_PROCESS=FAIL_untracked_runtime; pgrep -x flutter-auto || true; pgrep -x gdb || true; exit 1; fi; test ! -e "$r-log" || { echo FLR0415_PRELAUNCH_PROCESS=FAIL_existing_log; exit 1; }; for suffix in -failure -hit -stop -armed; do test ! -e "$r$suffix" || { echo FLR0415_PRELAUNCH_PROCESS=FAIL_prior_event; exit 1; }; done; echo FLR0415_PRELAUNCH_PROCESS=PASS_no_gdb_or_flutter_any_uid; expected=d6e2153b9e5d4018a2004d5258ec0291900d7c51080ed0f2733504b31227859f; actual=$(sha256sum "$r.gdb" | awk '{print $1}'); if [ "$actual" = "$expected" ] && [ "$(cat /run/user/1001/FLR0415_GDB_FILE_SENTINEL)" = "$expected" ] && grep -q 'FLR0415_GDB_SMOKE=PASS' "$r-smoke" && grep -q 'FLR0415_PYTHON=PASS' "$r-smoke"; then echo FLR0415_PRELAUNCH=PASS_ready; else echo FLR0415_PRELAUNCH_INSTALL=FAIL; exit 1; fi; fi; for suffix in -failure -hit -stop -armed; do f="$r$suffix"; if [ -s "$f" ]; then echo "FLR0415_EVENT$suffix=1"; head -n 3 "$f"; fi; done; if [ -s "$r-host.identity" ]; then read wrapper wstart gdbpid gstart baseline wall up bundle < "$r-host.identity"; if [ "$(awk '{print $22}' "/proc/$wrapper/stat" 2>/dev/null || true)" = "$wstart" ] && [ "$(cat "/proc/$wrapper/comm" 2>/dev/null || true)" = timeout ]; then echo FLR0415_GDB_WRAPPER=RUNNING; else echo FLR0415_GDB_WRAPPER=EXITED; fi; if [ "$(awk '{print $22}' "/proc/$gdbpid/stat" 2>/dev/null || true)" = "$gstart" ] && [ "$(cat "/proc/$gdbpid/comm" 2>/dev/null || true)" = gdb ]; then echo FLR0415_GDB=RUNNING; else echo FLR0415_GDB=EXITED; fi; fi; if [ -s "$r-log" ]; then grep -E 'FLR0415_|Program received signal|Hardware assisted breakpoint|Cannot insert|Oops:|BUG: unable to handle page fault|kernel BUG|present.*(begin|return|success)' "$r-log" | tail -n 30 || true; fi; )
