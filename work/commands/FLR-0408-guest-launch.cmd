( set -eu; log=/run/user/1001/fluorite-0408-0001-app.log; identity=/run/user/1001/fluorite-0408-0001.identity; home=$(awk -F: '$1=="agl-driver"{print $6}' /etc/passwd); test "$home" = /home/agl-driver; test "$(id -u agl-driver)" = 1001; test -S /run/user/1001/wayland-0; test ! -e "$log"; test ! -e "$identity"; test -z "$(pgrep -u 1001 -x flutter-auto || true)"; fault_pattern='BUG: unable to handle page fault|Oops:|kernel BUG|Out of memory|Killed process'; kernel_dump=$(/usr/bin/timeout --signal=TERM --kill-after=1s 2 dmesg 2>/dev/null); fault_baseline=$(printf '%s\n' "$kernel_dump" | grep -Ec "$fault_pattern" || true); unset kernel_dump; case "$fault_baseline" in ''|*[!0-9]*) echo FLUORITE0408_LAUNCH=FAIL_kernel-baseline; exit 1 ;; esac; su -s /bin/sh agl-driver -c "umask 077; set -C; : >$log" || { echo FLUORITE0408_LAUNCH=FAIL_log-create; exit 1; }; launch_wall=$(date '+%Y-%m-%dT%H:%M:%S%z'); launch_uptime=$(awk '{print $1}' /proc/uptime); pid=$(su -s /bin/sh agl-driver -c "/usr/bin/nohup env -i HOME=$home PATH=/usr/bin:/bin XDG_RUNTIME_DIR=/run/user/1001 WAYLAND_DISPLAY=wayland-0 FLR0026_NATIVE_MODEL_MATCH=sequoia FLR0026_NATIVE_MODEL_LIMIT=2 FLR0026_NATIVE_SKIP_SKYBOX=1 FLR0026_NATIVE_SKIP_INDIRECT_LIGHT=1 FLR0027_NATIVE_SKIP_SHAPES=1 FLR0027_NATIVE_SKIP_LIGHTS=1 FLR0026_MODEL_STAGE_TRACE=1 /usr/bin/flutter-auto -b /usr/share/flutter/toyota-connected-tcna-packages-filament-scene-fluorite-examples-demo/3.32.5/release >>$log 2>&1 </dev/null & echo \$!"); case "$pid" in ''|*[!0-9]*) echo FLUORITE0408_LAUNCH=FAIL_pid; exit 1 ;; esac; pids=; comm=; for n in $(seq 1 40); do pids=$(pgrep -u 1001 -x flutter-auto || true); comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); [ "$pids" = "$pid" ] && [ "$comm" = flutter-auto ] && break; sleep 0.25; done; test "$pids" = "$pid"; test "$comm" = flutter-auto; uid=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status"); start=$(awk '{print $22}' "/proc/$pid/stat"); state=$(awk '{print $3}' "/proc/$pid/stat"); test "$uid" = 1001; case "$state" in Z|T|t) echo FLUORITE0408_LAUNCH=FAIL_not-running; exit 1 ;; esac; printf '%s %s %s %s\n' "$pid" "$uid" "$start" "$fault_baseline" > "$identity"; identity_wall=$(date '+%Y-%m-%dT%H:%M:%S%z'); identity_uptime=$(awk '{print $1}' /proc/uptime); printf 'FLUORITE0408_PROFILE match=sequoia limit=2 skip_skybox=1 skip_indirect_light=1 skip_shapes=1 skip_lights=1 readback=unset stage_trace=1\nFLUORITE0408_LAUNCH_CONTEXT pid=%s uid=%s start=%s fault_baseline=%s launch_wall=%s launch_uptime=%s identity_wall=%s identity_uptime=%s\n' "$pid" "$uid" "$start" "$fault_baseline" "$launch_wall" "$launch_uptime" "$identity_wall" "$identity_uptime" >> "$log"; printf 'FLUORITE0408_LAUNCH=PASS pid=%s uid=%s start=%s kernel_fault_baseline=%s\n' "$pid" "$uid" "$start" "$fault_baseline"; )
