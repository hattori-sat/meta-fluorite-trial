symbolfile=/run/user/1001/flr0350-symbols-ready; pid=$(cat /run/user/1001/flr0350-flutter.pid 2>/dev/null || true); gpid=$(cat /run/user/1001/flr0350-gdb.pid 2>/dev/null || true); expected=$(cat /run/user/1001/flr0350-wrapper.start 2>/dev/null || true); expected_gstart=$(cat /run/user/1001/flr0350-gdb.start 2>/dev/null || true); ok=0; i=0; while [ "$i" -lt 32 ]; do gcomm=$(cat "/proc/$gpid/comm" 2>/dev/null || true); gstart=$(awk '{print $22}' "/proc/$gpid/stat" 2>/dev/null || true); guid=$(awk '/^Uid:/ {print $2; exit}' "/proc/$gpid/status" 2>/dev/null || true); tracer=$(awk '/^TracerPid:/ {print $2; exit}' "/proc/$pid/status" 2>/dev/null || true); if [ -s "$symbolfile" ]; then cat "$symbolfile"; if grep -q '^FLR0350_SYMBOL_GATE=PASS ' "$symbolfile" && [ "$gcomm" = gdb ] && [ "$gstart" = "$expected_gstart" ] && [ "$guid" = 0 ] && [ "$tracer" = "$gpid" ] && [ "$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null || true)" = "$expected" ]; then ok=1; fi; break; fi; if [ "$gcomm" != gdb ] || [ "$gstart" != "$expected_gstart" ] || [ "$guid" != 0 ] || [ "$tracer" != "$gpid" ] || [ "$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null || true)" != "$expected" ]; then break; fi; sleep 0.25; i=$((i + 1)); done; if [ "$ok" -eq 1 ]; then echo "FLR0350_SYMBOL_GATE_POLL=PASS polls=$i pid=$pid gdb_pid=$gpid gdb_start=$gstart"; else echo "FLR0350_SYMBOL_GATE_POLL=FAIL polls=$i pid=${pid:-missing} gdb=${gcomm:-exited} gdb_start=${gstart:-unknown} marker=$([ -s "$symbolfile" ] && echo present || echo missing)"; grep -E 'FLR0350_(SAME_PID_EXEC|SYMBOL_GATE|COVERAGE)|error|Error|Cannot|failed|Failed' /run/user/1001/flr0350-gdb.log | tail -n 40 || true; fi
