pidfile=/run/user/1001/flr0344-flutter.pid; log=/run/user/1001/flr0344-production.log; gdb_pidfile=/run/user/1001/flr0344-gdb-watch.pid; gdb_log=/run/user/1001/flr0344-gdb-watch.log; echo guest_uptime=$(cut -d' ' -f1 /proc/uptime); if [ -s "$pidfile" ]; then pid=$(cat "$pidfile"); comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); [ -n "$comm" ] || comm=exited; echo "tracked_pid=$pid comm=$comm"; if [ "$comm" = flutter-auto ]; then matched=$(ps -L -p "$pid" -o tid=,stat=,wchan:28=,comm= | awk '$4 == "FEngine::loop" || $4 ~ /^llvmpipe/ { print; n++; if (n == 16) exit }'); if [ -n "$matched" ]; then printf '%s\n' "$matched"; else echo tracked_threads=none-matched; fi; fi; fi; if [ -s "$log" ]; then echo "app_log_sha256=$(sha256sum "$log" | cut -d' ' -f1)"; grep -n -E 'FLUORITE_VK_(SUBMIT_RETURN|PRESENT_CALL_BEGIN|QUEUE_PRESENT_ENTER|QUEUE_PRESENT_RETURN)|FLUORITE_NATIVE_WAYLAND_COMMIT|SIGSEGV|Oops:|BUG:|Out of memory|oom-kill' "$log" | tail -n 48 || true; fi; if [ -s "$gdb_log" ]; then echo "gdb_log_sha256=$(sha256sum "$gdb_log" | cut -d' ' -f1)"; grep -E 'FLR0344_|Hardware watchpoint|Old value|New value|Program received signal|error:|Error|Cannot|cannot|ptrace|Undefined|No such|Failed|failed|Exception|^#([0-9]+) ' "$gdb_log" | tail -n 80 || true; echo FLR0344_GDB_TRANSCRIPT_BEGIN; sed -n '1,80p' "$gdb_log"; echo FLR0344_GDB_TRANSCRIPT_END; fi; if [ -s "$gdb_pidfile" ]; then gp=$(cat "$gdb_pidfile"); comm=$(cat "/proc/$gp/comm" 2>/dev/null || true); [ -n "$comm" ] || comm=exited; echo "gdb_process=$comm"; fi; count=$(pgrep -c -x flutter-auto 2>/dev/null || true); [ -n "$count" ] || count=0; echo flutter_processes=$count; echo FLR0344_RUNTIME_STATE_DONE
