( set -eu; r=/run/user/1001/flr0415-0001; alive() { p=$1; s=$2; c=$3; proc=$(awk '{print $3,$22}' "/proc/$p/stat" 2>/dev/null || true); set -- $proc; [ "$#" -eq 2 ] && [ "$2" = "$s" ] && [ "$1" != Z ] && [ "$(cat "/proc/$p/comm" 2>/dev/null || true)" = "$c" ] && [ "$(awk '/^Uid:/ {print $2; exit}' "/proc/$p/status" 2>/dev/null || true)" = 1001 ]; }; if [ -s "$r-host.identity" ]; then read wrapper wstart gdbpid gstart baseline wall up < "$r-host.identity"; alive "$gdbpid" "$gstart" gdb && kill -TERM "$gdbpid"; alive "$wrapper" "$wstart" timeout && kill -TERM "$wrapper"; fi; if [ -s "$r-identity" ]; then read app appuid appstart < "$r-identity"; if [ "$appuid" = 1001 ] && alive "$app" "$appstart" flutter-auto; then kill -TERM "$app"; fi; fi; residual=; for n in $(seq 1 20); do residual=; if [ -s "$r-host.identity" ]; then alive "$gdbpid" "$gstart" gdb && residual="$residual,gdb:$gdbpid" || true; alive "$wrapper" "$wstart" timeout && residual="$residual,timeout:$wrapper" || true; fi; if [ -s "$r-identity" ] && [ "$appuid" = 1001 ]; then alive "$app" "$appstart" flutter-auto && residual="$residual,flutter-auto:$app" || true; fi; [ -z "$residual" ] && break; sleep 0.25; done; if [ -z "$residual" ]; then echo FLR0415_STOP=PASS exact_residual=none; else echo "FLR0415_STOP=FAIL exact_residual=$residual"; exit 1; fi; )
