( set -eu; r=/run/user/1001/flr0415-0001; test -s "$r-log"; size=$(wc -c < "$r-log" | tr -d ' '); echo "FLR0415_GDB_LOG_BYTES=$size"; if [ "$size" -le 800000 ]; then echo FLR0415_GDB_LOG_MODE=FULL; cat "$r-log"; else echo FLR0415_GDB_LOG_MODE=FOCUSED_TAIL; grep -E 'FLR0415_|Program received signal|Hardware assisted breakpoint|Cannot insert|Oops:|BUG: unable to handle page fault|kernel BUG|present.*(begin|return|success)' "$r-log" | tail -n 500 || true; tail -n 200 "$r-log"; fi; )
