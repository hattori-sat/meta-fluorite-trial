rm -f /tmp/flr0155-runtime.log /tmp/flr0155-app.pid; su -s /bin/sh agl-driver -c 'env XDG_RUNTIME_DIR=/run/user/1001 WAYLAND_DISPLAY=wayland-0 WAYLAND_DEBUG=client FLUORITE_NATIVE_PURE_FIXTURE=1 FLUORITE_NATIVE_MINIMAL_GEOMETRY=1 FLUORITE_NATIVE_FIXTURE_LOCAL_CAMERA=1 FLUORITE_NATIVE_HARDCODED_MATERIAL_COLOR=1 FLUORITE_NATIVE_VERTEX_TRACE=1 FLR0026_SYNC_TRACE=1 FLR0026_FORCE_RENDER_ON_SKIPPED_FRAME=1 FLUORITE_VIEWTARGET_FRAME_TRACE=1 FLR0026_TARGET_TRACE=1 FLR0026_PIPELINE_STATE_TRACE=1 FLUORITE_VK_SWAPCHAIN_PIXEL_TRACE=1 nohup /usr/bin/flutter-auto -b /usr/share/flutter/toyota-connected-tcna-packages-filament-scene-fluorite-examples-demo/3.32.5/release >/tmp/flr0155-runtime.log 2>&1 & echo $! >/tmp/flr0155-app.pid'; sleep 15; printf '%s\n' APP_PID; cat /tmp/flr0155-app.pid; printf '%s\n' SELECTED_MARKERS; grep -n -E 'FLUORITE_NATIVE|FLUORITE_VIEWTARGET|FLR0026_(PIPELINE_STATE|TARGET_DRAW2|VK_(SWAPCHAIN_PIXEL|QUEUE_PRESENT|PRESENT_BOUNDARY|WAYLAND|COMMIT)|READBACK)|setUpLoadingModels|setUpSkybox|setUpLights|setUpShapes|setUpEntities|MODEL|SHAPE|LIGHT|SKYBOX|INDIRECT|GLB|MATERIAL|wl_subsurface|wl_surface' /tmp/flr0155-runtime.log | head -n 360
