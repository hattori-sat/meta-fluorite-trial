echo guest_uptime=$(cut -d' ' -f1 /proc/uptime); if [ -x /usr/bin/gdb ] && command -v base64 >/dev/null 2>&1 && command -v gzip >/dev/null 2>&1 && command -v sha256sum >/dev/null 2>&1 && [ -r /usr/lib/libLLVM.so.18.1 ]; then echo gdb_version=$(/usr/bin/gdb --version | head -n 1); sha256sum /usr/lib/libLLVM.so.18.1; count=$(pgrep -c -x flutter-auto 2>/dev/null || true); [ -n "$count" ] || count=0; echo flutter_processes=$count; if [ "$count" -eq 0 ] && [ ! -e /run/user/1001/flr0343-production.log ] && [ ! -e /run/user/1001/flr0343-flutter.pid ] && [ ! -e /run/user/1001/flr0343-gdb-watch.log ] && [ ! -e /run/user/1001/flr0343-gdb-watch.pid ]; then echo FLR0343_PREFLIGHT=PASS; else echo FLR0343_PREFLIGHT=FAIL app-state-collision; fi; else echo FLR0343_PREFLIGHT=FAIL debugger-library-or-compression-tool-missing; fi
