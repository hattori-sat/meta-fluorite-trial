log=/run/user/1001/flr0341-production.log; pidfile=/run/user/1001/flr0341-flutter.pid; if [ ! -s "$pidfile" ]; then echo FLR0341_PRESENT_STATE=APP_PID_MISSING; else pid=$(cat "$pidfile"); comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); if [ "$comm" != flutter-auto ]; then echo FLR0341_PRESENT_STATE=APP_EXITED; else i=0; while [ "$i" -lt 16 ]; do enter=$(grep -c 'FLUORITE_VK_QUEUE_PRESENT_ENTER' "$log" 2>/dev/null || true); ret=$(grep -c 'FLUORITE_VK_QUEUE_PRESENT_RETURN' "$log" 2>/dev/null || true); begin=$(grep -c 'FLR0026_VK_QUEUE_PRESENT_BEGIN' "$log" 2>/dev/null || true); legacy=$(grep -c 'FLR0026_VK_QUEUE_PRESENT result=' "$log" 2>/dev/null || true); if [ "$enter" -gt 0 ]; then sleep 2; ret=$(grep -c 'FLUORITE_VK_QUEUE_PRESENT_RETURN' "$log" 2>/dev/null || true); legacy=$(grep -c 'FLR0026_VK_QUEUE_PRESENT result=' "$log" 2>/dev/null || true); if [ "$ret" -eq 0 ] && [ "$legacy" -eq 0 ]; then echo "FLR0341_PRESENT_STATE=STALLED enter=$enter return=$ret begin=$begin legacy_return=$legacy"; else echo "FLR0341_PRESENT_STATE=RETURNED enter=$enter return=$ret begin=$begin legacy_return=$legacy"; fi; break; fi; sleep 1; i=$((i+1)); done; if [ "$i" -ge 16 ]; then echo FLR0341_PRESENT_STATE=WINDOW_OPEN; fi; echo guest_uptime=$(cut -d' ' -f1 /proc/uptime); fi; fi
