( set -eu; umask 077; run_id=flr0414-0001; log=/run/user/1001/${run_id}-app.log; identity=/run/user/1001/${run_id}.identity; bundle=/usr/share/flutter/toyota-connected-tcna-packages-filament-scene-fluorite-examples-demo/3.32.5/release; home=$(awk -F: '$1=="agl-driver" {print $6}' /etc/passwd); test "$home" = /home/agl-driver; test "$(id -u agl-driver)" = 1001; test -S /run/user/1001/wayland-0; test -x /usr/bin/flutter-auto; test -x /usr/bin/gdb; test -x /usr/bin/readelf; test -x /usr/bin/timeout; test -x /usr/bin/pgrep; test -d "$bundle"; test -f /usr/lib/libLLVM.so.18.1; command -v dmesg >/dev/null; command -v journalctl >/dev/null; command -v coredumpctl >/dev/null; test ! -e "$log"; test ! -e "$identity"; test -z "$(pgrep -u 1001 -x flutter-auto || true)"; fault_pattern='BUG: unable to handle page fault|Oops:|kernel BUG|Out of memory|Killed process'; kernel_dump=$(/usr/bin/timeout --signal=TERM --kill-after=1s 2 dmesg 2>/dev/null) || { echo FLR0414_LAUNCH=FAIL_kernel-log-unavailable; exit 1; }; fault_baseline=$(printf '%s\n' "$kernel_dump" | grep -Ec "$fault_pattern" || true); case "$fault_baseline" in ''|*[!0-9]*) echo FLR0414_LAUNCH=FAIL_kernel-baseline; exit 1 ;; esac; unset kernel_dump; su -s /bin/sh agl-driver -c "umask 077; set -C; : >'$log'"; launch_wall=$(date '+%Y-%m-%dT%H:%M:%S%z'); launch_uptime=$(awk '{print $1}' /proc/uptime); pid=$(su -s /bin/sh agl-driver -c "env -i HOME=$home PATH=/usr/bin:/bin XDG_RUNTIME_DIR=/run/user/1001 WAYLAND_DISPLAY=wayland-0 /usr/bin/flutter-auto -b $bundle >>$log 2>&1 </dev/null & echo \$!"); case "$pid" in ''|*[!0-9]*) echo FLR0414_LAUNCH=FAIL_pid; exit 1 ;; esac; pids=; comm=; for n in $(seq 1 40); do pids=$(pgrep -u 1001 -x flutter-auto || true); comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); [ "$pids" = "$pid" ] && [ "$comm" = flutter-auto ] && break; sleep 0.25; done; test "$pids" = "$pid"; test "$comm" = flutter-auto; uid=$(awk '/^Uid:/ {print $2; exit}' "/proc/$pid/status"); start=$(awk '{print $22}' "/proc/$pid/stat"); state=$(awk '{print $3}' "/proc/$pid/stat"); test "$uid" = 1001; test -n "$start"; case "$state" in Z|T|t) echo FLR0414_LAUNCH=FAIL_not-running; exit 1 ;; esac; printf '%s %s %s %s\n' "$pid" "$uid" "$start" "$fault_baseline" > "$identity"; identity_wall=$(date '+%Y-%m-%dT%H:%M:%S%z'); identity_uptime=$(awk '{print $1}' /proc/uptime); printf 'FLR0414_PROFILE bundle=3.32.5 env=allow-listed selectors=none overrides=none\nFLR0414_LAUNCH_CONTEXT pid=%s uid=%s start=%s fault_baseline=%s launch_wall=%s launch_uptime=%s identity_wall=%s identity_uptime=%s\n' "$pid" "$uid" "$start" "$fault_baseline" "$launch_wall" "$launch_uptime" "$identity_wall" "$identity_uptime" >> "$log"; printf 'FLR0414_LAUNCH=PASS pid=%s uid=%s start=%s kernel_fault_baseline=%s\n' "$pid" "$uid" "$start" "$fault_baseline"; )
