pidfile=/run/user/1001/flr0343-flutter.pid; log=/run/user/1001/flr0343-production.log; gdb_pidfile=/run/user/1001/flr0343-gdb-watch.pid; gdb_log=/run/user/1001/flr0343-gdb-watch.log; echo guest_uptime=$(cut -d' ' -f1 /proc/uptime); if [ -s "$pidfile" ]; then pid=$(cat "$pidfile"); comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); echo "tracked_pid=$pid comm=${comm:-exited}"; if [ "$comm" = flutter-auto ]; then ps -L -p "$pid" -o pid=,tid=,stat=,wchan:28=,comm= | head -n 32; fi; fi; if [ -s "$log" ]; then echo "app_log_sha256=$(sha256sum "$log" | cut -d' ' -f1)"; grep -n -E 'FLUORITE_VK_(SUBMIT_RETURN|PRESENT_CALL_BEGIN|QUEUE_PRESENT_ENTER|QUEUE_PRESENT_RETURN)|FLUORITE_NATIVE_WAYLAND_COMMIT|SIGSEGV|Segmentation fault|Oops:|BUG:|Out of memory|oom-kill' "$log" | tail -n 48 || true; fi; if [ -s "$gdb_log" ]; then echo "gdb_log_sha256=$(sha256sum "$gdb_log" | cut -d' ' -f1)"; grep -E 'FLR0343_|Hardware watchpoint|Old value|New value|Program received signal|#([0-9]+) .*lvp_pipe_sync_wait|#([0-9]+) .*wsi_common_queue_present' "$gdb_log" | tail -n 64 || true; fi; if [ -s "$gdb_pidfile" ]; then gp=$(cat "$gdb_pidfile"); echo "gdb_process=$(cat "/proc/$gp/comm" 2>/dev/null || echo exited)"; fi; count=$(pgrep -c -x flutter-auto 2>/dev/null || true); [ -n "$count" ] || count=0; echo flutter_processes=$count; dmesg --color=never 2>/dev/null | grep -E 'Oops:|RIP:|CR2:|Call Trace:|kernel page fault|BUG:|Killed process' | tail -n 16 || true; echo FLR0343_RUNTIME_STATE_DONE
