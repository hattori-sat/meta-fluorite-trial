gpidfile=/run/user/1001/flr0350-gdb.pid; gdbstartfile=/run/user/1001/flr0350-gdb.start; gpid=$(cat "$gpidfile" 2>/dev/null || true); expected_gstart=$(cat "$gdbstartfile" 2>/dev/null || true); gcomm=$(cat "/proc/$gpid/comm" 2>/dev/null || true); gstart=$(awk '{sub(/^.*\) /,""); print $20}' "/proc/$gpid/stat" 2>/dev/null || true); guid=$(awk '/^Uid:/ {print $2; exit}' "/proc/$gpid/status" 2>/dev/null || true); if [ -z "$gcomm" ]; then echo FLR0350_GDB_INTERRUPT=not-running; elif [ "$gcomm" = gdb ] && [ "$gstart" = "$expected_gstart" ] && [ "$guid" = 0 ] && kill -0 "$gpid" 2>/dev/null; then kill -INT "$gpid" 2>/dev/null || true; echo "FLR0350_GDB_INTERRUPT=sent pid=$gpid start=$gstart"; i=0; while [ "$i" -lt 10 ] && [ "$(awk '{sub(/^.*\) /,""); print $20}' "/proc/$gpid/stat" 2>/dev/null || true)" = "$expected_gstart" ] && [ "$(cat "/proc/$gpid/comm" 2>/dev/null || true)" = gdb ]; do sleep 0.2; i=$((i + 1)); done; if [ "$(awk '{sub(/^.*\) /,""); print $20}' "/proc/$gpid/stat" 2>/dev/null || true)" = "$expected_gstart" ] && [ "$(cat "/proc/$gpid/comm" 2>/dev/null || true)" = gdb ]; then kill -TERM "$gpid" 2>/dev/null || true; echo FLR0350_GDB_TERM_FALLBACK=sent; fi; else echo "FLR0350_GDB_INTERRUPT=FAIL identity_mismatch pid=${gpid:-missing} start=${gstart:-unknown} expected_start=${expected_gstart:-unknown} uid=${guid:-unknown}"; fi; remainder_start=$(awk '{sub(/^.*\) /,""); print $20}' "/proc/$gpid/stat" 2>/dev/null || true); remainder_comm=$(cat "/proc/$gpid/comm" 2>/dev/null || true); if [ -z "$remainder_start" ] || [ "$remainder_start" != "$expected_gstart" ]; then echo FLR0350_GDB_REMAINDER=exited; else echo "FLR0350_GDB_REMAINDER=running comm=$remainder_comm start=$remainder_start"; fi; if [ -s /run/user/1001/flr0350-gdb.log ]; then grep -E 'FLR0350_|Hardware watchpoint|Old value|New value|Program received signal|error:|Error|Cannot|ptrace|failed|Failed|^#([0-9]+) ' /run/user/1001/flr0350-gdb.log | tail -n 120 || true; fi
