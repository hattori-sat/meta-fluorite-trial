 existing=$(ps -eo comm= | awk '$1=="flutter-auto"{c++} END{print c+0}'); printf '%s\n' EXISTING_FLUTTER_AUTO=$existing; [ "$existing" -eq 0 ] || exit 11; rm -f /tmp/flr0200-runtime.log /tmp/flr0200-app.pid; su -s /bin/sh agl-driver -c 'env XDG_RUNTIME_DIR=/run/user/1001 WAYLAND_DISPLAY=wayland-0 WAYLAND_DEBUG=client FLUORITE_NATIVE_PURE_FIXTURE=1 FLUORITE_NATIVE_MINIMAL_GEOMETRY=1 FLUORITE_NATIVE_FIXTURE_LOCAL_CAMERA=1 FLUORITE_NATIVE_SWAPCHAIN_READBACK=1 FLR0026_SYNC_TRACE=1 FLR0026_FORCE_RENDER_ON_SKIPPED_FRAME=1 FLUORITE_VIEWTARGET_FRAME_TRACE=1 FLR0026_TARGET_TRACE=1 FLR0026_PIPELINE_STATE_TRACE=1 FLUORITE_VK_SWAPCHAIN_PIXEL_TRACE=1 nohup /usr/bin/flutter-auto -b /usr/share/flutter/toyota-connected-tcna-packages-filament-scene-fluorite-examples-demo/3.38.3/release >/tmp/flr0200-runtime.log 2>&1 & echo $! >/tmp/flr0200-app.pid' || exit $?; sleep 15; printf '%s\n' APP_PID; cat /tmp/flr0200-app.pid; printf '%s\n' SELECTED_MARKERS; grep -n -E 'FLUORITE_NATIVE|FLUORITE_VIEWTARGET|FLR0026_(PIPELINE_STATE|TARGET_DRAW2|VK_(SWAPCHAIN_PIXEL|QUEUE_PRESENT|PRESENT_BOUNDARY|WAYLAND|COMMIT)|READBACK)|setUpLoadingModels|setUpSkybox|setUpLights|setUpShapes|setUpEntities|MODEL|SHAPE|LIGHT|SKYBOX|INDIRECT|GLB|MATERIAL|wl_subsurface|wl_surface' /tmp/flr0200-runtime.log | tail -n 360 || true; printf '%s\n' PROCESS; ps -eo pid,ppid,user,comm,args | awk '$4=="flutter-auto" || $4=="flutter_tester"'; printf '%s\n' COREDUMP; coredumpctl list --no-legend 2>/dev/null | tail -n 20 || true
