( set -eu; log=/run/user/1001/flr0405-0001-app.log; identity=/run/user/1001/flr0405-0001.identity; home=$(awk -F: '$1=="agl-driver"{print $6}' /etc/passwd); test "$home" = /home/agl-driver; test "$(id -u agl-driver)" = 1001; test -S /run/user/1001/wayland-0; test ! -e "$log"; test ! -e "$identity"; test -z "$(pgrep -u 1001 -x flutter-auto || true)"; fault_pattern='BUG: unable to handle page fault|Oops:|kernel BUG|Out of memory|Killed process'; fault_baseline=$(dmesg | grep -Ec "$fault_pattern" || true); [ -n "$fault_baseline" ] || fault_baseline=0; su -s /bin/sh agl-driver -c "env -i HOME=$home PATH=/usr/bin:/bin XDG_RUNTIME_DIR=/run/user/1001 WAYLAND_DISPLAY=wayland-0 /usr/bin/flutter-auto -b /usr/share/flutter/toyota-connected-tcna-packages-filament-scene-fluorite-examples-demo/3.32.5/release >$log 2>&1 &"; for n in $(seq 1 40); do pids=$(pgrep -u 1001 -x flutter-auto || true); set -- $pids; [ "$#" -eq 1 ] && break; sleep 0.25; done; set -- $pids; test "$#" -eq 1; pid=$1; uid=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status"); start=$(awk '{print $22}' "/proc/$pid/stat"); test "$uid" = 1001; test -n "$start"; printf "%s %s %s %s\n" "$pid" "$uid" "$start" "$fault_baseline" > "$identity"; printf "FLR0405_LAUNCH=PASS pid=%s uid=%s start=%s env=allow-listed kernel_fault_baseline=%s\n" "$pid" "$uid" "$start" "$fault_baseline"; )
