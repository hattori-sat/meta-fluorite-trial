( set -eu; log=/run/user/1001/flr0405-0003-app.log; identity=/run/user/1001/flr0405-0003.identity; home=$(awk -F: '$1=="agl-driver"{print $6}' /etc/passwd); test "$home" = /home/agl-driver; test "$(id -u agl-driver)" = 1001; test -S /run/user/1001/wayland-0; test ! -e "$log"; test ! -e "$identity"; test -z "$(pgrep -u 1001 -x flutter-auto || true)"; fault_pattern='BUG: unable to handle page fault|Oops:|kernel BUG|Out of memory|Killed process'; if ! kernel_dump=$(/usr/bin/timeout --signal=TERM --kill-after=1s 2 dmesg 2>/dev/null); then echo FLR0405_LAUNCH=FAIL_kernel-log-unavailable; exit 1; fi; fault_baseline=$(printf '%s\n' "$kernel_dump" | grep -Ec "$fault_pattern" || true); unset kernel_dump; case "$fault_baseline" in ''|*[!0-9]*) echo FLR0405_LAUNCH=FAIL_kernel-baseline-unavailable; exit 1 ;; esac; su -s /bin/sh agl-driver -c "umask 077; set -C; : >$log" || { echo FLR0405_LAUNCH=FAIL_log-create; exit 1; }; launch_before_wall=$(date '+%Y-%m-%dT%H:%M:%S%z'); launch_before_uptime=$(awk '{print $1}' /proc/uptime); if ! pid=$(su -s /bin/sh agl-driver -c "env -i HOME=$home PATH=/usr/bin:/bin XDG_RUNTIME_DIR=/run/user/1001 WAYLAND_DISPLAY=wayland-0 /usr/bin/flutter-auto -b /usr/share/flutter/toyota-connected-tcna-packages-filament-scene-fluorite-examples-demo/3.32.5/release >>$log 2>&1 & echo \$!"); then echo FLR0405_LAUNCH=FAIL_start-command; exit 1; fi; case "$pid" in ''|*[!0-9]*) echo FLR0405_LAUNCH=FAIL_child-pid; exit 1 ;; esac; for n in $(seq 1 40); do pids=$(pgrep -u 1001 -x flutter-auto || true); comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); [ "$pids" = "$pid" ] && [ "$comm" = flutter-auto ] && break; sleep 0.25; done; test "$pids" = "$pid"; test "$comm" = flutter-auto; uid=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status"); start=$(awk '{print $22}' "/proc/$pid/stat"); state=$(awk '{print $3}' "/proc/$pid/stat"); test "$uid" = 1001; test -n "$start"; case "$state" in Z|T|t) echo FLR0405_LAUNCH=FAIL_child-not-running; exit 1 ;; esac; printf '%s %s %s %s\n' "$pid" "$uid" "$start" "$fault_baseline" > "$identity"; identity_wall=$(date '+%Y-%m-%dT%H:%M:%S%z'); identity_uptime=$(awk '{print $1}' /proc/uptime); printf 'FLR0405_LAUNCH_CONTEXT pid=%s uid=%s start=%s fault_baseline=%s before_wall=%s before_uptime=%s identity_wall=%s identity_uptime=%s\n' "$pid" "$uid" "$start" "$fault_baseline" "$launch_before_wall" "$launch_before_uptime" "$identity_wall" "$identity_uptime" >> "$log"; printf 'FLR0405_LAUNCH=PASS pid=%s uid=%s start=%s env=allow-listed kernel_fault_baseline=%s log_mode=append\n' "$pid" "$uid" "$start" "$fault_baseline"; )
