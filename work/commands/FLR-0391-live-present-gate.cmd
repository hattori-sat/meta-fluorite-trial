set -eu; identity=/run/user/1001/flr0391-0001-app.identity; log=/run/user/1001/flr0391-0001-app.log; read pid saved_uid saved_start wrapper < "$identity"; for i in $(seq 1 100); do done_count=$(grep -c 'FLR0026_VK_PRESENT_BOUNDARY_DONE' "$log" 2>/dev/null || true); if [ "$done_count" -ge 1 ] || [ ! -r "/proc/$pid/stat" ]; then break; fi; sleep 0.2; done; if [ -r "/proc/$pid/status" ]; then uid=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status"); start=$(awk '{print $22}' "/proc/$pid/stat"); else uid=none; start=none; fi; apps=$(pgrep -u 1001 -x flutter-auto || true); set -- $apps; count=$#; ready=$(grep -c 'FLUORITE_SEQUOIA_LIT_MATERIAL_READY' "$log" 2>/dev/null || true); bound=$(grep -c 'FLUORITE_SEQUOIA_LIT_MATERIAL_BOUND' "$log" 2>/dev/null || true); sun=$(grep -c 'FLR0305_PRODUCTION_SCENE_LIGHT_SETUP_DONE' "$log" 2>/dev/null || true); present_done=$(grep -c 'FLR0026_VK_PRESENT_BOUNDARY_DONE' "$log" 2>/dev/null || true); present_begin=$(grep -c 'FLR0026_VK_QUEUE_PRESENT_BEGIN' "$log" 2>/dev/null || true); present_return=$(grep -c 'FLR0026_VK_QUEUE_PRESENT result=' "$log" 2>/dev/null || true); printf 'FLR0391_LIVE pid=%s uid=%s saved_uid=%s start=%s saved_start=%s app_count=%s READY=%s BOUND=%s SUN=%s PRESENT_DONE=%s PRESENT_BEGIN=%s PRESENT_RETURN=%s wrapper=%s\n' "$pid" "$uid" "$saved_uid" "$start" "$saved_start" "$count" "$ready" "$bound" "$sun" "$present_done" "$present_begin" "$present_return" "$wrapper"; if [ "$uid" = 1001 ] && [ "$saved_uid" = 1001 ] && [ "$start" = "$saved_start" ] && [ "$count" -eq 1 ] && [ "$1" = "$pid" ]; then echo FLR0391_PID_GATE=PASS; else echo FLR0391_PID_GATE=FAIL; fi
