( set -eu; read pid saved_uid saved_start base_faults < /run/user/1001/flr0405-0001.identity; log=/run/user/1001/flr0405-0001-app.log; uid=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status"); start=$(awk '{print $22}' "/proc/$pid/stat"); test "$uid" = "$saved_uid"; test "$start" = "$saved_start"; fault_pattern='BUG: unable to handle page fault|Oops:|kernel BUG|Out of memory|Killed process'; [ -n "$base_faults" ] || base_faults=0; start_uptime=$(awk '{print $1}' /proc/uptime); printf 'FLR0405_MONITOR_BEGIN pid=%s uid=%s start=%s uptime=%s max_samples=300 interval_seconds=1 baseline_kernel_faults=%s\n' "$pid" "$uid" "$start" "$start_uptime" "$base_faults" >> "$log"; sample=0; unmatched_samples=0; result=MAX_300S; while [ "$sample" -lt 300 ]; do sample=$((sample+1)); if [ ! -r "/proc/$pid/stat" ]; then result=APP_EXIT; break; fi; uid_now=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status"); start_now=$(awk '{print $22}' "/proc/$pid/stat"); if [ "$uid_now" != "$saved_uid" ] || [ "$start_now" != "$saved_start" ]; then result=IDENTITY_CHANGED; break; fi; begins=$(grep -c 'FLR0026_VK_QUEUE_PRESENT_BEGIN' "$log" || true); returns=$(grep -c 'FLR0026_VK_QUEUE_PRESENT result=' "$log" || true); if [ "$begins" -gt "$returns" ]; then unmatched_samples=$((unmatched_samples+1)); else unmatched_samples=0; fi; faults=$(dmesg | grep -Ec "$fault_pattern" || true); [ -n "$faults" ] || faults=0; state=$(awk '{print $3}' "/proc/$pid/stat"); uptime=$(awk '{print $1}' /proc/uptime); printf 'FLR0405_SAMPLE n=%s uptime=%s present_begin=%s present_return=%s unmatched_samples=%s kernel_faults=%s app_state=%s\n' "$sample" "$uptime" "$begins" "$returns" "$unmatched_samples" "$faults" "$state" >> "$log"; if [ "$faults" -gt "$base_faults" ]; then result=KERNEL_FAULT; break; fi; if [ "$unmatched_samples" -ge 2 ]; then result=PERSISTENT_PRESENT_UNMATCHED; break; fi; sleep 1; done; end_uptime=$(awk '{print $1}' /proc/uptime); begins=$(grep -c 'FLR0026_VK_QUEUE_PRESENT_BEGIN' "$log" || true); returns=$(grep -c 'FLR0026_VK_QUEUE_PRESENT result=' "$log" || true); printf 'FLR0405_EVENT result=%s uptime=%s present_begin=%s present_return=%s\n' "$result" "$end_uptime" "$begins" "$returns" >> "$log"; if [ -r "/proc/$pid/status" ] && [ "$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status")" = "$saved_uid" ] && [ "$(awk '{print $22}' "/proc/$pid/stat")" = "$saved_start" ]; then printf 'FLR0405_THREADS_BEGIN\n' >> "$log"; n=0; for t in /proc/$pid/task/*; do [ -r "$t/comm" ] || continue; tid=${t##*/}; state=$(awk '{print $3}' "$t/stat"); name=$(cat "$t/comm"); wchan=$(cat "$t/wchan" 2>/dev/null || true); printf 'tid=%s state=%s comm=%s wchan=%s\n' "$tid" "$state" "$name" "$wchan" >> "$log"; n=$((n+1)); [ "$n" -lt 40 ] || break; done; printf 'FLR0405_THREADS_END count=%s\n' "$n" >> "$log"; printf 'FLR0405_MAPPED_RENDER_LIBS_BEGIN\n' >> "$log"; awk '/libLLVM|lavapipe|vulkan|filament/ {print; n++; if (n>=24) exit}' "/proc/$pid/maps" >> "$log"; printf 'FLR0405_MAPPED_RENDER_LIBS_END\n' >> "$log"; fi; printf 'FLR0405_KERNEL_CONTEXT_BEGIN\n' >> "$log"; dmesg | tail -n 180 | grep -E 'BUG: unable|Oops:|CR2:|RIP:|CPU:|Comm:|Call Trace|Code:' | tail -n 60 >> "$log" || true; if command -v journalctl >/dev/null 2>&1; then /usr/bin/timeout --signal=TERM --kill-after=1s 5 journalctl -k -b -o short-monotonic --no-pager -n 120 2>&1 | grep -E 'BUG: unable|Oops:|CR2:|RIP:|CPU:|Comm:|Call Trace|Code:' | tail -n 60 >> "$log" || true; fi; printf 'FLR0405_KERNEL_CONTEXT_END\n' >> "$log"; if command -v coredumpctl >/dev/null 2>&1; then /usr/bin/timeout --signal=TERM --kill-after=1s 5 coredumpctl list --no-pager 2>&1 | tail -n 8 >> "$log" || true; fi; printf 'FLR0405_MONITOR_RESULT=%s uptime=%s present_begin=%s present_return=%s\n' "$result" "$end_uptime" "$begins" "$returns"; grep -E 'FLR0405_(GDB|SAMPLE|EVENT|MODULE|MONITOR)|FLR0026_VK_(QUEUE_PRESENT|PRESENT_BOUNDARY)|FEngine|Oops|segfault|ERROR|error:' "$log" | tail -n 120 || true; case "$result" in IDENTITY_CHANGED|APP_EXIT) exit 2 ;; esac; )
