printf 'boot_id='; cat /proc/sys/kernel/random/boot_id; printf 'uptime='; cat /proc/uptime; echo runtime_artifacts; find /run -maxdepth 3 -type f -name '*flr0336*' -printf '%p %s bytes\n' 2>/dev/null | sort; echo related_processes; ps -eo pid=,ppid=,stat=,comm= | awk '$4 == "perf" || $4 == "sleep" || $4 == "flutter-auto" {print}'; echo current_boot_fault_context; journalctl -k -b --no-pager -n 500 2>&1 | awk '/BUG: unable to handle page fault|Oops:|Kernel panic|Rebooting in|Restarting system|FEngine::loop|page fault|Out of memory|oom-kill|killed process/ {active=1; left=12} active && left>0 {print; left--}' | tail -n 100; if command -v coredumpctl >/dev/null 2>&1; then echo matching_coredumps; coredumpctl --no-pager list -n 20 2>&1 | grep -Ei 'flutter-auto|fengine|filament' || echo none; fi; echo FLR0336_AFTER_RUN_STATE_DONE
