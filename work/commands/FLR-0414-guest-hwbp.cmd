( set -eu; run_id=flr0414-0001; identity=/run/user/1001/${run_id}.identity; gdb_cmd=/run/user/1001/${run_id}.gdb; address_file=/run/user/1001/${run_id}-breakpoint-address; log=/run/user/1001/${run_id}-gdb.log; gdb_identity=/run/user/1001/${run_id}-gdb.identity; read pid uid start fault_baseline < "$identity"; runtime_addr=$(cat "$address_file"); test -s "$gdb_cmd"; test -n "$runtime_addr"; test ! -e "$log"; test ! -e "$gdb_identity"; test "$(awk '{print $22}' "/proc/$pid/stat")" = "$start"; nohup timeout -k 2s 420s /usr/bin/gdb -q -batch -p "$pid" -x "$gdb_cmd" > "$log" 2>&1 </dev/null & gdb_pid=$!; gdb_start=$(awk '{print $22}' "/proc/$gdb_pid/stat"); test -n "$gdb_start"; test "$(cat "/proc/$gdb_pid/comm")" = timeout; printf '%s %s\n' "$gdb_pid" "$gdb_start" > "$gdb_identity"; armed=0; failed=0; for n in $(seq 1 12); do if grep -Eiq '^Hardware assisted breakpoint [0-9]+ at' "$log"; then armed=1; break; fi; if grep -Eiq 'Cannot insert.*hardware breakpoint|hardware breakpoint.*(not supported|unavailable)|Operation not permitted|ptrace.*(denied|operation not permitted)|No such process|^error:' "$log"; then failed=1; break; fi; [ "$(cat "/proc/$gdb_pid/comm" 2>/dev/null || true)" = timeout ] || break; sleep 1; done; if [ "$armed" -ne 1 ]; then echo "FLR0414_GDB_START=FAIL status=$([ "$failed" -eq 1 ] && echo debugger-error || echo hardware-insertion-unconfirmed)"; sha256sum "$log" 2>/dev/null || true; grep -Ei 'hardware assisted breakpoint|Cannot insert|hardware breakpoint|ptrace|No such process|error:' "$log" | tail -n 24 || true; exit 1; fi; echo "FLR0414_GDB_START=PASS status=hardware-breakpoint-confirmed expected_pc=$runtime_addr"; status=BOUNDED_NO_HIT; stop_pc=none; for n in $(seq 1 420); do if grep -q '^FLR0414_STOP_PC=' "$log"; then stop_pc=$(sed -n 's/^FLR0414_STOP_PC=//p' "$log" | tail -n 1); if [ "$stop_pc" = "$runtime_addr" ]; then status=HIT; else status=STOPPED_OTHER; fi; break; fi; if grep -Eiq 'Program received signal|Cannot insert.*hardware breakpoint|Operation not permitted|ptrace.*(denied|operation not permitted)' "$log"; then status=STOPPED_OTHER; break; fi; if [ "$(cat "/proc/$pid/comm" 2>/dev/null || true)" != flutter-auto ] || [ "$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null || true)" != "$start" ]; then status=APP_IDENTITY_LOST; break; fi; if [ $((n % 10)) -eq 0 ]; then kernel_dump=$(/usr/bin/timeout --signal=TERM --kill-after=1s 2 dmesg 2>/dev/null) || { status=KERNEL_LOG_UNAVAILABLE; break; }; faults=$(printf '%s\n' "$kernel_dump" | grep -Ec 'BUG: unable to handle page fault|Oops:|kernel BUG|Out of memory|Killed process' || true); unset kernel_dump; case "$faults" in ''|*[!0-9]*) status=KERNEL_FAULT_COUNT_UNKNOWN; break ;; esac; if [ "$faults" -gt "$fault_baseline" ]; then status=KERNEL_FAULT; break; fi; fi; if [ "$(cat "/proc/$gdb_pid/comm" 2>/dev/null || true)" != timeout ]; then status=GDB_EXITED_NO_HIT; break; fi; sleep 1; done; if [ "$status" = HIT ]; then sleep 3; kernel_dump=$(/usr/bin/timeout --signal=TERM --kill-after=1s 2 dmesg 2>/dev/null) || { status=HIT_KERNEL_LOG_UNAVAILABLE; kernel_dump=; }; if [ -n "$kernel_dump" ]; then faults=$(printf '%s\n' "$kernel_dump" | grep -Ec 'BUG: unable to handle page fault|Oops:|kernel BUG|Out of memory|Killed process' || true); [ "$faults" -le "$fault_baseline" ] || status=HIT_THEN_KERNEL_FAULT; unset kernel_dump; fi; fi; printf 'FLR0414_HWBP_RESULT status=%s expected_pc=%s stop_pc=%s\n' "$status" "$runtime_addr" "$stop_pc"; )
