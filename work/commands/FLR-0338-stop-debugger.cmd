pidfile=/run/user/1001/flr0338-gdb.pid; if [ ! -s "$pidfile" ]; then echo gdb_pid_file=missing; else pid=$(cat "$pidfile"); comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); echo "gdb_launcher_pid=$pid comm=${comm:-exited}"; if [ "$comm" = timeout ]; then kill -TERM "$pid"; for n in 1 2 3 4 5; do [ -d "/proc/$pid" ] || break; sleep 1; done; if [ ! -d "/proc/$pid" ]; then echo gdb_stop=PASS; else echo gdb_stop=FAIL; fi; else echo gdb_stop=no-signal-needed; fi; fi; echo FLR0338_GDB_STOP_DONE
