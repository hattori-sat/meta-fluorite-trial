trace=/var/tmp/flr0337-pagefault.data; text=/var/tmp/flr0337-fault-window.txt; fault_time=$(journalctl -k -b -o short-monotonic --no-pager -n 400 2>/dev/null | awk '/BUG: unable to handle page fault/ {t=$2; gsub(/[\[\]]/, "", t); print t; exit}'); if [ -n "$fault_time" ]; then from=$(awk -v t="$fault_time" 'BEGIN {printf "%.9f", t-0.020}'); to=$(awk -v t="$fault_time" 'BEGIN {printf "%.9f", t+0.020}'); echo "fault_time=$fault_time range=$from,$to"; timeout 20s perf script --ns --time "$from,$to" --max-stack 32 -i "$trace" >"$text" 2>&1; status=$?; echo perf_script_status=$status; echo selected_lines=$(wc -l < "$text"); awk 'BEGIN {RS=""; ORS="\n\n"} /exceptions:page_fault_(kernel|user):/ {print}' "$text" | head -n 180; echo matching_kernel_oops; journalctl -k -b -o short-monotonic --no-pager -n 400 | awk '/BUG: unable to handle page fault/ {active=1; left=28} active && left>0 {print; left--}' | tail -n 60; else echo fault_time=not-found; fi; echo perf_loss_or_record_summary; grep -Ei 'lost|sample|recorded|failed' /run/flr0337-perf-record.log 2>/dev/null | tail -n 12 || echo perf_record_summary=unavailable; echo FLR0337_FAULT_WINDOW_DONE
