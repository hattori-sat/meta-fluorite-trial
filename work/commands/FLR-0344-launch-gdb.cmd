pidfile=/run/user/1001/flr0344-flutter.pid; gdb_pidfile=/run/user/1001/flr0344-gdb-watch.pid; gdb_log=/run/user/1001/flr0344-gdb-watch.log; gdb_script=/run/user/1001/flr0344-sync-watch.gdb; pid=$(cat "$pidfile" 2>/dev/null || true); comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); if [ "$comm" != flutter-auto ] || [ ! -r "$gdb_script" ] || [ -e "$gdb_pidfile" ] || [ -e "$gdb_log" ]; then echo FLR0344_GDB_LAUNCH=FAIL precondition; else /bin/sh -c 'trap - INT; exec /usr/bin/gdb -q -batch -p "$1" -x "$2"' _ "$pid" "$gdb_script" </dev/null >"$gdb_log" 2>&1 & gp=$!; printf '%s\n' "$gp" >"$gdb_pidfile"; sleep 0.3; gcomm=$(cat "/proc/$gp/comm" 2>/dev/null || true); gstate=$(ps -p "$gp" -o stat= 2>/dev/null | tr -d ' '); [ -n "$gcomm" ] || gcomm=exited; [ -n "$gstate" ] || gstate=exited; echo "FLR0344_GDB_PID=$gp comm=$gcomm state=$gstate"; if [ "$gcomm" = gdb ] && [ "${gstate#Z}" = "$gstate" ]; then echo FLR0344_GDB_LAUNCH=PASS; else echo FLR0344_GDB_LAUNCH=EXITED_EARLY; sed -n '1,80p' "$gdb_log"; fi; fi
