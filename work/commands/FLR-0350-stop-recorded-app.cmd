pidfile=/run/user/1001/flr0350-flutter.pid; startfile=/run/user/1001/flr0350-wrapper.start; gate=/run/user/1001/flr0350-go.fifo; pid=$(cat "$pidfile" 2>/dev/null || true); expected=$(cat "$startfile" 2>/dev/null || true); start=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null || true); comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); uid=$(awk '/^Uid:/ {print $2; exit}' "/proc/$pid/status" 2>/dev/null || true); target_gone=0; if [ -n "$pid" ] && [ -n "$expected" ] && [ "$start" = "$expected" ] && [ "$uid" = "$(id -u agl-driver)" ] && { [ "$comm" = flutter-auto ] || [ "$comm" = sh ]; }; then kill -TERM "$pid" 2>/dev/null || true; i=0; while [ "$i" -lt 20 ] && [ "$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null || true)" = "$expected" ]; do sleep 0.2; i=$((i + 1)); done; if [ "$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null || true)" != "$expected" ]; then echo "FLR0350_APP_STOP=PASS pid=$pid start=$expected"; target_gone=1; else echo "FLR0350_APP_STOP=FAIL pid=$pid start=$start"; fi; elif [ -n "$pid" ] && [ -n "$expected" ] && [ "$start" != "$expected" ]; then echo "FLR0350_APP_STOP=already-exited recorded_pid=$pid recorded_start=$expected"; target_gone=1; elif [ -z "$pid" ] && [ ! -e "$gate" ] && [ ! -L "$gate" ]; then echo FLR0350_APP_STOP=not-launched; target_gone=1; else echo "FLR0350_APP_STOP=FAIL identity_unknown pid=${pid:-missing} comm=${comm:-exited} start=${start:-unknown} expected=${expected:-unknown}"; fi; count=$(pgrep -c -x flutter-auto 2>/dev/null || true); [ -n "$count" ] || count=0; echo flutter_processes=$count; if [ "$target_gone" -eq 1 ] && [ "$count" -eq 0 ]; then if [ -e "$gate" ] || [ -L "$gate" ]; then meta=$(stat -c '%u:%a' "$gate" 2>/dev/null || true); owner=$(id -u agl-driver); if [ -p "$gate" ] && [ ! -L "$gate" ] && [ "$meta" = "$owner:600" ] && unlink "$gate"; then echo FLR0350_FIFO_CLEANUP=PASS removed=run-owned-fifo; else echo "FLR0350_FIFO_CLEANUP=FAIL type_or_owner=$meta"; fi; else echo FLR0350_FIFO_CLEANUP=PASS removed=none; fi; else echo FLR0350_FIFO_CLEANUP=FAIL process_or_identity_remains; fi
