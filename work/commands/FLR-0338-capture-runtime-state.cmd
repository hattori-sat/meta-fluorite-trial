pidfile=/run/user/1001/flr0338-flutter.pid; log=/run/user/1001/flr0338-production.log; gdb=/run/user/1001/flr0338-gdb.log; echo guest_uptime=$(cut -d' ' -f1 /proc/uptime); if [ -s "$pidfile" ]; then pid=$(cat "$pidfile"); comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); echo "tracked_pid=$pid comm=${comm:-exited}"; if [ "$comm" = flutter-auto ]; then ps -L -p "$pid" -o pid=,tid=,stat=,wchan:28=,comm= | head -n 32; else echo app_process=exited; fi; else echo app_pid_file=missing; fi; if [ -s "$gdb" ]; then echo "gdb_log_sha256=$(sha256sum "$gdb" | cut -d' ' -f1)"; echo FLR0338_GDB_LOG_BEGIN; sed -n '1,180p' "$gdb"; echo FLR0338_GDB_LOG_END; else echo gdb_log=missing; fi; if [ -s "$log" ]; then echo "app_log_sha256=$(sha256sum "$log" | cut -d' ' -f1)"; for marker in FLR0026_SCENE_STAGE_DRAW_END FLR0026_VK_QUEUE_PRESENT_BEGIN FLR0026_VK_QUEUE_PRESENT_RETURN FLUORITE_VK_PRESENT_CALL_BEGIN FLUORITE_VK_QUEUE_PRESENT_ENTER FLUORITE_VK_QUEUE_PRESENT_RETURN FLUORITE_VK_PRESENT_DONE FLUORITE_NATIVE_WAYLAND_COMMIT; do echo "${marker}_count=$(grep -c "$marker" "$log" 2>/dev/null || true)"; done; grep -n -E 'FLR0311_PRODUCTION_ASSET_(CREATE|ASYNC)|FLR0026_SCENE_STAGE_ADD_COMPLETE|FLR0320_GLTFIO_EMISSIVE_(BIND|APPLY)|FLR0326_PRODUCTION_UNLIT_OVERRIDE|FLR0026_VK_QUEUE_PRESENT_(BEGIN|RETURN)|FLUORITE_VK_(PRESENT_CALL_BEGIN|QUEUE_PRESENT_ENTER|QUEUE_PRESENT_RETURN|PRESENT_DONE)|FLUORITE_NATIVE_WAYLAND_COMMIT|SIGSEGV|Segmentation fault|page fault|Oops:|BUG:|Out of memory|oom-kill' "$log" | tail -n 48; else echo app_log=missing; fi; dmesg --color=never 2>/dev/null | grep -E 'Oops:|RIP:|CR2:|Call Trace:|kernel page fault|BUG:|Killed process' | tail -n 50; echo FLR0338_RUNTIME_STATE_DONE
