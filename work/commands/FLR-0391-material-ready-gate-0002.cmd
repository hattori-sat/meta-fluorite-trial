set -eu; log=/run/user/1001/flr0391-0002-app.log; identity=/run/user/1001/flr0391-0002-app.identity; read pid saved_uid saved_start wrapper < "$identity"; for i in $(seq 1 300); do ready=$(grep -c FLUORITE_SEQUOIA_LIT_MATERIAL_READY "$log" 2>/dev/null || true); bound=$(grep -c FLUORITE_SEQUOIA_LIT_MATERIAL_BOUND "$log" 2>/dev/null || true); sun=$(grep -c FLR0305_PRODUCTION_SCENE_LIGHT_SETUP_DONE "$log" 2>/dev/null || true); if [ "$ready" -ge 1 ] && [ "$bound" -eq 24 ] && [ "$sun" -ge 1 ]; then break; fi; if [ ! -r "/proc/$pid/stat" ]; then break; fi; sleep 0.2; done; if [ -r "/proc/$pid/status" ]; then uid=$(stat -c %u "/proc/$pid"); start=$(awk '{print $22}' "/proc/$pid/stat"); else uid=none; start=none; fi; apps=$(pgrep -u 1001 -x flutter-auto || true); set -- $apps; count=$#; ready=$(grep -c FLUORITE_SEQUOIA_LIT_MATERIAL_READY "$log" 2>/dev/null || true); bound=$(grep -c FLUORITE_SEQUOIA_LIT_MATERIAL_BOUND "$log" 2>/dev/null || true); sun=$(grep -c FLR0305_PRODUCTION_SCENE_LIGHT_SETUP_DONE "$log" 2>/dev/null || true); begins=$(grep -c FLR0026_VK_QUEUE_PRESENT_BEGIN "$log" 2>/dev/null || true); returns=$(grep -c 'FLR0026_VK_QUEUE_PRESENT result=' "$log" 2>/dev/null || true); done_count=$(grep -c FLR0026_VK_PRESENT_BOUNDARY_DONE "$log" 2>/dev/null || true); printf 'FLR0391_0002_READY_GATE pid=%s uid=%s start=%s saved_start=%s app_count=%s READY=%s BOUND=%s SUN=%s PRESENT_BEGIN=%s PRESENT_RETURN=%s PRESENT_DONE=%s\n' "$pid" "$uid" "$start" "$saved_start" "$count" "$ready" "$bound" "$sun" "$begins" "$returns" "$done_count"; if [ "$uid" = "$saved_uid" ] && [ "$start" = "$saved_start" ] && [ "$count" -eq 1 ] && [ "$1" = "$pid" ]; then echo FLR0391_0002_PID_GATE=PASS; else echo FLR0391_0002_PID_GATE=FAIL; exit 1; fi; if [ "$ready" -ge 1 ] && [ "$bound" -eq 24 ] && [ "$sun" -ge 1 ]; then echo FLR0391_0002_MATERIAL_GATE=PASS; else echo FLR0391_0002_MATERIAL_GATE=FAIL; exit 1; fi
