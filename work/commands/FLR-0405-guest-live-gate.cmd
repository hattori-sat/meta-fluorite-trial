( set -eu; read pid saved_uid saved_start fault_baseline < /run/user/1001/flr0405-0001.identity; uid=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status"); start=$(awk '{print $22}' "/proc/$pid/stat"); comm=$(cat "/proc/$pid/comm"); test "$uid" = "$saved_uid"; test "$start" = "$saved_start"; test "$comm" = flutter-auto; log=/run/user/1001/flr0405-0001-app.log; begins=$(grep -c 'FLR0026_VK_QUEUE_PRESENT_BEGIN' "$log" || true); returns=$(grep -c 'FLR0026_VK_QUEUE_PRESENT result=' "$log" || true); uptime=$(awk '{print $1}' /proc/uptime); marker="FLR0405_LIVE_GATE pid=$pid uid=$uid start=$start uptime=$uptime present_begin=$begins present_return=$returns"; printf '%s\n' "$marker" >> "$log"; printf '%s\n' "$marker"; )
