for name in gdb flutter; do pidfile="/run/user/1001/flr0334-$name.pid"; if [ -s "$pidfile" ]; then pid=$(cat "$pidfile"); comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); expected=gdb; [ "$name" = flutter ] && expected=flutter-auto; if [ "$comm" = "$expected" ]; then kill -TERM "$pid" 2>/dev/null || true; echo stopped_$name-pid=$pid; else echo already_stopped_$name=true; fi; fi; done; sleep 2; gdb_count=$(pgrep -c -x gdb 2>/dev/null || true); flutter_count=$(pgrep -c -x flutter-auto 2>/dev/null || true); [ -n "$gdb_count" ] || gdb_count=0; [ -n "$flutter_count" ] || flutter_count=0; echo gdb_processes=$gdb_count; echo flutter_processes=$flutter_count
