( set -eu; identity=/run/user/1001/fluorite-0408-0001.identity; read pid saved_uid saved_start fault_baseline < "$identity"; if [ ! -r "/proc/$pid/stat" ]; then echo FLUORITE0408_STOP=ALREADY_EXITED; exit 0; fi; uid=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status"); start=$(awk '{print $22}' "/proc/$pid/stat"); test "$uid" = "$saved_uid"; test "$start" = "$saved_start"; log=/run/user/1001/fluorite-0408-0001-app.log; printf 'FLUORITE0408_STOP=SIGTERM pid=%s uid=%s start=%s\n' "$pid" "$uid" "$start" >> "$log"; kill -TERM "$pid"; n=0; while [ "$n" -lt 40 ]; do if [ ! -r "/proc/$pid/stat" ]; then echo FLUORITE0408_STOP=PASS; exit 0; fi; uid_now=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status"); start_now=$(awk '{print $22}' "/proc/$pid/stat"); test "$uid_now" = "$saved_uid"; test "$start_now" = "$saved_start"; n=$((n+1)); sleep 0.25; done; echo FLUORITE0408_STOP=FAIL_TERM_TIMEOUT; exit 1; )
