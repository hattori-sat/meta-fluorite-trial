echo guest_uptime=$(cut -d' ' -f1 /proc/uptime); if [ -x /usr/bin/gdb ] && command -v timeout >/dev/null 2>&1 && [ -r /usr/lib/libLLVM.so.18.1 ]; then echo gdb_version=$(/usr/bin/gdb --version | head -n 1); sha256sum /usr/lib/libLLVM.so.18.1; count=$(pgrep -c -x flutter-auto 2>/dev/null || true); [ -n "$count" ] || count=0; echo flutter_processes=$count; if [ "$count" -eq 0 ] && [ ! -e /run/user/1001/flr0341-production.log ] && [ ! -e /run/user/1001/flr0341-flutter.pid ]; then echo FLR0341_PREFLIGHT=PASS; else echo FLR0341_PREFLIGHT=FAIL app-state-collision; fi; else echo FLR0341_PREFLIGHT=FAIL debugger-or-library-missing; fi
