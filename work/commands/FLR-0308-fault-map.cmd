sleep 45; printf 'FLR0308_FAULT_MAP_BEGIN\n'; pid=$(pgrep -n -x flutter-auto || true); printf 'flutter_pid=%s\n' "$pid"; if test -n "$pid"; then ps -L -p "$pid" -o pid,tid,stat,wchan:32,etime,rss,comm; printf '%s\n' '--- maps ---'; grep -E '/usr/bin/flutter-auto|/usr/lib|libflutter|libfilament|libvulkan|libLLVM|libc\.so' "/proc/$pid/maps" | tail -n 160; fi; printf '%s\n' '--- journal fault ---'; journalctl -b --no-pager -n 220 2>/dev/null | grep -E 'FEngine|BUG:|#PF:|Oops:|CPU:|RIP:|RSP:|RAX:|RBX:|RCX:|RDX:|CR2:|SIGSEGV|segfault' | tail -n 120 || true; printf '%s\n' '--- coredump ---'; coredumpctl list --no-legend 2>/dev/null | tail -n 12 || true; printf 'FLR0308_FAULT_MAP_END\n'
