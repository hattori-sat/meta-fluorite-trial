for name in fixture production; do pidfile="/run/user/1001/flr0333-${name}.pid"; if [ -s "$pidfile" ]; then pid=$(cat "$pidfile"); comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); if [ "$comm" = flutter-auto ]; then kill "$pid" 2>/dev/null || true; echo "stopped_$name-pid=$pid"; else echo "already_stopped_$name=true"; fi; fi; done; sleep 2; count=$(pgrep -c -x flutter-auto 2>/dev/null || true); [ -n "$count" ] || count=0; echo "flutter_processes=$count"
