echo guest_uptime=$(cut -d' ' -f1 /proc/uptime); if [ -x /usr/bin/gdb ] && command -v timeout >/dev/null 2>&1 && [ -r /usr/lib/libLLVM.so.18.1 ]; then echo gdb_version=$(/usr/bin/gdb --version | head -n 1); echo timeout_path=$(command -v timeout); sha256sum /usr/lib/libLLVM.so.18.1; count=$(pgrep -c -x flutter-auto 2>/dev/null || true); [ -n "$count" ] || count=0; echo flutter_processes=$count; if [ "$count" -eq 0 ]; then echo FLR0338_PREFLIGHT=PASS; else echo FLR0338_PREFLIGHT=FAIL app-already-running; fi; else echo FLR0338_PREFLIGHT=FAIL debugger-or-library-missing; fi
