( set -eu; r=/run/user/1001/flr0415-0001; test -s "$r-host.identity"; read wrapper wstart gdbpid gstart baseline wall up bundle < "$r-host.identity"; echo "FLR0415_SNAPSHOT wall=$wall uptime=$up fault_baseline=$baseline"; if [ -s "$r-identity" ]; then read app appuid appstart < "$r-identity"; test "$appuid" = 1001; test "$(awk '{print $22}' "/proc/$app/stat" 2>/dev/null || true)" = "$appstart" && echo FLR0415_APP_IDENTITY=LIVE || echo FLR0415_APP_IDENTITY=EXITED; fi; echo FLR0415_PRESENT_LINES_BEGIN; grep -E 'present.*(begin|return|success)|FLR0415_HIT_PC|FEngine::loop|Program received signal' "$r-log" | tail -n 80 || true; echo FLR0415_PRESENT_LINES_END; now=$(/usr/bin/timeout --signal=TERM --kill-after=1s 2 dmesg 2>/dev/null) || { echo FLR0415_KERNEL=UNAVAILABLE; exit 0; }; current=$(printf '%s\n' "$now" | grep -Ec 'BUG: unable to handle page fault|Oops:|kernel BUG|Out of memory|Killed process' || true); echo "FLR0415_KERNEL_FAULTS baseline=$baseline current=$current"; printf '%s\n' "$now" | grep -E 'BUG: unable to handle page fault|Oops:|kernel BUG|Out of memory|Killed process|RIP:|CR2:' | tail -n 40 || true; )
