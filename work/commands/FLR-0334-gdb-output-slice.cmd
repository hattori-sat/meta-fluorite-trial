log=/run/user/1001/flr0334-gdb.log; if [ ! -s "$log" ]; then echo gdb_log=NOT_READY; exit 3; fi; sha256sum "$log"; grep -n -E 'Program received signal|SIGSEGV|SIGINT|^Thread [0-9]+|^#[0-9]+.*(FEngine|vkQueuePresentKHR|vkWaitFor|cnd_wait|nanosleep|wl_display_poll|EventHandler|DrawFrame|CallEvent|sys_poll|futex)' "$log" | head -n 150; printf 'signal_marker_count='; grep -c -E 'Program received signal|SIGSEGV|SIGINT' "$log" || true; printf 'present_return_count='; grep -c -E 'QUEUE_PRESENT_RETURN|PRESENT_DONE|QUEUE_PRESENT_END' "$log" || true; gdb_count=$(pgrep -c -x gdb 2>/dev/null || true); flutter_count=$(pgrep -c -x flutter-auto 2>/dev/null || true); [ -n "$gdb_count" ] || gdb_count=0; [ -n "$flutter_count" ] || flutter_count=0; echo gdb_processes=$gdb_count; echo flutter_processes=$flutter_count; for pidfile in /run/user/1001/flr0334-gdb.pid /run/user/1001/flr0334-flutter.pid; do if [ -r "$pidfile" ]; then pid=$(cat "$pidfile"); echo "tracked_pid=$pid comm=$(cat /proc/$pid/comm 2>/dev/null || echo exited)"; ps -o pid=,ppid=,stat=,wchan:32=,comm= -p "$pid"; case "$(cat /proc/$pid/comm 2>/dev/null || true)" in flutter-auto) ps -L -p "$pid" -o pid=,tid=,stat=,wchan:32=,comm= | head -n 50;; esac; fi; done
