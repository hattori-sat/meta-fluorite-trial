echo guest_uptime=$(cut -d' ' -f1 /proc/uptime); available_kib=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo); kill_impl=$(/bin/sh -c 'command -V kill' 2>&1 || true); gdb_python=$(/usr/bin/gdb -q -batch -ex 'python import gdb; required=("Breakpoint","FinishBreakpoint","objfiles","selected_inferior","newest_frame"); bp=("pending","locations","commands"); missing=[n for n in required if not hasattr(gdb,n)]; missing += ["Breakpoint."+n for n in bp if not hasattr(gdb.Breakpoint,n)]; print("FLR0350_GDB_API=PASS" if not missing else "FLR0350_GDB_API=FAIL "+",".join(missing))' 2>&1 || true); gdb_catch=$(/usr/bin/gdb -q -batch -ex 'set breakpoint pending on' -ex 'set follow-exec-mode same' -ex 'set follow-fork-mode parent' -ex 'set detach-on-fork on' -ex 'catch exec' -ex 'catch fork' -ex 'catch vfork' -ex 'catch load libvulkan_lvp.so' 2>&1 || true); catchpoints=$(printf '%s\n' "$gdb_catch" | grep -c '^Catchpoint ' || true); printf 'MemAvailable_kib=%s\nkill_builtin_check=%s\nGDB_catchpoints=%s\n' "$available_kib" "$kill_impl" "$catchpoints"; printf '%s\n' "$gdb_python" | grep -E 'FLR0350_GDB_API=|Error|error|Python' | head -n 4; printf '%s\n' "$gdb_catch" | grep -E '^Catchpoint |Undefined|Error|error|not supported' | head -n 8; count=$(pgrep -c -x flutter-auto 2>/dev/null || true); [ -n "$count" ] || count=0; if [ -x /usr/bin/gdb ] && [ -r /usr/lib/libvulkan_lvp.so ] && [ -r /proc/self/syscall ] && command -v mkfifo >/dev/null && command -v stat >/dev/null && command -v timeout >/dev/null && command -v gzip >/dev/null && command -v base64 >/dev/null && command -v sha256sum >/dev/null && command -v unlink >/dev/null && command -v mv >/dev/null && printf '%s\n' "$gdb_python" | grep -Fqx FLR0350_GDB_API=PASS && [ "$catchpoints" -eq 4 ] && [ "$available_kib" -ge 2097152 ] && [ "$count" -eq 0 ] && [ -S /run/user/1001/wayland-0 ] && printf '%s' "$kill_impl" | grep -qi builtin && [ ! -e /run/user/1001/flr0350-production.log ] && [ ! -e /run/user/1001/flr0350-flutter.pid ] && [ ! -e /run/user/1001/flr0350-wrapper.start ] && [ ! -e /run/user/1001/flr0350-go.fifo ] && [ ! -e /run/user/1001/flr0350-go-uptime ] && [ ! -e /run/user/1001/flr0350-gdb-armed ] && [ ! -e /run/user/1001/flr0350-exec-result ] && [ ! -e /run/user/1001/flr0350-symbols-ready ] && [ ! -e /run/user/1001/flr0350-matched-wait ] && [ ! -e /run/user/1001/flr0350-gdb.log ] && [ ! -e /run/user/1001/flr0350-gdb.pid ] && [ ! -e /run/user/1001/flr0350-gdb.start ] && [ ! -e /run/user/1001/flr0350-sync-producer.gdb ] && [ ! -e /run/user/1001/flr0350-sync-producer.gdb.gz ] && [ ! -e /run/user/1001/flr0350-sync-producer.gdb.tmp ]; then echo "gdb_version=$(/usr/bin/gdb --version | head -n 1)"; echo FLR0350_PREFLIGHT=PASS; else echo "flutter_processes=$count"; echo FLR0350_PREFLIGHT=FAIL; fi
