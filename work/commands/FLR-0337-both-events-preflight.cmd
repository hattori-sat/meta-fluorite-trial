printf 'perf='; if command -v perf >/dev/null 2>&1; then echo available; perf version 2>&1 | head -n 1; else echo unavailable; fi; printf 'perf_event_paranoid='; if [ -r /proc/sys/kernel/perf_event_paranoid ]; then cat /proc/sys/kernel/perf_event_paranoid; else echo unavailable; fi; found=0; for trace_root in /sys/kernel/tracing /sys/kernel/debug/tracing; do for event in page_fault_kernel page_fault_user; do format="$trace_root/events/exceptions/$event/format"; if [ -r "$format" ]; then echo "trace_event=available name=exceptions:$event root=$trace_root"; grep -E 'field:.*(ip|address|error_code)' "$format" | head -n 8 || true; found=$((found+1)); fi; done; done; echo trace_event_count=$found; if [ -r /proc/config.gz ] && command -v zcat >/dev/null 2>&1; then zcat /proc/config.gz | grep -E '^CONFIG_(PERF_EVENTS|TRACEPOINTS|FTRACE|FUNCTION_TRACER|FRAME_POINTER)=' || true; else echo kernel_config=unavailable; fi; echo FLR0337_BOTH_EVENTS_PREFLIGHT_DONE
