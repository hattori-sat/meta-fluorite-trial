gdb_pidfile=/run/user/1001/flr0343-gdb-watch.pid; gdb_log=/run/user/1001/flr0343-gdb-watch.log; if [ -s "$gdb_pidfile" ]; then gp=$(cat "$gdb_pidfile"); if [ -d "/proc/$gp" ] && [ "$(cat "/proc/$gp/comm" 2>/dev/null || true)" = gdb ]; then echo gdb_alive=1; else echo gdb_alive=0; fi; else echo gdb_pid_file=missing; fi; if [ -s "$gdb_log" ]; then grep -E 'FLR0343_(WATCHPOINTS_ARMED|WATCH_SETUP_FAIL|WAIT_FRAME|SYNC_PTR|EXPECTED_HANDLE|SIGNAL_FIELD|FENCE_FIELD|SIGNAL_INITIAL|FENCE_INITIAL|POST_STOP|SIGNAL_AFTER|FENCE_AFTER)|Hardware watchpoint|Old value|New value|Program received signal|#([0-9]+) .*lvp_pipe_sync_wait|#([0-9]+) .*wsi_common_queue_present' "$gdb_log" | tail -n 50 || true; else echo gdb_log=missing; fi
