waitfile=/run/user/1001/flr0350-matched-wait; gdbfile=/run/user/1001/flr0350-gdb.log; pid=$(cat /run/user/1001/flr0350-flutter.pid 2>/dev/null || true); gpid=$(cat /run/user/1001/flr0350-gdb.pid 2>/dev/null || true); expected=$(cat /run/user/1001/flr0350-wrapper.start 2>/dev/null || true); expected_gstart=$(cat /run/user/1001/flr0350-gdb.start 2>/dev/null || true); marker=$(cat "$waitfile" 2>/dev/null || true); wait_uptime=$(printf '%s\n' "$marker" | sed -n 's/.* uptime=\([^ ]*\).*/\1/p'); outcome=IDENTITY_OR_MARKER_UNKNOWN; i=0; if printf '%s\n' "$marker" | grep -q 'watchpoints=PASS' && [ -n "$wait_uptime" ]; then outcome=NO_HIT; while [ "$i" -lt 40 ]; do gcomm=$(cat "/proc/$gpid/comm" 2>/dev/null || true); gstart=$(awk '{sub(/^.*\) /,""); print $20}' "/proc/$gpid/stat" 2>/dev/null || true); guid=$(awk '/^Uid:/ {print $2; exit}' "/proc/$gpid/status" 2>/dev/null || true); appcomm=$(cat "/proc/$pid/comm" 2>/dev/null || true); appstart=$(awk '{sub(/^.*\) /,""); print $20}' "/proc/$pid/stat" 2>/dev/null || true); tracer=$(awk '/^TracerPid:/ {print $2; exit}' "/proc/$pid/status" 2>/dev/null || true); if [ "$gcomm" != gdb ] || [ "$gstart" != "$expected_gstart" ] || [ "$guid" != 0 ] || [ "$appcomm" != flutter-auto ] || [ "$appstart" != "$expected" ] || [ "$tracer" != "$gpid" ]; then outcome=DEBUGGER_OR_TARGET_LOST; break; fi; hits=$(grep 'FLR0350_SYNC_WRITE field=' "$gdbfile" 2>/dev/null | awk -v s="$wait_uptime" '{split($0,a,"uptime="); if (length(a) > 1) {split(a[2],b," "); t=b[1]+0; if (t >= s+0 && t-s <= 10.0) n++}} END {print n+0}'); untimed=$(grep 'FLR0350_SYNC_WRITE field=' "$gdbfile" 2>/dev/null | awk 'index($0,"uptime=") == 0 {n++} END {print n+0}'); if [ "$untimed" -gt 0 ]; then outcome=WRITE_TIMESTAMP_UNKNOWN; break; fi; if [ "$hits" -gt 0 ]; then outcome=HIT; break; fi; elapsed=$(awk -v s="$wait_uptime" -v n="$(cut -d' ' -f1 /proc/uptime)" 'BEGIN {printf "%.2f",n-s}'); expired=$(awk -v e="$elapsed" 'BEGIN {print (e >= 10.0) ? 1 : 0}'); if [ "$expired" -eq 1 ]; then break; fi; sleep 0.25; i=$((i + 1)); done; elapsed=$(awk -v s="$wait_uptime" -v n="$(cut -d' ' -f1 /proc/uptime)" 'BEGIN {printf "%.2f",n-s}'); fi; if [ "$outcome" = HIT ] || [ "$outcome" = NO_HIT ] || [ "$outcome" = WRITE_TIMESTAMP_UNKNOWN ]; then gcomm_now=$(cat "/proc/$gpid/comm" 2>/dev/null || true); gstart_now=$(awk '{sub(/^.*\) /,""); print $20}' "/proc/$gpid/stat" 2>/dev/null || true); guid_now=$(awk '/^Uid:/ {print $2; exit}' "/proc/$gpid/status" 2>/dev/null || true); if [ "$gcomm_now" = gdb ] && [ "$gstart_now" = "$expected_gstart" ] && [ "$guid_now" = 0 ]; then kill -INT "$gpid" 2>/dev/null || true; echo "FLR0350_GDB_WINDOW_STOP=sent pid=$gpid start=$gstart_now"; else outcome=DEBUGGER_OR_TARGET_LOST; fi; fi; echo "FLR0350_WATCH_WINDOW=$outcome elapsed=$([ -n "${elapsed:-}" ] && printf '%s' "$elapsed" || echo unknown) polls=$i hits=${hits:-0} wait_uptime=${wait_uptime:-unknown}"; if [ -s "$gdbfile" ]; then grep -E 'FLR0350_(WAIT_WATCHPOINTS|SYNC_WRITE|MATCHED_WAIT|COVERAGE_GAP)' "$gdbfile" | tail -n 32 || true; fi
