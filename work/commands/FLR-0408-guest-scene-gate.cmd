( set -eu; identity=/run/user/1001/fluorite-0408-0001.identity; log=/run/user/1001/fluorite-0408-0001-app.log; read pid uid start fault_baseline < "$identity"; n=0; status=TIMEOUT; deadline=$(( $(date +%s) + 50 )); fault_pattern='BUG: unable to handle page fault|Oops:|kernel BUG|Out of memory|Killed process'; while [ "$n" -lt 90 ] && [ "$(date +%s)" -lt "$deadline" ]; do n=$((n+1)); bytes=$(wc -c < "$log" 2>/dev/null || echo 0); case "$bytes" in ''|*[!0-9]*) status=LOG_INVALID; break ;; esac; if [ "$bytes" -gt 900000 ]; then status=LOG_INVALID; break; fi; current_uid=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status" 2>/dev/null || true); proc_state=$(awk '{print $3,$22}' "/proc/$pid/stat" 2>/dev/null || true); proc_comm=$(cat "/proc/$pid/comm" 2>/dev/null || true); current_pids=$(pgrep -u 1001 -x flutter-auto 2>/dev/null || true); set -- $proc_state; if [ "$#" -ne 2 ] || [ -z "$current_uid" ]; then status=APP_EXIT; break; fi; case "$1" in Z|T|t) status=APP_EXIT; break ;; esac; if [ "$current_uid" != "$uid" ] || [ "$2" != "$start" ] || [ "$proc_comm" != flutter-auto ] || [ "$current_pids" != "$pid" ]; then status=IDENTITY_CHANGED; break; fi; kernel_dump=$(/usr/bin/timeout --signal=TERM --kill-after=1s 2 dmesg 2>/dev/null) || { status=KERNEL_UNKNOWN; break; }; faults=$(printf '%s\n' "$kernel_dump" | grep -Ec "$fault_pattern" || true); unset kernel_dump; case "$faults" in ''|*[!0-9]*) status=KERNEL_UNKNOWN; break ;; esac; if [ "$faults" -gt "$fault_baseline" ]; then status=KERNEL_FAULT; break; fi; if grep -Fq 'FLR0026_MODEL_STAGE_SCENE_ADD_DONE' "$log"; then status=READY; break; fi; sleep 0.5; done; wall=$(date '+%Y-%m-%dT%H:%M:%S%z'); uptime=$(awk '{print $1}' /proc/uptime); marker="FLUORITE0408_SCENE_GATE status=$status pid=$pid uid=$uid start=$start wall=$wall uptime=$uptime samples=$n"; printf '%s\n' "$marker" >> "$log"; printf '%s\n' "$marker"; [ "$status" = READY ]; )
