rm -f /tmp/flr0150-runtime.log /tmp/flr0150-app.pid; su -s /bin/sh agl-driver -c 'env XDG_RUNTIME_DIR=/run/user/1001 WAYLAND_DISPLAY=wayland-0 WAYLAND_DEBUG=client FLUORITE_NATIVE_PURE_FIXTURE=1 FLUORITE_NATIVE_MINIMAL_GEOMETRY=1 FLUORITE_NATIVE_FIXTURE_LOCAL_CAMERA=1 FLR0026_SYNC_TRACE=1 FLR0026_FORCE_RENDER_ON_SKIPPED_FRAME=1 FLUORITE_VIEWTARGET_FRAME_TRACE=1 FLR0026_TARGET_TRACE=1 FLUORITE_VK_SWAPCHAIN_PIXEL_TRACE=1 nohup /usr/bin/flutter-auto -b /usr/share/flutter/toyota-connected-tcna-packages-filament-scene-fluorite-examples-demo/3.32.5/release >/tmp/flr0150-runtime.log 2>&1 & echo $! >/tmp/flr0150-app.pid'; sleep 15; printf '%s\n' APP_PID; cat /tmp/flr0150-app.pid; printf '%s\n' SELECTED_MARKERS; grep -n -E 'FLUORITE_VK_SWAPCHAIN_PIXEL|FLUORITE_NATIVE_MINIMAL_GEOMETRY_CONTRACT|FLUORITE_VIEWTARGET_EFFECTIVE_CONTRACT|FLUORITE_VIEWTARGET_BEGIN_FRAME|FLUORITE_VIEWTARGET_RENDER_RETURN|FLR0026_TARGET_DRAW2|FLR0026_VK_(QUEUE_PRESENT|PRESENT_BOUNDARY|READBACK)|wl_subsurface|wl_surface' /tmp/flr0150-runtime.log | head -n 240
