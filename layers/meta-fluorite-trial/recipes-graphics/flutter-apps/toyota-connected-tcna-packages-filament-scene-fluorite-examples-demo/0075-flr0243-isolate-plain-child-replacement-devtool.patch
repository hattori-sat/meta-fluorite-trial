 // only used to separate Flutter composition from the native Filament path.
 const bool kFlr0026DiagnosticMock3d = false;
 
-/// FLR-0242 diagnostic child. It exercises the common StatefulSceneView
-/// mount contract without Planetarium-specific state or native commands.
-class _Flr0242InertSceneView extends StatefulSceneView {
-  const _Flr0242InertSceneView({
-    required super.filament,
-    required super.frameController,
-    required super.collisionController,
-    required super.readinessController,
-  });
-
-  @override
-  State<_Flr0242InertSceneView> createState() => _Flr0242InertSceneViewState();
-}
-
-class _Flr0242InertSceneViewState
-    extends StatefulSceneViewState<_Flr0242InertSceneView> {
-  @override
-  void onCreate() {
-    print('FLR0242_GENERIC_INERT_ONCREATE');
-  }
-
-  @override
-  void onUpdateFrame(FilamentViewApi filament, double dt) {}
-
-  @override
-  void onTriggerEvent(String eventName, [dynamic eventData]) {}
-
-  @override
-  void onDestroy() {}
-
-  @override
-  Widget build(BuildContext context) => const SizedBox.shrink();
-}
-
