       _ => throw UnsupportedError("nothiiiing"),
     };
   }
@@ -272,7 +232,7 @@ class _MyAppState extends State<MyApp> {
             // Flutter widget painting.
             if (!kFlr0026DiagnosticMock3d) _filamentViewWidget,
 
