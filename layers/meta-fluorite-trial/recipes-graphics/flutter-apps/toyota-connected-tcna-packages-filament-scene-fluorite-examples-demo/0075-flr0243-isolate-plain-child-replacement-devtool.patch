+  final ValueNotifier<Widget?> _sceneViewNotifier = ValueNotifier<Widget?>(null);
 
   @override
   void initState() {
@@ -198,12 +163,7 @@ class _MyAppState extends State<MyApp> {
         collisionController: _collisionEventChannel,
         readinessController: _nativeReadiness,
       ),
-      5 => _Flr0242InertSceneView(
