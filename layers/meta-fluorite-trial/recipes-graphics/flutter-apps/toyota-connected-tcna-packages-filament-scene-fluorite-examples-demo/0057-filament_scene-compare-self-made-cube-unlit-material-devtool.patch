From a5e93a495261a94df5aee13901d69e3f4797fc94 Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Sun, 13 Sep 2026 01:02:01 +0000
Subject: [PATCH] diag: compare Dart fixture with unlit material

---
 .../example/lib/shape_and_object_creators.dart         | 10 +++-------
 1 file changed, 3 insertions(+), 7 deletions(-)

diff --git a/packages/filament_scene/example/lib/shape_and_object_creators.dart b/packages/filament_scene/example/lib/shape_and_object_creators.dart
index a5f5c9c..10e403e 100644
--- a/packages/filament_scene/example/lib/shape_and_object_creators.dart
+++ b/packages/filament_scene/example/lib/shape_and_object_creators.dart
@@ -43,13 +43,9 @@ List<Shape> poGetMinimal3dFixtureShapes() {
       // than a front-facing square.
       rotation: Quaternion.identity()..setEulerDegrees(25, 35, 0),
       name: 'flr0023_fixture_cube',
-      // Emit saturated blue so the native geometry is unmistakable even when
-      // indirect-light or texture sampling is unavailable in the test image.
-      material: poGetLitMaterial(
-        Colors.blue,
-        emissiveColor: Colors.blue,
-        emissiveIntensity: 1.0,
-      ),
+      // A/B: keep geometry, camera, and ViewTarget fixed while removing the
+      // lit-material path from this diagnostic fixture.
+      material: poGetUnlitMaterial(Colors.blue),
     ),
   ];
 }
