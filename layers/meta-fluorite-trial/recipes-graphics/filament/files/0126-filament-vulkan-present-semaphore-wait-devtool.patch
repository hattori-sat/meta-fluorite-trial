             .swapchainCount = 1,
             .pSwapchains = &mSwapchain,
             .pImageIndices = &currentIndex,
     };
+    std::fprintf(stderr, "FLR0026_VK_PRESENT_WAIT_SEMAPHORE enabled=%s\\n",
+            skipFinishedSemaphore ? "false" : "true");
     std::fprintf(stderr, "FLR0026_VK_QUEUE_PRESENT_BEGIN queue=%p swapchain=%p index=%u\\n",
             static_cast<void*>(mQueue), static_cast<void*>(mSwapchain), currentIndex);
     VkResult result = vkQueuePresentKHR(mQueue, &presentInfo);
