From 4c3a4f2220217ea6a76eba67b8de27b30c25e41d Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@localhost>
Date: Wed, 16 Sep 2026 02:27:51 +0900
Subject: [PATCH] diag: trace Vulkan readback ROI alpha

---
 filament/backend/src/vulkan/VulkanDriver.cpp | 59 +++++++++++++++++++-
 1 file changed, 58 insertions(+), 1 deletion(-)

diff --git a/filament/backend/src/vulkan/VulkanDriver.cpp b/filament/backend/src/vulkan/VulkanDriver.cpp
index 46104a95c..0bb2210b5 100644
--- a/filament/backend/src/vulkan/VulkanDriver.cpp
+++ b/filament/backend/src/vulkan/VulkanDriver.cpp
@@ -46,6 +46,7 @@
 #include <chrono>
 #include <cstdio>
 #include <cstdlib>
+#include <algorithm>
 
 using namespace bluevk;
 
@@ -86,6 +87,53 @@ size_t fluoriteTraceNonzeroBytes(const void* data, size_t size) noexcept {
     return nonzero;
 }
 
+struct FluoriteTraceRgbaStats {
+    size_t pixels = 0;
+    size_t nonzeroRgb = 0;
+    size_t nonzeroAlpha = 0;
+    size_t nonzeroRgbZeroAlpha = 0;
+    uint8_t alphaMin = 255;
+    uint8_t alphaMax = 0;
+};
+
+FluoriteTraceRgbaStats fluoriteTraceRgbaStats(const void* data, size_t size,
+        uint32_t width, uint32_t height, uint32_t left, uint32_t top,
+        uint32_t roiWidth, uint32_t roiHeight) noexcept {
+    FluoriteTraceRgbaStats stats;
+    if (data == nullptr || width == 0 || height == 0) {
+        return stats;
+    }
+    size_t const rowBytes = static_cast<size_t>(width) * 4;
+    if (rowBytes / 4 != static_cast<size_t>(width)) {
+        return stats;
+    }
+    uint32_t const right = std::min(width, left + roiWidth);
+    uint32_t const bottom = std::min(height, top + roiHeight);
+    if (left >= right || top >= bottom || rowBytes > size / height) {
+        return stats;
+    }
+    auto const* bytes = static_cast<uint8_t const*>(data);
+    for (uint32_t y = top; y < bottom; ++y) {
+        for (uint32_t x = left; x < right; ++x) {
+            size_t const offset = static_cast<size_t>(y) * rowBytes +
+                    static_cast<size_t>(x) * 4;
+            if (offset > size || size - offset < 4) {
+                return stats;
+            }
+            uint8_t const alpha = bytes[offset + 3];
+            bool const nonzeroRgb = bytes[offset] != 0 || bytes[offset + 1] != 0 ||
+                    bytes[offset + 2] != 0;
+            ++stats.pixels;
+            stats.nonzeroRgb += nonzeroRgb ? 1 : 0;
+            stats.nonzeroAlpha += alpha != 0 ? 1 : 0;
+            stats.nonzeroRgbZeroAlpha += nonzeroRgb && alpha == 0 ? 1 : 0;
+            stats.alphaMin = std::min(stats.alphaMin, alpha);
+            stats.alphaMax = std::max(stats.alphaMax, alpha);
+        }
+    }
+    return stats;
+}
+
 VmaAllocator createAllocator(VkInstance instance, VkPhysicalDevice physicalDevice,
         VkDevice device) {
     VmaAllocator allocator;
@@ -2057,14 +2105,23 @@ void VulkanDriver::readPixels(Handle<HwRenderTarget> src, uint32_t x, uint32_t y
             [&context = mContext](uint32_t types, VkFlags reqs) {
                 return context.selectMemoryType(types, reqs);
             },
-            [this](PixelBufferDescriptor&& pbd) {
+            [this, width, height](PixelBufferDescriptor&& pbd) {
                 if (std::getenv("FLUORITE_NATIVE_SWAPCHAIN_READBACK") != nullptr) {
+                    auto const roi = fluoriteTraceRgbaStats(
+                            pbd.buffer, pbd.size, width, height, 300, 250, 620, 400);
                     FVK_LOGI << "FLUORITE_NATIVE_SWAPCHAIN_READBACK_DRIVER_RESULT bytes="
                              << pbd.size
                              << " nonzero_bytes="
                              << fluoriteTraceNonzeroBytes(pbd.buffer, pbd.size)
                              << " checksum="
                              << fluoriteTraceChecksum(pbd.buffer, pbd.size);
+                    FVK_LOGI << "FLUORITE_NATIVE_SWAPCHAIN_READBACK_DRIVER_ROI "
+                             << "x=300 y=250 width=620 height=400 pixels=" << roi.pixels
+                             << " nonzero_rgb=" << roi.nonzeroRgb
+                             << " nonzero_alpha=" << roi.nonzeroAlpha
+                             << " nonzero_rgb_zero_alpha=" << roi.nonzeroRgbZeroAlpha
+                             << " alpha_min=" << static_cast<unsigned>(roi.alphaMin)
+                             << " alpha_max=" << static_cast<unsigned>(roi.alphaMax);
                 }
                 scheduleDestroy(std::move(pbd));
             });
