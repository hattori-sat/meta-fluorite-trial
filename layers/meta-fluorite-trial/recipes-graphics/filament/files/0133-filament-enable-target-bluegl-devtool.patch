Subject: [PATCH] fix: include BlueGL for target OpenGL builds

---
 CMakeLists.txt | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8afbded5d..423ba4bb0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -882,6 +882,10 @@ if (NOT IS_HOST_PLATFORM)
     add_subdirectory(${EXTERNAL}/tinyexr/tnt)
 endif()
 
+if (FILAMENT_SUPPORTS_OPENGL AND NOT IS_HOST_PLATFORM)
+    add_subdirectory(${LIBRARIES}/bluegl)
+endif()
+
 if (IS_HOST_PLATFORM)
     if (FILAMENT_SUPPORTS_OPENGL)
         add_subdirectory(${LIBRARIES}/bluegl)
