From 3e50ecaf5de4a53fbcf189fa087f062c02702b5c Mon Sep 17 00:00:00 2001
From: Codex Devtool <codex-devtool@localhost>
Date: Thu, 10 Sep 2026 11:24:33 +0900
Subject: [PATCH] diag: trace Vulkan output target and readback source

---
 filament/backend/src/vulkan/VulkanDriver.cpp  | 33 +++++++++++++++++++
 .../backend/src/vulkan/VulkanReadPixels.cpp   | 11 ++++++-
 2 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/filament/backend/src/vulkan/VulkanDriver.cpp b/filament/backend/src/vulkan/VulkanDriver.cpp
index 48e7306c6..44c7fe9ba 100644
--- a/filament/backend/src/vulkan/VulkanDriver.cpp
+++ b/filament/backend/src/vulkan/VulkanDriver.cpp
@@ -1763,6 +1763,17 @@ void VulkanDriver::beginRenderPass(Handle<HwRenderTarget> rth, const RenderPassP
         .params = params,
         .currentSubpass = 0,
     };
+
+    if (std::getenv("FLR0026_TARGET_TRACE") != nullptr) {
+        auto const& color = rt->getColor0();
+        FVK_LOGI << "FLR0026_TARGET_RENDER_PASS_BEGIN swapchain=" << rt->isSwapChain()
+                 << " extent=" << extent.width << "x" << extent.height
+                 << " framebuffer=" << vkfb
+                 << " color_image=" << color.getImage()
+                 << " color_view=" << fbkey.color[0]
+                 << " color_format=" << static_cast<int>(color.getFormat())
+                 << " color_layout=" << static_cast<int>(color.getLayout());
+    }
 }
 
 void VulkanDriver::endRenderPass(int) {
@@ -1893,6 +1904,18 @@ void VulkanDriver::readPixels(Handle<HwRenderTarget> src, uint32_t x, uint32_t y
         return;
     }
     auto srcTarget = resource_ptr<VulkanRenderTarget>::cast(&mResourceManager, src);
+    if (std::getenv("FLR0026_TARGET_TRACE") != nullptr) {
+        auto const& color = srcTarget->getColor0();
+        VkExtent2D const extent = srcTarget->getExtent();
+        FVK_LOGI << "FLR0026_TARGET_READBACK_BEGIN target_handle=" << src.getId()
+                 << " swapchain=" << srcTarget->isSwapChain()
+                 << " extent=" << extent.width << "x" << extent.height
+                 << " region=" << x << "," << y << " " << width << "x" << height
+                 << " color_image=" << color.getImage()
+                 << " color_view=" << color.getImageView()
+                 << " color_format=" << static_cast<int>(color.getFormat())
+                 << " color_layout=" << static_cast<int>(color.getLayout());
+    }
     endCommandRecording();
     FVK_LOGI << "FLR0026_VK_READBACK_DRIVER_COMMANDS_RECORDED";
     mReadPixels.run(
@@ -2291,6 +2314,16 @@ void VulkanDriver::draw(PipelineState state, Handle<HwRenderPrimitive> rph,
     auto rp = resource_ptr<VulkanRenderPrimitive>::cast(&mResourceManager, rph);
     state.primitiveType = rp->type;
     state.vertexBufferInfo = Handle<HwVertexBufferInfo>(rp->vertexBuffer->vbi.id());
+    if (std::getenv("FLR0026_TARGET_TRACE") != nullptr) {
+        auto const& color = mCurrentRenderPass.renderTarget->getColor0();
+        FVK_LOGI << "FLR0026_TARGET_DRAW primitive_handle=" << rph.getId()
+                 << " index_offset=" << indexOffset
+                 << " index_count=" << indexCount
+                 << " instances=" << instanceCount
+                 << " color_image=" << color.getImage()
+                 << " color_format=" << static_cast<int>(color.getFormat())
+                 << " color_layout=" << static_cast<int>(color.getLayout());
+    }
     bindPipeline(state);
     bindRenderPrimitive(rph);
     draw2(indexOffset, indexCount, instanceCount);
diff --git a/filament/backend/src/vulkan/VulkanReadPixels.cpp b/filament/backend/src/vulkan/VulkanReadPixels.cpp
index e59418542..fa76c9a49 100644
--- a/filament/backend/src/vulkan/VulkanReadPixels.cpp
+++ b/filament/backend/src/vulkan/VulkanReadPixels.cpp
@@ -28,7 +28,7 @@
 #include <algorithm>
 #include <cstring>
 #include <memory>
-
+#include <cstdlib>
 using namespace bluevk;
 
 namespace filament::backend {
@@ -155,6 +155,15 @@ void VulkanReadPixels::run(fvkmemory::resource_ptr<VulkanRenderTarget> srcTarget
     fvkmemory::resource_ptr<VulkanTexture> srcTexture = srcTarget->getColor0().texture;
     assert_invariant(srcTexture);
     VkFormat const srcFormat = srcTexture->getVkFormat();
+    if (std::getenv("FLR0026_TARGET_TRACE") != nullptr) {
+        VulkanAttachment& source = srcTarget->getColor0();
+        VkExtent2D const extent = source.getExtent2D();
+        FVK_LOGI << "FLR0026_TARGET_READBACK_SOURCE image=" << source.getImage()
+                 << " view=" << source.getImageView()
+                 << " format=" << static_cast<int>(source.getFormat())
+                 << " layout=" << static_cast<int>(source.getLayout())
+                 << " extent=" << extent.width << "x" << extent.height;
+    }
     bool const swizzle
             = srcFormat == VK_FORMAT_B8G8R8A8_UNORM || srcFormat == VK_FORMAT_B8G8R8A8_SRGB;
 
