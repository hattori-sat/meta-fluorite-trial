From a5fb01ef8f9f0fdc8306dbb921df251a64a38861 Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Fri, 11 Sep 2026 13:55:49 +0000
Subject: [PATCH] diag: trace Vulkan present call boundary

---
 .../backend/src/vulkan/VulkanSwapChain.cpp    | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/filament/backend/src/vulkan/VulkanSwapChain.cpp b/filament/backend/src/vulkan/VulkanSwapChain.cpp
index 81f34026a..f2bf29ba2 100644
--- a/filament/backend/src/vulkan/VulkanSwapChain.cpp
+++ b/filament/backend/src/vulkan/VulkanSwapChain.cpp
@@ -108,6 +108,11 @@ void VulkanSwapChain::update() {
 }
 
 void VulkanSwapChain::present(DriverBase& driver) {
+    const bool fluoritePresentTrace = std::getenv("FLUORITE_PRESENT_TRACE") != nullptr;
+    if (fluoritePresentTrace) {
+        std::fprintf(stderr, "FLUORITE_VK_PRESENT_ENTER index=%u headless=%s\n",
+                mCurrentSwapIndex, mHeadless ? "true" : "false");
+    }
     if (std::getenv("FLR0026_SYNC_TRACE") != nullptr) {
         std::fprintf(stderr, "FLR0026_VK_PRESENT_BOUNDARY_BEGIN index=%u\n",
                 mCurrentSwapIndex);
@@ -132,6 +137,10 @@ void VulkanSwapChain::present(DriverBase& driver) {
     const bool flushed = mCommands->flush();
     std::fprintf(stderr, "FLR0026_VK_SWAPCHAIN_FLUSH_DONE flushed=%s\\n",
             flushed ? "true" : "false");
+    if (fluoritePresentTrace) {
+        std::fprintf(stderr, "FLUORITE_VK_PRESENT_FLUSH_DONE flushed=%s\n",
+                flushed ? "true" : "false");
+    }
 
     // We only present if it is not headless. No-op for headless.
     if (!mHeadless) {
@@ -147,8 +156,16 @@ void VulkanSwapChain::present(DriverBase& driver) {
                     static_cast<int32_t>(fenceStatus),
                     static_cast<void*>(mCommands->getMostRecentFence()));
         }
+        if (fluoritePresentTrace) {
+            std::fprintf(stderr, "FLUORITE_VK_PRESENT_CALL_BEGIN index=%u semaphore=%p\n",
+                    mCurrentSwapIndex, static_cast<void*>(finishedDrawing->getVkSemaphore()));
+        }
         VkResult const result =
                 mPlatform->present(swapChain, mCurrentSwapIndex, finishedDrawing->getVkSemaphore());
+        if (fluoritePresentTrace) {
+            std::fprintf(stderr, "FLUORITE_VK_PRESENT_CALL_RETURN result=%d\n",
+                    static_cast<int32_t>(result));
+        }
         if (std::getenv("FLR0026_SYNC_TRACE") != nullptr) {
             std::fprintf(stderr, "FLR0026_VK_PRESENT_BOUNDARY_RETURN result=%d\n",
                     static_cast<int32_t>(result));
@@ -161,6 +178,9 @@ void VulkanSwapChain::present(DriverBase& driver) {
     if (std::getenv("FLR0026_SYNC_TRACE") != nullptr) {
         std::fprintf(stderr, "FLR0026_VK_PRESENT_BOUNDARY_DONE\n");
     }
+    if (fluoritePresentTrace) {
+        std::fprintf(stderr, "FLUORITE_VK_PRESENT_DONE\n");
+    }
     // We presented the last acquired buffer.
     mAcquired = false;
     mIsFirstRenderPass = true;
