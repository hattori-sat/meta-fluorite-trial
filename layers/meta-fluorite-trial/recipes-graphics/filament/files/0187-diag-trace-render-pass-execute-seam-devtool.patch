From 80b80ad89ea96fd6171b2e6c2a4a608ee92ed73b Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Fri, 11 Sep 2026 23:10:52 +0000
Subject: [PATCH] diag: trace render pass execute seam

---
 filament/src/RenderPass.cpp | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/filament/src/RenderPass.cpp b/filament/src/RenderPass.cpp
index 1ffa53c91..58533c6ed 100644
--- a/filament/src/RenderPass.cpp
+++ b/filament/src/RenderPass.cpp
@@ -50,6 +50,7 @@
 #include <utils/debug.h>
 
 #include <algorithm>
+#include <cstdio>
 #include <functional>
 #include <limits>
 #include <utility>
@@ -923,6 +924,13 @@ void RenderPass::Executor::execute(FEngine const& engine, DriverApi& driver,
     FILAMENT_TRACING_CALL(FILAMENT_TRACING_CATEGORY_FILAMENT);
     FILAMENT_TRACING_CONTEXT(FILAMENT_TRACING_CATEGORY_FILAMENT);
 
+    const bool fluoriteScenePassTrace = std::getenv("FLUORITE_SCENE_PASS_TRACE") != nullptr;
+    const size_t fluoriteScenePassCommandCount = static_cast<size_t>(last - first);
+    if (fluoriteScenePassTrace) {
+        std::fprintf(stderr, "FLUORITE_SCENE_PASS_EXECUTE_BEGIN commands=%zu\n",
+                fluoriteScenePassCommandCount);
+    }
+
     size_t const capacity = engine.getMinCommandBufferSize();
     CircularBuffer const& circularBuffer = driver.getCircularBuffer();
 
@@ -1134,6 +1142,11 @@ void RenderPass::Executor::execute(FEngine const& engine, DriverApi& driver,
             const_cast<FEngine&>(engine).flush();
         }
     }
+
+    if (fluoriteScenePassTrace) {
+        std::fprintf(stderr, "FLUORITE_SCENE_PASS_EXECUTE_END commands=%zu\n",
+                fluoriteScenePassCommandCount);
+    }
 }
 
