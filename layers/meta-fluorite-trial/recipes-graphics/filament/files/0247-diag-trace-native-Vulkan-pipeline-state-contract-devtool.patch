From d51670fd3d4fc4c7e2e5422b23d59bcffc4570bd Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Sun, 13 Sep 2026 22:02:49 +0000
Subject: [PATCH] diag: trace native Vulkan pipeline state contract

---
 filament/backend/src/vulkan/VulkanDriver.cpp | 67 ++++++++++++++++++++
 1 file changed, 67 insertions(+)

diff --git a/filament/backend/src/vulkan/VulkanDriver.cpp b/filament/backend/src/vulkan/VulkanDriver.cpp
index 7f611c3b5..9f5ee4c3f 100644
--- a/filament/backend/src/vulkan/VulkanDriver.cpp
+++ b/filament/backend/src/vulkan/VulkanDriver.cpp
@@ -1713,6 +1713,16 @@ void VulkanDriver::beginRenderPass(Handle<HwRenderTarget> rth, const RenderPassP
 
     rt->transformClientRectToPlatform(&renderPassInfo.renderArea);
 
+    if (std::getenv("FLR0026_PIPELINE_STATE_TRACE") != nullptr && rt->isSwapChain()) {
+        FVK_LOGI << "FLR0026_PIPELINE_STATE_RENDER_AREA swapchain=" << rt->isSwapChain()
+                 << " offset=" << renderPassInfo.renderArea.offset.x << ","
+                 << renderPassInfo.renderArea.offset.y
+                 << " extent=" << renderPassInfo.renderArea.extent.width << "x"
+                 << renderPassInfo.renderArea.extent.height;
+        FVK_LOGI << "FLR0026_PIPELINE_STATE_DEFAULT_SCISSOR extent="
+                 << scissor.extent.width << "x" << scissor.extent.height;
+    }
+
     VkClearValue clearValues[
             MRT::MAX_SUPPORTED_RENDER_TARGET_COUNT + MRT::MAX_SUPPORTED_RENDER_TARGET_COUNT +
             1] = {};
@@ -1756,6 +1766,17 @@ void VulkanDriver::beginRenderPass(Handle<HwRenderTarget> rth, const RenderPassP
     rt->transformViewportToPlatform(&viewport);
     vkCmdSetViewport(cmdbuffer, 0, 1, &viewport);
 
+    if (std::getenv("FLR0026_PIPELINE_STATE_TRACE") != nullptr && rt->isSwapChain()) {
+        FVK_LOGI << "FLR0026_PIPELINE_STATE_VIEWPORT_FILAMENT left="
+                 << params.viewport.left << " bottom=" << params.viewport.bottom
+                 << " width=" << params.viewport.width << " height=" << params.viewport.height
+                 << " depth=" << params.depthRange.near << "," << params.depthRange.far;
+        FVK_LOGI << "FLR0026_PIPELINE_STATE_VIEWPORT_VULKAN x=" << viewport.x
+                 << " y=" << viewport.y << " width=" << viewport.width
+                 << " height=" << viewport.height << " depth="
+                 << viewport.minDepth << "," << viewport.maxDepth;
+    }
+
     mCurrentRenderPass = {
         .commandBuffer = commandBuffer,
         .renderTarget = rt,
@@ -2252,6 +2273,44 @@ void VulkanDriver::bindPipelineImpl(PipelineState const& pipelineState,
     VkVertexInputAttributeDescription const* attribDesc = vbi->getAttribDescriptions();
     VkVertexInputBindingDescription const* bufferDesc =  vbi->getBufferDescriptions();
 
+    const bool tracePipelineState = std::getenv("FLR0026_PIPELINE_STATE_TRACE") != nullptr &&
+            rt && rt->isSwapChain();
+    if (tracePipelineState) {
+        FVK_LOGI << "FLR0026_PIPELINE_STATE_FILAMENT culling="
+                 << static_cast<int>(rasterState.culling)
+                 << " inverse_front_faces=" << rasterState.inverseFrontFaces
+                 << " color_write=" << rasterState.colorWrite
+                 << " depth_write=" << rasterState.depthWrite
+                 << " depth_func=" << static_cast<int>(rasterState.depthFunc)
+                 << " blending=" << rasterState.hasBlending()
+                 << " alpha_to_coverage=" << rasterState.alphaToCoverage;
+        FVK_LOGI << "FLR0026_PIPELINE_STATE_VULKAN cull_mode="
+                 << static_cast<unsigned>(vulkanRasterState.cullMode)
+                 << " front_face=" << static_cast<unsigned>(vulkanRasterState.frontFace)
+                 << " color_write_mask="
+                 << static_cast<unsigned>(vulkanRasterState.colorWriteMask)
+                 << " blend_enable=" << vulkanRasterState.blendEnable
+                 << " depth_write_enable=" << vulkanRasterState.depthWriteEnable
+                 << " depth_compare=" << static_cast<unsigned>(vulkanRasterState.depthCompareOp)
+                 << " samples=" << static_cast<unsigned>(vulkanRasterState.rasterizationSamples)
+                 << " color_targets=" << static_cast<unsigned>(vulkanRasterState.colorTargetCount)
+                 << " topology=" << static_cast<unsigned>(topology);
+        FVK_LOGI << "FLR0026_PIPELINE_STATE_PROGRAM vertex_shader="
+                 << (program->getVertexShader() != VK_NULL_HANDLE)
+                 << " fragment_shader=" << (program->getFragmentShader() != VK_NULL_HANDLE)
+                 << " layout=" << (pipelineLayout != VK_NULL_HANDLE)
+                 << " attributes=" << vbi->getAttributeCount();
+        if (vbi->getAttributeCount() > 0) {
+            FVK_LOGI << "FLR0026_PIPELINE_STATE_VERTEX_ATTRIB location="
+                     << attribDesc[0].location << " binding=" << attribDesc[0].binding
+                     << " format=" << static_cast<unsigned>(attribDesc[0].format)
+                     << " offset=" << attribDesc[0].offset
+                     << " buffer_binding=" << bufferDesc[0].binding
+                     << " stride=" << bufferDesc[0].stride
+                     << " input_rate=" << static_cast<unsigned>(bufferDesc[0].inputRate);
+        }
+    }
+
     // Push state changes to the VulkanPipelineCache instance. This is fast and does not make VK calls.
     mPipelineCache.bindProgram(program);
     mPipelineCache.bindRasterState(vulkanRasterState);
@@ -2438,6 +2497,14 @@ void VulkanDriver::scissor(Viewport scissorBox) {
 
     auto rt = mCurrentRenderPass.renderTarget;
     rt->transformClientRectToPlatform(&scissor);
+    if (std::getenv("FLR0026_PIPELINE_STATE_TRACE") != nullptr && rt->isSwapChain()) {
+        FVK_LOGI << "FLR0026_PIPELINE_STATE_SCISSOR_FILAMENT left=" << scissorBox.left
+                 << " bottom=" << scissorBox.bottom << " width=" << scissorBox.width
+                 << " height=" << scissorBox.height;
+        FVK_LOGI << "FLR0026_PIPELINE_STATE_SCISSOR_VULKAN offset="
+                 << scissor.offset.x << "," << scissor.offset.y
+                 << " extent=" << scissor.extent.width << "x" << scissor.extent.height;
+    }
     vkCmdSetScissor(cmdbuffer, 0, 1, &scissor);
 }
 
