     vkCreatePipelineLayout(mDevice, &info, VKALLOC, &layout);
+    if (tracePipeline) {
+        std::fprintf(stderr, "FLR0026_PIPELINE_LAYOUT_CREATE_DONE\n");
+    }
 
     mPipelineLayouts[key] = {
         .handle = layout,
