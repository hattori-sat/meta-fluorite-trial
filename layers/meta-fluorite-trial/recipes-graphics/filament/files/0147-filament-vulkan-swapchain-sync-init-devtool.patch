Subject: [PATCH] fix: initialize Vulkan surface swapchain sync state

---
 .../src/vulkan/platform/VulkanPlatformSwapChainImpl.h        | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/filament/backend/src/vulkan/platform/VulkanPlatformSwapChainImpl.h b/filament/backend/src/vulkan/platform/VulkanPlatformSwapChainImpl.h
index 88472c7c9..56d4308a4 100644
--- a/filament/backend/src/vulkan/platform/VulkanPlatformSwapChainImpl.h
+++ b/filament/backend/src/vulkan/platform/VulkanPlatformSwapChainImpl.h
@@ -121,12 +121,13 @@ private:
     VkSwapchainKHR mSwapchain = VK_NULL_HANDLE;
     VkExtent2D const mFallbackExtent;
     VkSemaphore mImageReady[IMAGE_READY_SEMAPHORE_COUNT];
-    uint32_t mCurrentImageReadyIndex;
+    // Start the semaphore ring so the first acquire uses slot zero.
+    uint32_t mCurrentImageReadyIndex = IMAGE_READY_SEMAPHORE_COUNT - 1;
 
     bool mUsesRGB = false;
     bool mHasStencil = false;
     bool mIsProtected = false;
-    bool mSuboptimal;
+    bool mSuboptimal = false;
 };
 
 struct VulkanPlatformHeadlessSwapChain : public VulkanPlatformSwapChainImpl {
