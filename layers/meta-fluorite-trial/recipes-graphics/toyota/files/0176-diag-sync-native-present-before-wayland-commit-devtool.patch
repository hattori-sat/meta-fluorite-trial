From a1ede54926cbe8bd97bacffa7c9dc875702f7651 Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Fri, 4 Sep 2026 15:56:10 +0000
Subject: [PATCH] diag: wait for native present before Wayland commit

---
 plugins/filament_view/core/scene/view_target.cc | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/plugins/filament_view/core/scene/view_target.cc b/plugins/filament_view/core/scene/view_target.cc
index 457f573..46cbb03 100644
--- a/plugins/filament_view/core/scene/view_target.cc
+++ b/plugins/filament_view/core/scene/view_target.cc
@@ -1413,6 +1413,18 @@ void ViewTarget::DrawFrame(const uint32_t time) {
       );
     }
     renderer->endFrame();
+    if (surface_ != nullptr &&
+        std::getenv("FLR0026_NATIVE_SYNC_PRESENT") != nullptr) {
+      spdlog::info("FLR0026_NATIVE_PRESENT_WAIT_BEGIN");
+      _engine->flushAndWait();
+      spdlog::info("FLR0026_NATIVE_PRESENT_WAIT_DONE complete=true");
+      wl_surface_commit(surface_);
+      const auto flushResult = wl_display_flush(display_);
+      spdlog::info(
+        "FLR0026_NATIVE_SYNC_SURFACE_COMMITTED result={}",
+        flushResult
+      );
+    }
     if (native_readback_probe_enabled_ && native_readback_probe_queued_ &&
         native_readback_fence_ == nullptr) {
       native_readback_fence_ = _engine->createFence();
