From 83599021b1db090ede5e827abfcefd3d6251c35a Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Tue, 15 Sep 2026 10:27:46 +0000
Subject: [PATCH] diag: trace ViewTarget C API bootstrap

---
 plugins/filament_view/filament_view_plugin_c_api.cc | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/plugins/filament_view/filament_view_plugin_c_api.cc b/plugins/filament_view/filament_view_plugin_c_api.cc
index a9f19d7..8de27f0 100644
--- a/plugins/filament_view/filament_view_plugin_c_api.cc
+++ b/plugins/filament_view/filament_view_plugin_c_api.cc
@@ -41,12 +41,17 @@ void FilamentViewPluginCApiRegisterWithRegistrar(
   const PlatformViewRemoveListener removeListener,
   void* platform_view_context
 ) {
+  spdlog::info("FLUORITE_VIEWTARGET_CAPI_REGISTER_ENTER");
   plugin_filament_view::FilamentViewPlugin::RegisterWithRegistrar(
     flutter::PluginRegistrarManager::GetInstance()->GetRegistrar<flutter::PluginRegistrar>(registrar
     ),
     id, viewType, direction, top, left, width, height, params, assetDirectory, engine, addListener,
     removeListener, platform_view_context
   );
+  spdlog::info(
+    "FLUORITE_VIEWTARGET_CAPI_REGISTER_RETURN state={}",
+    static_cast<int>(plugin_filament_view::ECSManager::GetRunState())
+  );
 
   // Uncomment if you want two views.
   /*plugin_filament_view::FilamentViewPlugin::RegisterWithRegistrar(
@@ -80,9 +85,11 @@ void FilamentViewPluginCApiRegisterWithRegistrar(
     std::promise<void> startupPromise;
     auto startupFuture = startupPromise.get_future();
     post(*ecs->getStrand(), [&viewTargetSystem, &startupPromise] {
+      spdlog::info("FLUORITE_VIEWTARGET_CAPI_DRAIN_BEGIN");
       spdlog::debug("== Starting ViewTargetSystem frame rendering loops ==");
 
       viewTargetSystem->ProcessMessages();
+      spdlog::info("FLUORITE_VIEWTARGET_CAPI_DRAIN_END");
       startupPromise.set_value();
     });
 
