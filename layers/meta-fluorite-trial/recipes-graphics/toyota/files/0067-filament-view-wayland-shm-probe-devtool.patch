     void setupWaylandSubsurface();
 
     FlutterDesktopEngineState* state_;
@@ -157,6 +159,12 @@ class ViewTarget {
     wl_surface* parent_surface_{};
     wl_callback* callback_;
     wl_subsurface* subsurface_{};
+    wl_shm* shm_probe_shm_{};
+    wl_shm_pool* shm_probe_pool_{};
+    wl_buffer* shm_probe_buffer_{};
+    void* shm_probe_data_{};
+    size_t shm_probe_size_{};
+    bool shm_probe_attached_{};
 
     struct _native_window {
         struct wl_display* display;
