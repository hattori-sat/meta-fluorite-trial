+  if (std::getenv("FLR0026_SCENE_VISIBILITY_TRACE") != nullptr && shouldLogFrame) {
+    const auto* const scene = filamentSystem->getFilamentScene();
+    const auto cameraEntity = fview_->getCamera().getEntity();
+    const auto viewport = fview_->getViewport();
+    spdlog::info(
+      "FLR0026_SCENE_VISIBILITY seq={} scene={} entities={} renderables={} lights={} "
+      "camera_entity={} viewport={}x{}",
+      frameSequence,
+      scene != nullptr,
+      scene != nullptr ? scene->getEntityCount() : 0u,
+      scene != nullptr ? scene->getRenderableCount() : 0u,
+      scene != nullptr ? scene->getLightCount() : 0u,
+      cameraEntity.getId(),
+      viewport.width,
+      viewport.height
+    );
+  }
+
   pollNativeReadbackFence();
 
   if (std::getenv("FLR0026_WAYLAND_ROUNDTRIP") != nullptr && display_ != nullptr) {
     const int roundtripResult = wl_display_roundtrip(display_);
     if (shouldLogFrame) {
