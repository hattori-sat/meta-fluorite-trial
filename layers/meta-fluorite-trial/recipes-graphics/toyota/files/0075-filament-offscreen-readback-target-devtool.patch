From 658189cc6f4aa2cf2121f8b72e225840542643e3 Mon Sep 17 00:00:00 2001
From: Codex Devtool <codex-devtool@localhost>
Date: Wed, 2 Sep 2026 12:21:28 +0000
Subject: [PATCH] diag: render fixture to offscreen readback target

---
 .../filament_view/core/scene/view_target.cc   | 161 ++++++++++++------
 .../filament_view/core/scene/view_target.h    |  12 ++
 2 files changed, 124 insertions(+), 49 deletions(-)

diff --git a/plugins/filament_view/core/scene/view_target.cc b/plugins/filament_view/core/scene/view_target.cc
index aa6cb5f..6eed397 100644
--- a/plugins/filament_view/core/scene/view_target.cc
+++ b/plugins/filament_view/core/scene/view_target.cc
@@ -29,0 +30 @@
+#include <filament/RenderTarget.h>
@@ -30,0 +32 @@
+#include <filament/Texture.h>
@@ -126,0 +129,9 @@ ViewTarget::~ViewTarget() {
+  if (native_readback_target_) {
+    _engine->destroy(native_readback_target_);
+    native_readback_target_ = nullptr;
+  }
+  if (native_readback_texture_) {
+    _engine->destroy(native_readback_texture_);
+    native_readback_texture_ = nullptr;
+  }
+
@@ -260,0 +272,31 @@ void ViewTarget::InitializeFilamentInternals(const uint32_t width, const uint32_
+  native_readback_probe_enabled_ =
+    std::getenv("FLR0026_NATIVE_READBACK_PROBE") != nullptr;
+  if (native_readback_probe_enabled_) {
+    constexpr uint32_t readbackWidth = 240;
+    constexpr uint32_t readbackHeight = 160;
+    native_readback_texture_ = filament::Texture::Builder()
+      .width(readbackWidth)
+      .height(readbackHeight)
+      .levels(1)
+      .format(filament::Texture::InternalFormat::RGBA8)
+      .usage(filament::Texture::Usage::COLOR_ATTACHMENT)
+      .build(*_engine);
+    if (native_readback_texture_ != nullptr) {
+      native_readback_target_ = filament::RenderTarget::Builder()
+        .texture(filament::RenderTarget::AttachmentPoint::COLOR, native_readback_texture_)
+        .build(*_engine);
+    }
+    if (native_readback_target_ != nullptr) {
+      fview_->setBlendMode(filament::View::BlendMode::OPAQUE);
+      fview_->setRenderTarget(native_readback_target_);
+      fview_->setViewport({0, 0, readbackWidth, readbackHeight});
+      spdlog::info(
+        "FLR0026_NATIVE_READBACK_TARGET_READY width={} height={}",
+        readbackWidth,
+        readbackHeight
+      );
+    } else {
+      spdlog::error("FLR0026_NATIVE_READBACK_TARGET_FAILED");
+    }
+  }
+
@@ -723,0 +766,4 @@ void ViewTarget::attachShmProbe() {
+  if (native_readback_probe_enabled_ &&
+      !shm_probe_content_ready_.load(std::memory_order_acquire)) {
+    return;
+  }
@@ -733,0 +780,37 @@ void ViewTarget::attachShmProbe() {
+void ViewTarget::OnNativeReadback(void* buffer, const size_t size, void* user) {
+  auto* const obj = static_cast<ViewTarget*>(user);
+  const auto* const bytes = static_cast<const uint8_t*>(buffer);
+  size_t nonBlackPixels = 0;
+  uint8_t maxChannel = 0;
+  for (size_t offset = 0; offset + 3 < size; offset += 4) {
+    const uint8_t red = bytes[offset];
+    const uint8_t green = bytes[offset + 1];
+    const uint8_t blue = bytes[offset + 2];
+    if (red != 0 || green != 0 || blue != 0) {
+      ++nonBlackPixels;
+    }
+    maxChannel = std::max(maxChannel, std::max(green, std::max(red, blue)));
+  }
+
+  if (obj->shm_probe_data_ != nullptr && size >= (240u * 160u * 4u)) {
+    auto* const destination = static_cast<uint32_t*>(obj->shm_probe_data_);
+    for (size_t index = 0; index < (240u * 160u); ++index) {
+      const size_t offset = index * 4u;
+      destination[index] = 0xFF000000u |
+        (static_cast<uint32_t>(bytes[offset + 2]) << 16u) |
+        (static_cast<uint32_t>(bytes[offset + 1]) << 8u) |
+        static_cast<uint32_t>(bytes[offset]);
+    }
+    obj->shm_probe_content_ready_.store(true, std::memory_order_release);
+  }
+
+  spdlog::info(
+    "FLR0026_NATIVE_READBACK_RESULT bytes={} nonblack={} max_channel={} shm_copy={}",
+    size,
+    nonBlackPixels,
+    static_cast<unsigned int>(maxChannel),
+    obj->shm_probe_data_ != nullptr
+  );
+  delete[] static_cast<uint8_t*>(buffer);
+}
+
@@ -831,10 +914,20 @@ void ViewTarget::DrawFrame(const uint32_t time) {
-    if (std::getenv("FLR0026_NATIVE_READBACK_PROBE") != nullptr) {
-      static bool readbackProbeQueued = false;
-      if (!readbackProbeQueued) {
-        readbackProbeQueued = true;
-        const uint32_t readbackWidth = native_window_.width;
-        const uint32_t readbackHeight = native_window_.height;
-        const size_t readbackSize = static_cast<size_t>(readbackWidth) *
-          static_cast<size_t>(readbackHeight) * 4u;
-        auto* pixels = new uint8_t[readbackSize]();
-        renderer->readPixels(
+    if (native_readback_probe_enabled_ && native_readback_target_ &&
+        !native_readback_probe_queued_) {
+      native_readback_probe_queued_ = true;
+      constexpr uint32_t readbackWidth = 240;
+      constexpr uint32_t readbackHeight = 160;
+      const size_t readbackSize = static_cast<size_t>(readbackWidth) *
+        static_cast<size_t>(readbackHeight) * 4u;
+      auto* pixels = new uint8_t[readbackSize]();
+      renderer->readPixels(
+        native_readback_target_,
+        0,
+        0,
+        readbackWidth,
+        readbackHeight,
+        filament::backend::PixelBufferDescriptor(
+          pixels,
+          readbackSize,
+          filament::backend::PixelBufferDescriptor::PixelDataFormat::RGBA,
+          filament::backend::PixelBufferDescriptor::PixelDataType::UBYTE,
+          1,
@@ -844,39 +937,9 @@ void ViewTarget::DrawFrame(const uint32_t time) {
-          readbackHeight,
-          filament::backend::PixelBufferDescriptor(
-            pixels,
-            readbackSize,
-            filament::backend::PixelBufferDescriptor::PixelDataFormat::RGBA,
-            filament::backend::PixelBufferDescriptor::PixelDataType::UBYTE,
-            1,
-            0,
-            0,
-            readbackWidth,
-            [](void* buffer, size_t size, void*) {
-              const auto* bytes = static_cast<const uint8_t*>(buffer);
-              size_t nonBlackPixels = 0;
-              uint8_t maxChannel = 0;
-              for (size_t offset = 0; offset + 3 < size; offset += 4) {
-                const uint8_t red = bytes[offset];
-                const uint8_t green = bytes[offset + 1];
-                const uint8_t blue = bytes[offset + 2];
-                if (red != 0 || green != 0 || blue != 0) {
-                  ++nonBlackPixels;
-                }
-                maxChannel = std::max(maxChannel, std::max(red, std::max(green, blue)));
-              }
-              spdlog::info(
-                "FLR0026_NATIVE_READBACK_RESULT bytes={} nonblack={} max_channel={}",
-                size,
-                nonBlackPixels,
-                static_cast<unsigned int>(maxChannel)
-              );
-              delete[] static_cast<uint8_t*>(buffer);
-            }
-          )
-        );
-        spdlog::info(
-          "FLR0026_NATIVE_READBACK_QUEUED width={} height={}",
-          readbackWidth,
-          readbackHeight
-        );
-      }
+          &ViewTarget::OnNativeReadback,
+          this
+        )
+      );
+      spdlog::info(
+        "FLR0026_NATIVE_READBACK_QUEUED width={} height={}",
+        readbackWidth,
+        readbackHeight
+      );
diff --git a/plugins/filament_view/core/scene/view_target.h b/plugins/filament_view/core/scene/view_target.h
index 45f6696..ea184a1 100644
--- a/plugins/filament_view/core/scene/view_target.h
+++ b/plugins/filament_view/core/scene/view_target.h
@@ -24,0 +25 @@
+#include <atomic>
@@ -31,0 +33,5 @@
+namespace filament {
+class RenderTarget;
+class Texture;
+}  // namespace filament
+
@@ -147,0 +154 @@ class ViewTarget {
+    static void OnNativeReadback(void* buffer, size_t size, void* user);
@@ -169,0 +177,3 @@ class ViewTarget {
+    std::atomic<bool> shm_probe_content_ready_{false};
+    bool native_readback_probe_enabled_{};
+    bool native_readback_probe_queued_{};
@@ -178,0 +189,2 @@ class ViewTarget {
+    ::filament::Texture* native_readback_texture_{};
+    ::filament::RenderTarget* native_readback_target_{};
-- 
2.34.1

