Subject: [PATCH] fix(filament-view): synchronize event callback map

---
 plugins/filament_view/filament_view_plugin.cc | 50 +++++++++++--------
 1 file changed, 30 insertions(+), 20 deletions(-)

diff --git a/plugins/filament_view/filament_view_plugin.cc b/plugins/filament_view/filament_view_plugin.cc
index d857464..9624d9f 100644
--- a/plugins/filament_view/filament_view_plugin.cc
+++ b/plugins/filament_view/filament_view_plugin.cc
@@ -20,6 +20,7 @@
 #include <atomic>
 #include <chrono>
 #include <cstdlib>
+#include <mutex>
 #include <core/components/derived/camera.h>
 #include <core/components/derived/transform.h>
 #include <core/scene/serialization/scene_text_deserializer.h>
@@ -187,6 +188,27 @@ void DeserializeDataAndSetupMessageChannels(
   animationSystem->setupMessageChannels(registrar, "plugin.filament_view.animation_info");
 }
 
+namespace {
+
+std::mutex eventCallbacksMutex;
+
+bool completeEventCallback(const int64_t eventId) {
+  std::shared_ptr<std::promise<void>> promise;
+  {
+    std::lock_guard<std::mutex> lock(eventCallbacksMutex);
+    auto it = FilamentViewPlugin::_eventCallbacks.find(eventId);
+    if (it == FilamentViewPlugin::_eventCallbacks.end()) {
+      return false;
+    }
+    promise = std::move(it->second);
+    FilamentViewPlugin::_eventCallbacks.erase(it);
+  }
+  promise->set_value();
+  return true;
+}
+
+}  // namespace
+
 std::future<void> FilamentViewPlugin::CallEvent(
   const std::string& eventName,
   std::initializer_list<std::pair<const char*, flutter::EncodableValue>> data
@@ -205,33 +227,24 @@ std::future<void> FilamentViewPlugin::CallEvent(
   auto promise = std::make_shared<std::promise<void>>();
   auto future = promise->get_future();
 
-  FilamentViewPlugin::_eventCallbacks[eventId] = std::move(promise);
+  {
+    std::lock_guard<std::mutex> lock(eventCallbacksMutex);
+    FilamentViewPlugin::_eventCallbacks[eventId] = std::move(promise);
+  }
 
   spdlog::trace("InvokeMethod: calling event {}", eventName);
   auto retval = std::make_unique<flutter::MethodResultFunctions<flutter::EncodableValue>>(  //
     [&, eventId](const auto* /*result*/) {
       spdlog::trace("[EventBus] Event completed successfully");
