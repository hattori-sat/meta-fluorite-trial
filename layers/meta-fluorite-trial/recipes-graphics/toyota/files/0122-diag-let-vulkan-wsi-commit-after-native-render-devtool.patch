From 0ef750af9562da2e2a5be78ce68740a68631319a Mon Sep 17 00:00:00 2001
From: Codex Devtool <codex-devtool@localhost>
Date: Thu, 3 Sep 2026 06:09:32 +0000
Subject: [PATCH] diag: let Vulkan WSI commit after native render

---
 plugins/filament_view/core/scene/view_target.cc | 8 --------
 1 file changed, 8 deletions(-)

diff --git a/plugins/filament_view/core/scene/view_target.cc b/plugins/filament_view/core/scene/view_target.cc
index 8d4a538..18083c5 100644
--- a/plugins/filament_view/core/scene/view_target.cc
+++ b/plugins/filament_view/core/scene/view_target.cc
@@ -1143,18 +1143,10 @@ void ViewTarget::DrawFrame(const uint32_t time) {
         readbackHeight
       );
     }
     // spdlog::debug("=== END FRAME ===");
     renderer->endFrame();
-    if (surface_ != nullptr && display_ != nullptr) {
-      wl_surface_commit(surface_);
-      const auto flushResult = wl_display_flush(display_);
-      spdlog::info(
-        "FLR0026_NATIVE_SURFACE_COMMITTED rendered=true result={}",
-        flushResult
-      );
-    }
     if (native_readback_probe_enabled_ && native_readback_probe_queued_ &&
         native_readback_fence_ == nullptr) {
       native_readback_fence_ = _engine->createFence();
       spdlog::info(
         "FLR0026_NATIVE_READBACK_FENCE_CREATED fence={}",
-- 
