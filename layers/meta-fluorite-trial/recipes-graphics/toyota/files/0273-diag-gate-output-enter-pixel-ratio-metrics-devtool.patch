From 9faf13d199e0b334c628f8f8c78c37416e546f6a Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Sun, 20 Sep 2026 07:01:28 +0000
Subject: [PATCH] FLR-0229: gate output-enter pixel ratio metrics

---
 shell/wayland/window.cc | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/shell/wayland/window.cc b/shell/wayland/window.cc
index 2cc7895..d77771d 100644
--- a/shell/wayland/window.cc
+++ b/shell/wayland/window.cc
@@ -244,6 +244,13 @@ void WaylandWindow::handle_base_surface_enter(void* data,
   const auto buffer_scale = GetEffectiveBufferScale(
       d->m_display, d->m_output_index, use_output_buffer_scale);
 
+  if (std::getenv("FLUORITE_DISABLE_OUTPUT_ENTER_METRICS") != nullptr) {
+    spdlog::info(
+        "FLUORITE_DISABLE_OUTPUT_ENTER_METRICS enabled=true "
+        "operation=skip_set_pixel_ratio");
+    return;
+  }
+
   const auto result =
       d->m_flutter_engine->SetPixelRatio(d->m_pixel_ratio * buffer_scale);
   if (result != kSuccess) {
