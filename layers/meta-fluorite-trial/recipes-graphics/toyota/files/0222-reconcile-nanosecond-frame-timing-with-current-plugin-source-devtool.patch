From 956b5e44f5d60cc65dccb764f3726aa432c84d82 Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Mon, 14 Sep 2026 23:07:17 +0000
Subject: [PATCH] fix: apply frame timing change on effective 0221 source

---
 plugins/filament_view/core/scene/view_target.cc | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/plugins/filament_view/core/scene/view_target.cc b/plugins/filament_view/core/scene/view_target.cc
index feca50f..8dbdd5a 100644
--- a/plugins/filament_view/core/scene/view_target.cc
+++ b/plugins/filament_view/core/scene/view_target.cc
@@ -36,6 +36,7 @@
 #include <filament/utils/EntityManager.h>
 
 #include <asio/post.hpp>
+#include <chrono>
 #include <flutter/encodable_value.h>
 #include <gltfio/Animator.h>
 #include <plugins/common/common.h>
@@ -598,7 +599,8 @@ void ViewTarget::DrawFrame(const uint32_t time) {
   // Render the scene, unless the renderer wants to skip the frame.
   const auto gpuDrawStart = std::chrono::steady_clock::now();
   // spdlog::debug("=== BEGIN FRAME ===");
-  if (renderer->beginFrame(fswapChain_, time)) {
+  if (renderer->beginFrame(
+        fswapChain_, std::chrono::steady_clock::now().time_since_epoch().count())) {
     // Frame is being rendered
     // TODO(kerberjg): send kPreRenderFrame event, async with wait
     // spdlog::debug("=== RENDER FRAME ===");
@@ -667,6 +669,12 @@ void ViewTarget::OnFrame(void* data, wl_callback* callback, const uint32_t time)
   // TODO: there's a 0.05ms lag when posting the task - SHOULDN'T HAPPEN!
   // NOTE: let's use separate strands for work and rendering?
   post(*ECSManager::GetInstance()->getStrand(), [data, obj, callback, time, promise] {
+    if (callback == nullptr) {
+      static uint32_t lastSoftwareFrameTime = static_cast<uint32_t>(-1);
+      if (lastSoftwareFrameTime == time) return;
+      lastSoftwareFrameTime = time;
+    }
+
     // spdlog::debug("[OnFrame] === (wl) callback start ===");
     obj->callback_ = nullptr;
 
