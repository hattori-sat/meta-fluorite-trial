From c0cc2ef239944e97b2e1af16815d0c64a808450d Mon Sep 17 00:00:00 2001
From: Codex Devtool <codex-devtool@localhost>
Date: Wed, 2 Sep 2026 13:43:43 +0000
Subject: [PATCH] fix: keep swapchain view for native readback

---
 .../filament_view/core/scene/view_target.cc   | 27 +++++++++++++------
 .../filament_view/core/scene/view_target.h    |  1 +
 2 files changed, 20 insertions(+), 8 deletions(-)

diff --git a/plugins/filament_view/core/scene/view_target.cc b/plugins/filament_view/core/scene/view_target.cc
index 9276755..54598ff 100644
--- a/plugins/filament_view/core/scene/view_target.cc
+++ b/plugins/filament_view/core/scene/view_target.cc
@@ -128,10 +128,14 @@ ViewTarget::~ViewTarget() {
   if (callback_) {
     wl_callback_destroy(callback_);
     callback_ = nullptr;
   }
 
+  if (native_readback_view_) {
+    _engine->destroy(native_readback_view_);
+    native_readback_view_ = nullptr;
+  }
   if (native_readback_target_) {
     _engine->destroy(native_readback_target_);
     native_readback_target_ = nullptr;
   }
   if (native_readback_texture_) {
@@ -290,17 +294,25 @@ void ViewTarget::InitializeFilamentInternals(const uint32_t width, const uint32_
       native_readback_target_ = filament::RenderTarget::Builder()
         .texture(filament::RenderTarget::AttachmentPoint::COLOR, native_readback_texture_)
         .build(*_engine);
     }
     if (native_readback_target_ != nullptr) {
-      fview_->setBlendMode(filament::View::BlendMode::OPAQUE);
-      fview_->setRenderTarget(native_readback_target_);
-      fview_->setViewport({0, 0, readbackWidth, readbackHeight});
+      native_readback_view_ = _engine->createView();
+      if (native_readback_view_ != nullptr) {
+        native_readback_view_->setScene(filamentSystem->getFilamentScene());
+        native_readback_view_->setVisibleLayers(0xff, 0xff);
+        native_readback_view_->setCamera(camera_);
+        native_readback_view_->setBlendMode(filament::View::BlendMode::OPAQUE);
+        native_readback_view_->setRenderTarget(native_readback_target_);
+        native_readback_view_->setViewport({0, 0, readbackWidth, readbackHeight});
+        native_readback_view_->setStencilBufferEnabled(false);
+      }
       spdlog::info(
-        "FLR0026_NATIVE_READBACK_TARGET_READY width={} height={}",
+        "FLR0026_NATIVE_READBACK_TARGET_READY width={} height={} view={}",
         readbackWidth,
-        readbackHeight
+        readbackHeight,
+        native_readback_view_ != nullptr
       );
     } else {
       spdlog::error("FLR0026_NATIVE_READBACK_TARGET_FAILED");
     }
   }
@@ -937,19 +949,19 @@ void ViewTarget::DrawFrame(const uint32_t time) {
     // TODO(kerberjg): send kPreRenderFrame event, async with wait
     // spdlog::debug("=== RENDER FRAME ===");
     renderer->render(fview_);
     // spdlog::debug("=== END FRAME ===");
     renderer->endFrame();
-    if (native_readback_probe_enabled_ && native_readback_target_ &&
+    if (native_readback_probe_enabled_ && native_readback_view_ && native_readback_target_ &&
         !native_readback_probe_queued_) {
       native_readback_probe_queued_ = true;
       constexpr uint32_t readbackWidth = 240;
       constexpr uint32_t readbackHeight = 160;
       const size_t readbackSize = static_cast<size_t>(readbackWidth) *
         static_cast<size_t>(readbackHeight) * 4u;
       auto* pixels = new uint8_t[readbackSize]();
-      renderer->renderStandaloneView(fview_);
+      renderer->renderStandaloneView(native_readback_view_);
       renderer->readPixels(
         native_readback_target_,
         0,
         0,
         readbackWidth,
@@ -965,11 +977,10 @@ void ViewTarget::DrawFrame(const uint32_t time) {
           readbackWidth,
           &ViewTarget::OnNativeReadback,
           this
         )
       );
-      _engine->flushAndWait();
       spdlog::info(
         "FLR0026_NATIVE_READBACK_QUEUED width={} height={}",
         readbackWidth,
         readbackHeight
       );
diff --git a/plugins/filament_view/core/scene/view_target.h b/plugins/filament_view/core/scene/view_target.h
index ac650d2..a28bf11 100644
--- a/plugins/filament_view/core/scene/view_target.h
+++ b/plugins/filament_view/core/scene/view_target.h
@@ -184,10 +184,11 @@ class ViewTarget {
         uint32_t width;
         uint32_t height;
     } native_window_{};
 
     ::filament::SwapChain* fswapChain_{};
+    ::filament::View* native_readback_view_{};
     ::filament::Texture* native_readback_texture_{};
     ::filament::RenderTarget* native_readback_target_{};
     std::mutex frameLock_;
     ::filament::View* fview_{};
 
-- 
2.34.1

