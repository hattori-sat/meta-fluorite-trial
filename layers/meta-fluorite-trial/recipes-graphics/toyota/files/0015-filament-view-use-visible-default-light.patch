From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fluorite Integration Role
Date: Mon, 17 Aug 2026 18:00:00 +0900
Subject: [PATCH] filament_view: use visible default light

Keep the fallback directional light at Filament's documented daylight-scale
intensity and use a valid daylight color temperature.  The previous 200 lux
override leaves lit diagnostic geometry effectively black.

---
 ivi-homescreen-plugins/plugins/filament_view/core/systems/derived/light_system.cc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/ivi-homescreen-plugins/plugins/filament_view/core/systems/derived/light_system.cc b/ivi-homescreen-plugins/plugins/filament_view/core/systems/derived/light_system.cc
--- a/ivi-homescreen-plugins/plugins/filament_view/core/systems/derived/light_system.cc
+++ b/ivi-homescreen-plugins/plugins/filament_view/core/systems/derived/light_system.cc
@@ -42,7 +42,8 @@ void LightSystem::vCreateDefaultLight() {
   const auto oLightComp = std::make_shared<Light>();
   ecs->addComponent(m_poDefaultLight->getGuid(), oLightComp);
 
-  oLightComp->setIntensity(200);
+  oLightComp->setColorTemperature(6500.0f);
+  oLightComp->setIntensity(100000.0f);
   oLightComp->setDirection({0, -1, 0});
   oLightComp->setPosition({0, 5, 0});
   oLightComp->setCastLight(true);
