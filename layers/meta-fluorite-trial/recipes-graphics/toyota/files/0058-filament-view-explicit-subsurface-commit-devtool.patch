From 9bae5b4a64368d08b8fd92601571481bd640f8dc Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Mon, 31 Aug 2026 05:57:58 +0000
Subject: [PATCH] diag: explicitly commit Filament subsurface

---
 plugins/filament_view/core/scene/view_target.cc | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/plugins/filament_view/core/scene/view_target.cc b/plugins/filament_view/core/scene/view_target.cc
index 5b45509..b9e331a 100644
--- a/plugins/filament_view/core/scene/view_target.cc
+++ b/plugins/filament_view/core/scene/view_target.cc
@@ -732,15 +732,20 @@ void ViewTarget::OnFrame(void* data, wl_callback* callback, const uint32_t time)
     }
     obj->DrawFrame(time);
 
+    // Filament's Vulkan present may attach the child buffer without committing
+    // the subsurface state. Commit the pending Wayland state explicitly so the
+    // native surface can become visible to the compositor.
+    if (obj->surface_ != nullptr) {
+      wl_surface_commit(obj->surface_);
+      spdlog::info("FLR0026_WAYLAND_SURFACE_COMMITTED committed=true");
+    }
+
     // Z-Order
     // These do not need <seem> to need to be called every frame.
     // wl_subsurface_place_below(obj->subsurface_, obj->parent_surface_);
     // spdlog::debug("=== (wl) subsurface position ===");
     // wl_subsurface_set_position(obj->subsurface_, obj->left_, obj->top_);
 
-    // spdlog::debug("=== (wl) surface commit ===");
-    // NOTE: DO NOT CALL wl_surface_commit, it already happens elsewhere
-
     // spdlog::debug("[OnFrame] === (wl) callback end ===");
     promise->set_value();
   });
