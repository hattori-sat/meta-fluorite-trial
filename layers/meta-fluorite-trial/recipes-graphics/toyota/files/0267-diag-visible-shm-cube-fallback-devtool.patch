+void ViewTarget::setupVisibleShmCube(const uint32_t width, const uint32_t height) {
+  if (std::getenv("FLUORITE_NATIVE_VISIBLE_SHM_CUBE") == nullptr ||
+      display_ == nullptr || parent_surface_ == nullptr || width == 0 || height == 0) {
+    return;
+  }
+
+  auto* registry = wl_display_get_registry(display_);
+  if (registry == nullptr) {
+    spdlog::error("FLUORITE_NATIVE_VISIBLE_SHM_CUBE registry_failed");
+    return;
+  }
+  VisibleShmRegistry registryState;
+  if (wl_registry_add_listener(registry, &visible_shm_registry_listener, &registryState) != 0 ||
+      wl_display_roundtrip(display_) < 0 || registryState.shm == nullptr) {
+    spdlog::error("FLUORITE_NATIVE_VISIBLE_SHM_CUBE registry_failed");
+    wl_registry_destroy(registry);
+    return;
+  }
+  wl_registry_destroy(registry);
+
+  constexpr uint32_t cubeWidth = 360;
+  constexpr uint32_t cubeHeight = 280;
+  const uint32_t left = width > cubeWidth ? (width - cubeWidth) / 2u : 0u;
+  const uint32_t top = height > cubeHeight ? (height - cubeHeight) / 2u : 0u;
+  const size_t stride = static_cast<size_t>(cubeWidth) * 4u;
+  const size_t size = stride * static_cast<size_t>(cubeHeight);
+  const char* const name = "/fluorite-visible-shm-cube";
+  const int fd = shm_open(name, O_CREAT | O_RDWR, 0600);
+  if (fd < 0) {
+    spdlog::error("FLUORITE_NATIVE_VISIBLE_SHM_CUBE shm_open_errno={}", errno);
+    wl_shm_destroy(registryState.shm);
+    return;
+  }
+  shm_unlink(name);
+  if (ftruncate(fd, static_cast<off_t>(size)) != 0) {
+    spdlog::error("FLUORITE_NATIVE_VISIBLE_SHM_CUBE ftruncate_errno={}", errno);
+    close(fd);
+    wl_shm_destroy(registryState.shm);
+    return;
+  }
+
+  void* data = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  if (data == MAP_FAILED) {
+    spdlog::error("FLUORITE_NATIVE_VISIBLE_SHM_CUBE mmap_errno={}", errno);
+    close(fd);
+    wl_shm_destroy(registryState.shm);
+    return;
+  }
+  drawVisibleShmCube(static_cast<uint32_t*>(data), cubeWidth, cubeHeight);
+
+  auto* pool = wl_shm_create_pool(registryState.shm, fd, static_cast<int32_t>(size));
+  close(fd);
+  if (pool == nullptr) {
+    spdlog::error("FLUORITE_NATIVE_VISIBLE_SHM_CUBE pool_failed");
+    munmap(data, size);
+    wl_shm_destroy(registryState.shm);
+    return;
+  }
+  auto* buffer = wl_shm_pool_create_buffer(
+    pool,
+    0,
+    static_cast<int32_t>(cubeWidth),
+    static_cast<int32_t>(cubeHeight),
+    static_cast<int32_t>(stride),
+    WL_SHM_FORMAT_XRGB8888
+  );
+  if (buffer == nullptr) {
+    spdlog::error("FLUORITE_NATIVE_VISIBLE_SHM_CUBE buffer_failed");
+    wl_shm_pool_destroy(pool);
+    munmap(data, size);
+    wl_shm_destroy(registryState.shm);
+    return;
+  }
+
+  auto* const compositor = state_->view_controller->view->GetDisplay()->GetCompositor();
+  auto* const subcompositor = state_->view_controller->view->GetDisplay()->GetSubCompositor();
+  auto* shmSurface = wl_compositor_create_surface(compositor);
+  auto* shmSubsurface = shmSurface == nullptr
+    ? nullptr
+    : wl_subcompositor_get_subsurface(subcompositor, shmSurface, parent_surface_);
+  if (shmSubsurface == nullptr) {
+    spdlog::error("FLUORITE_NATIVE_VISIBLE_SHM_CUBE child_surface_failed");
+    if (shmSurface != nullptr) wl_surface_destroy(shmSurface);
+    wl_buffer_destroy(buffer);
+    wl_shm_pool_destroy(pool);
+    munmap(data, size);
+    wl_shm_destroy(registryState.shm);
+    return;
+  }
+  wl_subsurface_set_position(shmSubsurface, left_ + left_, top_ + top_);
+  if (surface_ != nullptr) wl_subsurface_place_above(shmSubsurface, surface_);
+  else wl_subsurface_place_above(shmSubsurface, parent_surface_);
+  wl_subsurface_set_desync(shmSubsurface);
+
+  shm_ = registryState.shm;
+  shm_pool_ = pool;
+  shm_buffer_ = buffer;
+  shm_surface_ = shmSurface;
+  shm_subsurface_ = shmSubsurface;
+  shm_data_ = data;
+  shm_size_ = size;
+  wl_surface_attach(shm_surface_, shm_buffer_, 0, 0);
+  wl_surface_damage(shm_surface_, 0, 0, cubeWidth, cubeHeight);
+  wl_surface_commit(shm_surface_);
+  const int flushResult = wl_display_flush(display_);
+  spdlog::info(
+    "FLUORITE_NATIVE_VISIBLE_SHM_CUBE_READY width={} height={} object=cube", cubeWidth, cubeHeight
+  );
+  spdlog::info(
+    "FLUORITE_NATIVE_VISIBLE_SHM_CUBE_ATTACHED left={} top={} flush_result={}",
+    left_ + left,
+    top_ + top,
+    flushResult
+  );
+}
+
