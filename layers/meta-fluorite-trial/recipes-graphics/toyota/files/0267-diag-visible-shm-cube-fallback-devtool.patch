+struct VisibleShmPoint {
+  float x;
+  float y;
+};
+
+float visibleShmEdge(
+  const VisibleShmPoint& a,
+  const VisibleShmPoint& b,
+  const VisibleShmPoint& p
+) {
+  return (p.x - a.x) * (b.y - a.y) - (p.y - a.y) * (b.x - a.x);
+}
+
+void fillVisibleShmTriangle(
+  uint32_t* pixels,
+  const uint32_t width,
+  const uint32_t height,
+  const VisibleShmPoint& a,
+  const VisibleShmPoint& b,
+  const VisibleShmPoint& c,
+  const uint32_t color
+) {
+  const float area = visibleShmEdge(a, b, c);
+  if (area == 0.0f) return;
+
+  const int32_t minX = std::max(
+    0,
+    static_cast<int32_t>(std::min({a.x, b.x, c.x}))
+  );
+  const int32_t maxX = std::min(
+    static_cast<int32_t>(width) - 1,
+    static_cast<int32_t>(std::max({a.x, b.x, c.x}))
+  );
+  const int32_t minY = std::max(
+    0,
+    static_cast<int32_t>(std::min({a.y, b.y, c.y}))
+  );
+  const int32_t maxY = std::min(
+    static_cast<int32_t>(height) - 1,
+    static_cast<int32_t>(std::max({a.y, b.y, c.y}))
+  );
+  const bool positive = area > 0.0f;
+
+  for (int32_t y = minY; y <= maxY; ++y) {
+    for (int32_t x = minX; x <= maxX; ++x) {
+      const VisibleShmPoint p{static_cast<float>(x) + 0.5f, static_cast<float>(y) + 0.5f};
+      const float w0 = visibleShmEdge(b, c, p);
+      const float w1 = visibleShmEdge(c, a, p);
+      const float w2 = visibleShmEdge(a, b, p);
+      if ((positive && w0 >= 0.0f && w1 >= 0.0f && w2 >= 0.0f) ||
+          (!positive && w0 <= 0.0f && w1 <= 0.0f && w2 <= 0.0f)) {
+        pixels[static_cast<size_t>(y) * width + static_cast<size_t>(x)] = color;
+      }
+    }
+  }
+}
+
+void fillVisibleShmQuad(
+  uint32_t* pixels,
+  const uint32_t width,
+  const uint32_t height,
+  const VisibleShmPoint& a,
+  const VisibleShmPoint& b,
+  const VisibleShmPoint& c,
+  const VisibleShmPoint& d,
+  const uint32_t color
+) {
+  fillVisibleShmTriangle(pixels, width, height, a, b, c, color);
+  fillVisibleShmTriangle(pixels, width, height, a, c, d, color);
+}
+
+void drawVisibleShmCube(uint32_t* pixels, const uint32_t width, const uint32_t height) {
+  constexpr uint32_t background = 0xff101826u;
+  constexpr uint32_t topFace = 0xffd9e8ffu;
+  constexpr uint32_t leftFace = 0xff3f7ad6u;
+  constexpr uint32_t rightFace = 0xffd66a3fu;
+  for (size_t index = 0; index < static_cast<size_t>(width) * height; ++index) {
+    pixels[index] = background;
+  }
+
+  const float cx = static_cast<float>(width) * 0.5f;
+  const float cy = static_cast<float>(height) * 0.43f;
+  const float halfWidth = static_cast<float>(width) * 0.26f;
+  const float halfHeight = static_cast<float>(height) * 0.16f;
+  const float faceHeight = static_cast<float>(height) * 0.30f;
+  const VisibleShmPoint top{cx, cy - halfHeight};
+  const VisibleShmPoint right{cx + halfWidth, cy};
+  const VisibleShmPoint center{cx, cy + halfHeight};
+  const VisibleShmPoint left{cx - halfWidth, cy};
+  const VisibleShmPoint bottomLeft{left.x, left.y + faceHeight};
+  const VisibleShmPoint bottom{center.x, center.y + faceHeight};
+  const VisibleShmPoint bottomRight{right.x, right.y + faceHeight};
+  fillVisibleShmQuad(pixels, width, height, top, right, center, left, topFace);
+  fillVisibleShmQuad(pixels, width, height, left, center, bottom, bottomLeft, leftFace);
+  fillVisibleShmQuad(pixels, width, height, center, right, bottomRight, bottom, rightFace);
+}
+
+struct VisibleShmRegistry {
+  wl_shm* shm{};
+};
+
+void onVisibleShmGlobal(
+  void* data,
+  wl_registry* registry,
+  const uint32_t name,
+  const char* interface,
+  const uint32_t version
+) {
+  auto* state = static_cast<VisibleShmRegistry*>(data);
+  if (std::strcmp(interface, "wl_shm") == 0 && state->shm == nullptr) {
+    state->shm = static_cast<wl_shm*>(
+      wl_registry_bind(registry, name, &wl_shm_interface, std::min(version, 1u))
+    );
+  }
+}
+
+void onVisibleShmGlobalRemove(void*, wl_registry*, const uint32_t) {}
+
+const wl_registry_listener visible_shm_registry_listener = {
+  .global = onVisibleShmGlobal,
+  .global_remove = onVisibleShmGlobalRemove
+};
+
+}  // namespace
