@@ -910,18 +910,46 @@ void ViewTarget::DrawFrame(const uint32_t time) {
   // drawing a frame.
 
   // ECS Update
   const auto cpuUpdateStart = std::chrono::steady_clock::now();
   ecs->update(deltaTime);
+  double cpuFrametime = std::chrono::duration<double, std::milli>(
+                          std::chrono::steady_clock::now() - cpuUpdateStart
+  )
+                          .count();
+  // spdlog::debug(
+  //   "[{}] CPU frametime: {:.2f}ms", __FUNCTION__,
+  //   std::chrono::duration<double, std::milli>(cpuUpdateDuration).count()
+  // );
+
+  // TODO(kerberjg): send kUpdateFrame event, async with wait
+
+  // Render the scene, unless the renderer wants to skip the frame.
+  const auto gpuDrawStart = std::chrono::steady_clock::now();
+  // spdlog::debug("=== BEGIN FRAME ===");
+  const bool frameStarted = renderer->beginFrame(
+    fswapChain_, std::chrono::steady_clock::now().time_since_epoch().count()
+  );
+  if (shouldLogFrame) {
+    spdlog::info("FLR0026_FRAME_BEGIN seq={} started={}", frameSequence, frameStarted);
+  }
+  if (frameStarted) {
+    // Frame is being rendered
+    // TODO(kerberjg): send kPreRenderFrame event, async with wait
+    // spdlog::debug("=== RENDER FRAME ===");
+    renderer->render(fview_);
+    // spdlog::debug("=== END FRAME ===");
+    renderer->endFrame();
     if (native_readback_probe_enabled_ && native_readback_target_ &&
         !native_readback_probe_queued_) {
       native_readback_probe_queued_ = true;
       constexpr uint32_t readbackWidth = 240;
       constexpr uint32_t readbackHeight = 160;
       const size_t readbackSize = static_cast<size_t>(readbackWidth) *
         static_cast<size_t>(readbackHeight) * 4u;
       auto* pixels = new uint8_t[readbackSize]();
+      renderer->renderStandaloneView(fview_);
       renderer->readPixels(
         native_readback_target_,
         0,
         0,
         readbackWidth,
@@ -943,37 +971,10 @@ void ViewTarget::DrawFrame(const uint32_t time) {
         "FLR0026_NATIVE_READBACK_QUEUED width={} height={}",
         readbackWidth,
         readbackHeight
       );
     }
