       break;
     case WINDOW_PANEL_RIGHT:
-      m_display->AglShellDoPanel(m_base_surface, AGL_SHELL_EDGE_RIGHT, 0);
+      m_display->AglShellDoPanel(m_base_surface, AGL_SHELL_EDGE_RIGHT,
