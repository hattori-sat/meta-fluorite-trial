From f07de3aed637024867bcb705c6b57222617eaaa4 Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Fri, 4 Sep 2026 18:42:05 +0000
Subject: [PATCH] diag: isolate production environment stages

---
 .../scene/serialization/scene_text_deserializer.cc  | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/plugins/filament_view/core/scene/serialization/scene_text_deserializer.cc b/plugins/filament_view/core/scene/serialization/scene_text_deserializer.cc
index 0e459b4..197c2e3 100644
--- a/plugins/filament_view/core/scene/serialization/scene_text_deserializer.cc
+++ b/plugins/filament_view/core/scene/serialization/scene_text_deserializer.cc
@@ -217,15 +217,22 @@ void SceneTextDeserializer::RunPostSetupLoad() {
     spdlog::trace("setUpLoadingModels");
     setUpLoadingModels();
   }
-  if (std::getenv("FLR0026_NATIVE_SKIP_ENVIRONMENT") != nullptr) {
-    spdlog::info("FLR0026_NATIVE_SKIP_ENVIRONMENT enabled=true");
+  const bool skip_environment = std::getenv("FLR0026_NATIVE_SKIP_ENVIRONMENT") != nullptr;
+  const bool skip_skybox = skip_environment ||
+      std::getenv("FLR0026_NATIVE_SKIP_SKYBOX") != nullptr;
+  const bool skip_indirect_light = skip_environment ||
+      std::getenv("FLR0026_NATIVE_SKIP_INDIRECT_LIGHT") != nullptr;
+  if (skip_skybox) {
+    spdlog::info("FLR0026_NATIVE_SKIP_SKYBOX enabled=true");
   } else {
     spdlog::trace("setUpSkybox");
     setUpSkybox();
   }
   spdlog::trace("setUpLights");
   setUpLights();
-  if (std::getenv("FLR0026_NATIVE_SKIP_ENVIRONMENT") == nullptr) {
+  if (skip_indirect_light) {
+    spdlog::info("FLR0026_NATIVE_SKIP_INDIRECT_LIGHT enabled=true");
+  } else {
     spdlog::trace("setUpIndirectLight");
     setUpIndirectLight();
   }
