+////////////////////////////////////////////////////////////////////////////
+void ViewTarget::setupNativeMinimalGeometry() {
+  const auto filamentSystem = ECSManager::GetInstance()->getSystem<FilamentSystem>(__FUNCTION__);
+  const auto engine = filamentSystem->getFilamentEngine();
+
+  native_diagnostic_scene_ = engine->createScene();
+  if (!native_diagnostic_scene_) {
+    spdlog::error("FLUORITE_NATIVE_MINIMAL_GEOMETRY_SCENE_FAILED");
+    return;
+  }
+
+  using filament::IndexBuffer;
+  using filament::RenderableManager;
+  using filament::VertexAttribute;
+  using filament::VertexBuffer;
+  using filament::math::float3;
+
+  static constexpr float vertices[] = {
+    -1.0f, -1.0f, -1.0f,  1.0f, -1.0f, -1.0f,  1.0f,  1.0f, -1.0f,
+    -1.0f,  1.0f, -1.0f, -1.0f, -1.0f,  1.0f,  1.0f, -1.0f,  1.0f,
+     1.0f,  1.0f,  1.0f, -1.0f,  1.0f,  1.0f,
+  };
+  static constexpr uint16_t indices[] = {
+    0, 1, 2, 2, 3, 0, 1, 5, 6, 6, 2, 1, 5, 4, 7, 7, 6, 5,
+    4, 0, 3, 3, 7, 4, 3, 2, 6, 6, 7, 3, 4, 5, 1, 1, 0, 4,
+  };
+
+  native_diagnostic_vertex_buffer_ = VertexBuffer::Builder()
+    .vertexCount(8)
+    .bufferCount(1)
+    .attribute(VertexAttribute::POSITION, 0, VertexBuffer::AttributeType::FLOAT3)
+    .build(*engine);
+  native_diagnostic_index_buffer_ = IndexBuffer::Builder()
+    .indexCount(sizeof(indices) / sizeof(indices[0]))
+    .bufferType(IndexBuffer::IndexType::USHORT)
+    .build(*engine);
+  if (!native_diagnostic_vertex_buffer_ || !native_diagnostic_index_buffer_) {
+    spdlog::error("FLUORITE_NATIVE_MINIMAL_GEOMETRY_BUFFER_FAILED");
+    return;
+  }
+
+  native_diagnostic_vertex_buffer_->setBufferAt(
+    *engine,
+    0,
+    VertexBuffer::BufferDescriptor(vertices, sizeof(vertices))
+  );
+  native_diagnostic_index_buffer_->setBuffer(
+    *engine,
+    IndexBuffer::BufferDescriptor(indices, sizeof(indices))
+  );
+
+  filamat::MaterialBuilder::init();
+  filamat::MaterialBuilder materialBuilder;
+  materialBuilder
+    .name("fluorite_native_minimal_unlit")
+    .material(
+      "void material(inout MaterialInputs material) {"
+      "  prepareMaterial(material);"
+      "  material.baseColor = vec4(materialParams.color, 1.0);"
+      "}"
+    )
+    .parameter("color", filament::backend::UniformType::FLOAT3)
+    .shading(filamat::MaterialBuilder::Shading::UNLIT)
+    .targetApi(filamat::MaterialBuilder::TargetApi::ALL)
+    .platform(filamat::MaterialBuilder::Platform::ALL);
+  const auto package = materialBuilder.build(engine->getJobSystem());
+  native_diagnostic_material_ = filament::Material::Builder()
+    .package(package.getData(), package.getSize())
+    .build(*engine);
+  if (!native_diagnostic_material_) {
+    spdlog::error("FLUORITE_NATIVE_MINIMAL_GEOMETRY_MATERIAL_FAILED");
+    return;
+  }
+
+  native_diagnostic_material_->setDefaultParameter(
+    "color", filament::RgbType::LINEAR, float3{0.05f, 0.45f, 1.0f}
+  );
+  native_diagnostic_material_instance_ = native_diagnostic_material_->createInstance();
+  native_diagnostic_entity_ = engine->getEntityManager().create();
+  RenderableManager::Builder(1)
+    .boundingBox({{-1.0f, -1.0f, -1.0f}, {1.0f, 1.0f, 1.0f}})
+    .material(0, native_diagnostic_material_instance_)
+    .geometry(
+      0,
+      RenderableManager::PrimitiveType::TRIANGLES,
+      native_diagnostic_vertex_buffer_,
+      native_diagnostic_index_buffer_,
+      0,
+      sizeof(indices) / sizeof(indices[0])
+    )
+    .culling(false)
+    .receiveShadows(false)
+    .castShadows(false)
+    .build(*engine, native_diagnostic_entity_);
+  native_diagnostic_scene_->addEntity(native_diagnostic_entity_);
+  spdlog::info(
+    "FLUORITE_NATIVE_MINIMAL_GEOMETRY_READY vertices=8 indices={} scene=true",
+    sizeof(indices) / sizeof(indices[0])
+  );
+}
