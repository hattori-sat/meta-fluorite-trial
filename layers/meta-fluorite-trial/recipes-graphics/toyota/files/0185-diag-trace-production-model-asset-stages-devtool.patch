@@ -409,8 +410,20 @@ void ModelSystem::updateAsyncAssetLoading() {
   // load, then load that physics data onto a collider if required. This gives
   // us visuals without colliders in a scene with <tons> of objects; but would
   // eventually settle
+  const bool trace = std::getenv("FLR0026_MODEL_STAGE_TRACE") != nullptr;
+  static unsigned int updateSequence = 0;
+  static float previousProgress = -1.0f;
+  ++updateSequence;
+
   resourceLoader_->asyncUpdateLoad();
   const float percentComplete = resourceLoader_->asyncGetLoadProgress();
+  if (trace && (updateSequence <= 5 || percentComplete != previousProgress || updateSequence % 60 == 0)) {
+    spdlog::info(
+      "FLR0026_MODEL_STAGE_PROGRESS seq={} progress={} assets={}", updateSequence,
+      percentComplete, _assets.size()
+    );
+    previousProgress = percentComplete;
+  }
   if (percentComplete != 1.0f) {
     spdlog::trace("[{}] Model async loading progress: {}%", __FUNCTION__, percentComplete * 100.0f);
     return;
