From 6517bad883292fbc09410c136c7c49e16b0be012 Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Fri, 11 Sep 2026 19:46:03 +0000
Subject: [PATCH] diag: add neutral pure fixture control

---
 .../serialization/scene_text_deserializer.cc  | 26 ++++++++++++++-----
 1 file changed, 20 insertions(+), 6 deletions(-)

diff --git a/plugins/filament_view/core/scene/serialization/scene_text_deserializer.cc b/plugins/filament_view/core/scene/serialization/scene_text_deserializer.cc
index 470dba4..aa00d37 100644
--- a/plugins/filament_view/core/scene/serialization/scene_text_deserializer.cc
+++ b/plugins/filament_view/core/scene/serialization/scene_text_deserializer.cc
@@ -197,15 +197,29 @@ void SceneTextDeserializer::DeserializeSceneLevel(const flutter::EncodableValue&
 void SceneTextDeserializer::RunPostSetupLoad() {
   spdlog::debug("Running post setup load...");
 
-  if (std::getenv("FLR0026_NATIVE_PURE_FIXTURE") != nullptr) {
-    spdlog::info(
-      "FLR0026_NATIVE_PURE_FIXTURE enabled=true models={} shapes={} lights={}",
-      models_.size(), shapes_.size(), lights_.size()
-    );
+  const bool neutralPureFixture =
+    std::getenv("FLUORITE_NATIVE_PURE_FIXTURE") != nullptr;
+  if (neutralPureFixture ||
+      std::getenv("FLR0026_NATIVE_PURE_FIXTURE") != nullptr) {
+    if (neutralPureFixture) {
+      spdlog::info(
+        "FLUORITE_NATIVE_PURE_FIXTURE enabled=true models={} shapes={} lights={}",
+        models_.size(), shapes_.size(), lights_.size()
+      );
+    } else {
+      spdlog::info(
+        "FLR0026_NATIVE_PURE_FIXTURE enabled=true models={} shapes={} lights={}",
+        models_.size(), shapes_.size(), lights_.size()
+      );
+    }
     // Keep camera entities available to ViewTarget, but do not enqueue any
     // production GPU resources while the native fixture is being isolated.
     setUpEntities();
-    spdlog::info("FLR0026_NATIVE_PURE_FIXTURE_SETUP_DONE");
+    if (neutralPureFixture) {
+      spdlog::info("FLUORITE_NATIVE_PURE_FIXTURE_SETUP_DONE");
+    } else {
+      spdlog::info("FLR0026_NATIVE_PURE_FIXTURE_SETUP_DONE");
+    }
     return;
   }
 
