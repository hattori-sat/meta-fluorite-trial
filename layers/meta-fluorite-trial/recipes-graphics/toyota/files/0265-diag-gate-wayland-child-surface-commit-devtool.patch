From 53b30058270a397abd6245cae96ad7aa383f4bd1 Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Sat, 19 Sep 2026 13:34:08 +0000
Subject: [PATCH] diag: gate Wayland child surface commit

---
 plugins/filament_view/core/scene/view_target.cc | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/plugins/filament_view/core/scene/view_target.cc b/plugins/filament_view/core/scene/view_target.cc
index 804bcf788..1b5f2ade6 100644
--- a/plugins/filament_view/core/scene/view_target.cc
+++ b/plugins/filament_view/core/scene/view_target.cc
@@ -934,6 +934,16 @@ void ViewTarget::DrawFrame(const uint32_t time) {
     }
     // spdlog::debug("=== END FRAME ===");
     renderer->endFrame();
+    const bool forceWaylandCommit =
+      std::getenv("FLUORITE_NATIVE_WAYLAND_COMMIT") != nullptr;
+    if (forceWaylandCommit && surface_ != nullptr && display_ != nullptr) {
+      wl_surface_commit(surface_);
+      const auto flushResult = wl_display_flush(display_);
+      spdlog::info(
+        "FLUORITE_NATIVE_WAYLAND_COMMIT enabled=true result={}",
+        flushResult
+      );
+    }
     if (traceFrameBoundary) {
       spdlog::info("FLUORITE_VIEWTARGET_END_FRAME");
     }
