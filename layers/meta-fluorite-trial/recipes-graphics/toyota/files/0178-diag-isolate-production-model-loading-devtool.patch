+++ b/plugins/filament_view/core/scene/serialization/scene_text_deserializer.cc
@@ -208,8 +208,15 @@ void SceneTextDeserializer::RunPostSetupLoad() {
     return;
   }
 
-  spdlog::trace("setUpLoadingModels");
-  setUpLoadingModels();
+  if (std::getenv("FLR0026_NATIVE_SKIP_MODEL_LOAD") != nullptr) {
+    spdlog::info(
+      "FLR0026_NATIVE_SKIP_MODEL_LOAD enabled=true models={} shapes={} lights={}",
+      models_.size(), shapes_.size(), lights_.size()
+    );
+  } else {
+    spdlog::trace("setUpLoadingModels");
+    setUpLoadingModels();
+  }
   spdlog::trace("setUpSkybox");
   setUpSkybox();
   spdlog::trace("setUpLights");
