Subject: [PATCH] FLR-0285: test production model in diagnostic scene

---
 .../filament_view/core/scene/view_target.cc   | 25 ++++++++++++++-
 .../core/systems/derived/model_system.cc      | 31 +++++++++++++++++++
 .../core/systems/derived/model_system.h       |  6 ++++
 3 files changed, 61 insertions(+), 1 deletion(-)

diff --git a/plugins/filament_view/core/scene/view_target.cc b/plugins/filament_view/core/scene/view_target.cc
index dc0077b..df48ab4 100644
--- a/plugins/filament_view/core/scene/view_target.cc
+++ b/plugins/filament_view/core/scene/view_target.cc
@@ -19,6 +19,7 @@
 #include <core/include/additionalmath.h>
 #include <core/include/literals.h>
 #include <core/systems/derived/filament_system.h>
+#include <core/systems/derived/model_system.h>
 #include <core/systems/derived/transform_system.h>
 #include <core/systems/derived/view_target_system.h>
 #include <core/systems/ecs.h>
@@ -795,7 +796,10 @@ void ViewTarget::setupView(uint32_t width, uint32_t height) {
     spdlog::info("FLUORITE_NATIVE_FORCE_OPAQUE enabled=true");
   }
 
-  if (std::getenv("FLUORITE_NATIVE_MINIMAL_GEOMETRY") != nullptr) {
+  const bool useNativeDiagnosticScene =
+    std::getenv("FLUORITE_NATIVE_MINIMAL_GEOMETRY") != nullptr ||
+    std::getenv("FLR0285_NATIVE_MODEL_SCENE") != nullptr;
+  if (useNativeDiagnosticScene) {
     setupNativeMinimalGeometry();
     if (native_diagnostic_scene_) {
       fview_->setScene(native_diagnostic_scene_);
@@ -1425,6 +1429,25 @@ void ViewTarget::DrawFrame(const uint32_t time) {
     );
   }
 
+  const char* nativeModelScene = std::getenv("FLR0285_NATIVE_MODEL_SCENE");
+  if (nativeModelScene != nullptr && std::strcmp(nativeModelScene, "diagnostic") == 0 &&
+      native_diagnostic_scene_ != nullptr) {
+    const auto modelSystem = ecs->getSystem<ModelSystem>("DrawFrame");
+    modelSystem->addLoadedModelsToScene(native_diagnostic_scene_);
+    const auto defaultScene = filamentSystem->getFilamentScene();
+    native_diagnostic_scene_->setSkybox(defaultScene->getSkybox());
+    native_diagnostic_scene_->setIndirectLight(defaultScene->getIndirectLight());
+    fview_->setScene(native_diagnostic_scene_);
+    fview_->setBlendMode(filament::View::BlendMode::OPAQUE);
+    if (traceFrameBoundary) {
+      spdlog::info(
+        "FLR0285_NATIVE_MODEL_SCENE_ACTIVE scene=diagnostic skybox={} indirect_light={}",
+        native_diagnostic_scene_->getSkybox() != nullptr,
+        native_diagnostic_scene_->getIndirectLight() != nullptr
+      );
+    }
+  }
+
   // spdlog::debug(
   //   "[{}] CPU frametime: {:.2f}ms", __FUNCTION__,
   //   std::chrono::duration<double, std::milli>(cpuUpdateDuration).count()
diff --git a/plugins/filament_view/core/systems/derived/model_system.cc b/plugins/filament_view/core/systems/derived/model_system.cc
index 3f623e0..cdbb616 100644
--- a/plugins/filament_view/core/systems/derived/model_system.cc
+++ b/plugins/filament_view/core/systems/derived/model_system.cc
@@ -66,6 +66,37 @@ void ModelSystem::destroyAsset(const filament::gltfio::FilamentAsset* asset) con
   assetLoader_->destroyAsset(asset);
 }
 
+void ModelSystem::addLoadedModelsToScene(::filament::Scene* scene) {
+  if (scene == nullptr || diagnostic_scene_models_added_) {
+    return;
+  }
+
+  size_t modelCount = 0;
+  size_t entityCount = 0;
+  for (const auto& [guid, model] : _models) {
+    (void) guid;
+    if (model == nullptr || !model->isInScene()) {
+      continue;
+    }
+    const auto* assetInstance = model->getAssetInstance();
+    if (assetInstance == nullptr || assetInstance->getEntityCount() == 0) {
+      continue;
+    }
+    scene->addEntities(assetInstance->getEntities(), assetInstance->getEntityCount());
+    ++modelCount;
+    entityCount += assetInstance->getEntityCount();
+  }
+
+  if (modelCount != 0) {
+    diagnostic_scene_models_added_ = true;
+    spdlog::info(
+      "FLR0285_NATIVE_MODEL_SCENE_ADDED models={} entities={} scene=diagnostic",
+      modelCount,
+      entityCount
+    );
+  }
+}
+
 void ModelSystem::createModelInstance(Model* model) {
   assertInitialized();
   debug_assert(assetLoader_ != nullptr, "ModelSystem::createModelInstance - assetLoader_ is null");
diff --git a/plugins/filament_view/core/systems/derived/model_system.h b/plugins/filament_view/core/systems/derived/model_system.h
