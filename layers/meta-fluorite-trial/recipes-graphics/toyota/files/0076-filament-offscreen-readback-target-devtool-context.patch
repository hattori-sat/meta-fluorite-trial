@@ -738,20 +779,61 @@ void ViewTarget::setupShmProbe(const uint32_t width, const uint32_t height) {
 
 void ViewTarget::attachShmProbe() {
   if (shm_probe_attached_ || shm_probe_buffer_ == nullptr || shm_probe_surface_ == nullptr) {
     return;
   }
+  if (native_readback_probe_enabled_ &&
+      !shm_probe_content_ready_.load(std::memory_order_acquire)) {
+    return;
+  }
   wl_surface_attach(shm_probe_surface_, shm_probe_buffer_, 0, 0);
   wl_surface_damage(shm_probe_surface_, 0, 0, 240, 160);
   wl_surface_commit(shm_probe_surface_);
   const int flush_result = wl_display_flush(display_);
   shm_probe_attached_ = true;
   spdlog::info(
     "FLR0026_WAYLAND_SHM_PROBE_ATTACHED flush_result={}", flush_result
   );
 }
 
+void ViewTarget::OnNativeReadback(void* buffer, const size_t size, void* user) {
+  auto* const obj = static_cast<ViewTarget*>(user);
+  const auto* const bytes = static_cast<const uint8_t*>(buffer);
+  size_t nonBlackPixels = 0;
+  uint8_t maxChannel = 0;
+  for (size_t offset = 0; offset + 3 < size; offset += 4) {
+    const uint8_t red = bytes[offset];
+    const uint8_t green = bytes[offset + 1];
+    const uint8_t blue = bytes[offset + 2];
+    if (red != 0 || green != 0 || blue != 0) {
+      ++nonBlackPixels;
+    }
+    maxChannel = std::max(maxChannel, std::max(green, std::max(red, blue)));
+  }
+
+  if (obj->shm_probe_data_ != nullptr && size >= (240u * 160u * 4u)) {
+    auto* const destination = static_cast<uint32_t*>(obj->shm_probe_data_);
+    for (size_t index = 0; index < (240u * 160u); ++index) {
+      const size_t offset = index * 4u;
+      destination[index] = 0xFF000000u |
+        (static_cast<uint32_t>(bytes[offset + 2]) << 16u) |
+        (static_cast<uint32_t>(bytes[offset + 1]) << 8u) |
+        static_cast<uint32_t>(bytes[offset]);
+    }
+    obj->shm_probe_content_ready_.store(true, std::memory_order_release);
+  }
+
+  spdlog::info(
+    "FLR0026_NATIVE_READBACK_RESULT bytes={} nonblack={} max_channel={} shm_copy={}",
+    size,
+    nonBlackPixels,
+    static_cast<unsigned int>(maxChannel),
+    obj->shm_probe_data_ != nullptr
+  );
+  delete[] static_cast<uint8_t*>(buffer);
+}
