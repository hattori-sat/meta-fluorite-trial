Subject: [PATCH] diag: roundtrip wayland before frame

---
 plugins/filament_view/core/scene/view_target.cc | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/plugins/filament_view/core/scene/view_target.cc b/plugins/filament_view/core/scene/view_target.cc
index df96fc7..dcfc108 100644
--- a/plugins/filament_view/core/scene/view_target.cc
+++ b/plugins/filament_view/core/scene/view_target.cc
@@ -928,6 +928,17 @@ void ViewTarget::DrawFrame(const uint32_t time) {
 
   pollNativeReadbackFence();
 
+  if (std::getenv("FLR0026_WAYLAND_ROUNDTRIP") != nullptr && display_ != nullptr) {
+    const int roundtripResult = wl_display_roundtrip(display_);
+    if (shouldLogFrame) {
+      spdlog::info(
+        "FLR0026_WAYLAND_ROUNDTRIP result={} seq={}",
+        roundtripResult,
+        frameSequence
+      );
+    }
+  }
+
   if (std::getenv("FLR0026_WAYLAND_DISPATCH_PENDING") != nullptr && display_ != nullptr) {
     wl_display_dispatch_pending(display_);
     if (shouldLogFrame) {
