Subject: [PATCH] FLR-0266: trace readback SHM ownership

---
 .../filament_view/core/scene/view_target.cc   | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/plugins/filament_view/core/scene/view_target.cc b/plugins/filament_view/core/scene/view_target.cc
index 7eee7ae..deccb78 100644
--- a/plugins/filament_view/core/scene/view_target.cc
+++ b/plugins/filament_view/core/scene/view_target.cc
@@ -546,6 +546,13 @@ void ViewTarget::setupVisibleShmCube(const uint32_t width, const uint32_t height
   shm_subsurface_ = shmSubsurface;
   shm_data_ = data;
   shm_size_ = size;
+  const auto setupThreadId = std::hash<std::thread::id>{}(std::this_thread::get_id());
+  spdlog::info(
+    "FLUORITE_NATIVE_READBACK_SHM_SETUP thread_id={} surface={} buffer={}",
+    setupThreadId,
+    static_cast<void*>(shm_surface_),
+    static_cast<void*>(shm_buffer_)
+  );
   wl_surface_attach(shm_surface_, shm_buffer_, 0, 0);
   wl_surface_damage(shm_surface_, 0, 0, cubeWidth, cubeHeight);
   wl_surface_commit(shm_surface_);
@@ -581,6 +588,13 @@ void ViewTarget::publishReadbackToVisibleShm(
 
   const uint32_t sourceLeft = (width - outputWidth) / 2u;
   const uint32_t sourceTop = (height - outputHeight) / 2u;
+  const auto publishThreadId = std::hash<std::thread::id>{}(std::this_thread::get_id());
+  spdlog::info(
+    "FLUORITE_NATIVE_READBACK_SHM_PUBLISH_BEGIN thread_id={} surface={} buffer={}",
+    publishThreadId,
+    static_cast<void*>(shm_surface_),
+    static_cast<void*>(shm_buffer_)
+  );
   auto* const destination = static_cast<uint8_t*>(shm_data_);
   size_t nonzeroPixels = 0;
   size_t chromaticPixels = 0;
@@ -1292,6 +1306,11 @@ void ViewTarget::DrawFrame(const uint32_t time) {
             static_cast<unsigned>(maxByte),
             bytes == nullptr
           );
+          spdlog::info(
+            "FLUORITE_NATIVE_READBACK_CALLBACK thread_id={} target={}",
+            std::hash<std::thread::id>{}(std::this_thread::get_id()),
+            static_cast<void*>(context->target)
+          );
           if (bytes != nullptr && context->target != nullptr &&
               std::getenv("FLUORITE_NATIVE_READBACK_TO_SHM") != nullptr) {
             context->target->publishReadbackToVisibleShm(
