From 7efcfbb155d335a68ae956e5b6622403b19f2144 Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Fri, 4 Sep 2026 11:16:10 +0000
Subject: [PATCH] diag: render native view without scene content

---
 plugins/filament_view/core/scene/view_target.cc | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/plugins/filament_view/core/scene/view_target.cc b/plugins/filament_view/core/scene/view_target.cc
index ffed61e..b830599 100644
--- a/plugins/filament_view/core/scene/view_target.cc
+++ b/plugins/filament_view/core/scene/view_target.cc
@@ -1118,8 +1118,14 @@ void ViewTarget::DrawFrame(const uint32_t time) {
     // TODO(kerberjg): send kPreRenderFrame event, async with wait
     // spdlog::debug("=== RENDER FRAME ===");
     const bool skipSceneRender = std::getenv("FLR0026_NATIVE_SKIP_SCENE_RENDER") != nullptr;
+    const bool skipSceneContent = std::getenv("FLR0026_NATIVE_SKIP_SCENE_CONTENT") != nullptr;
     if (skipSceneRender) {
       spdlog::info("FLR0026_NATIVE_SKIP_SCENE_RENDER enabled=true");
+    } else if (skipSceneContent) {
+      fview_->setScene(nullptr);
+      spdlog::info("FLR0026_NATIVE_SKIP_SCENE_CONTENT enabled=true");
+      renderer->render(fview_);
+      fview_->setScene(filamentSystem->getFilamentScene());
     } else {
       renderer->render(fview_);
     }
-- 
