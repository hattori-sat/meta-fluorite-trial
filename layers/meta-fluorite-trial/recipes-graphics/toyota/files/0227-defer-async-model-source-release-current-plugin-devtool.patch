From 41e1026d51bd2dad868ec4bf696d4f38d97a5f79 Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Tue, 15 Sep 2026 04:09:48 +0000
Subject: [PATCH] fix: defer async model source release on effective baseline

---
 .../core/systems/derived/model_system.cc      | 21 ++++++++++++-------
 1 file changed, 13 insertions(+), 8 deletions(-)

diff --git a/plugins/filament_view/core/systems/derived/model_system.cc b/plugins/filament_view/core/systems/derived/model_system.cc
index 8678282..bab9cbe 100644
--- a/plugins/filament_view/core/systems/derived/model_system.cc
+++ b/plugins/filament_view/core/systems/derived/model_system.cc
@@ -429,15 +429,24 @@ void ModelSystem::updateAsyncAssetLoading() {
     }
 
     if (assetData.state == AssetLoadingState::loaded) {
+      // Keep source data alive until async resource loading and scene insertion
+      // have completed. Non-instanced assets can release it afterwards.
+      bool releaseSourceData = !assetData.loadingInstances.empty();
+
       // if the asset is loaded, load the models
       for (auto& modelGuid : assetData.loadingInstances) {
         // get the model
         std::shared_ptr<Model> model = _models[modelGuid];
         if (model == nullptr) {
+          releaseSourceData = false;
           spdlog::error("[{}] Model {} not found", __FUNCTION__, modelGuid);
           continue;
         }
 
+        if (model->getInstancingMode() != ModelInstancingMode::none) {
+          releaseSourceData = false;
+        }
+
         if (model->isInScene()) {
           spdlog::warn("Model {} is already in scene, skipping load", model->name);
           continue;
@@ -471,6 +480,10 @@ void ModelSystem::updateAsyncAssetLoading() {
         }
       }
 
+      if (releaseSourceData && assetData.asset != nullptr) {
+        assetData.asset->releaseSourceData();
+      }
+
       // clear the loading instances
       assetData.loadingInstances.clear();
     }
@@ -574,14 +587,6 @@ void ModelSystem::loadModelFromFile(EntityGUID modelGuid, const std::string& bas
         model->setAsset(asset);
         _assets[assetPath].asset = asset;  // important! if not set, secondaries cannot be created
 
-        // release source data
-        if (model->getInstancingMode() == ModelInstancingMode::none) {
-          spdlog::trace("[loadModelFromFile] Non-secondary loaded: releasing source "
-                        "data");
-          asset->releaseSourceData();  // TODO: do we also call this for
-                                       // primaries after instancing?
-        }
-
         assetInstance = asset->getInstance();
         runtime_assert(
           assetInstance != nullptr, "[loadModelFromFile] Failed to fetch primary asset instance"
