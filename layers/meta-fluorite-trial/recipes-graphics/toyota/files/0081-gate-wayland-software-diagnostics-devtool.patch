From ebcf3ffbf78682d1768fbad22812e340bfc3f842 Mon Sep 17 00:00:00 2001
From: Codex Devtool <codex-devtool@localhost>
Date: Wed, 2 Sep 2026 14:05:04 +0000
Subject: [PATCH] fix: gate software surface diagnostics

---
 plugins/filament_view/core/scene/view_target.cc | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/plugins/filament_view/core/scene/view_target.cc b/plugins/filament_view/core/scene/view_target.cc
index 54598ff..e08fdd5 100644
--- a/plugins/filament_view/core/scene/view_target.cc
+++ b/plugins/filament_view/core/scene/view_target.cc
@@ -1046,11 +1046,12 @@ void ViewTarget::OnFrame(void* data, wl_callback* callback, const uint32_t time)
     const auto obj = static_cast<ViewTarget*>(data);
     const auto drawSoftwareFrame = std::make_shared<std::function<void(uint32_t)>>();
     *drawSoftwareFrame = [obj, drawSoftwareFrame](const uint32_t frameTime) {
       std::this_thread::sleep_for(std::chrono::milliseconds(100));
       obj->DrawFrame(frameTime);
-      if (obj->surface_ != nullptr) {
+      if (obj->surface_ != nullptr &&
+          std::getenv("FLR0026_WAYLAND_SOFTWARE_PROBE") != nullptr) {
         wl_surface_damage(
           obj->surface_,
           0,
           0,
           static_cast<int32_t>(obj->native_window_.width),
@@ -1115,11 +1116,12 @@ void ViewTarget::OnFrame(void* data, wl_callback* callback, const uint32_t time)
     spdlog::info("FLR0026_ONFRAME_AFTER_DRAW surfacePresent={}", obj->surface_ != nullptr);
 
     // Filament's Vulkan present may attach the child buffer without committing
     // the subsurface state. Commit the pending Wayland state explicitly so the
     // native surface can become visible to the compositor.
-    if (obj->surface_ != nullptr) {
+    if (obj->surface_ != nullptr &&
+        std::getenv("FLR0026_WAYLAND_SOFTWARE_PROBE") != nullptr) {
       wl_surface_commit(obj->surface_);
       spdlog::info("FLR0026_WAYLAND_SURFACE_COMMITTED committed=true");
     }
     obj->attachShmProbe();
 
