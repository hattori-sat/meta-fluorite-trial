From f71683efadb0365886e607c8a9ff942e345fca3d Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Tue, 15 Sep 2026 08:18:09 +0000
Subject: [PATCH] fix: avoid software frame promise deadlock on effective
 source

---
 .../filament_view/core/scene/view_target.cc   | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/plugins/filament_view/core/scene/view_target.cc b/plugins/filament_view/core/scene/view_target.cc
index 557eede..7cc69ac 100644
--- a/plugins/filament_view/core/scene/view_target.cc
+++ b/plugins/filament_view/core/scene/view_target.cc
@@ -38,6 +38,8 @@
 #include <filament/math/TMatHelpers.h>
 #include <filament/math/mat4.h>
 #include <filament/math/vec3.h>
+
+#include <functional>
 #include <filament/math/vec4.h>
 #include <filament/utils/EntityManager.h>
 #include <filamat/MaterialBuilder.h>
@@ -905,6 +907,24 @@ void ViewTarget::DrawFrame(const uint32_t time) {
 
 ////////////////////////////////////////////////////////////////////////////
 void ViewTarget::OnFrame(void* data, wl_callback* callback, const uint32_t time) {
+  // The QEMU/llvmpipe path has no Wayland callback. Keep it out of the
+  // callback/promise path: waiting for the previous promise on the ECS strand
+  // deadlocks the first software frame before DrawFrame can run.
+  if (callback == nullptr) {
+    const auto obj = static_cast<ViewTarget*>(data);
+    const auto drawSoftwareFrame = std::make_shared<std::function<void(uint32_t)>>();
+    *drawSoftwareFrame = [obj, drawSoftwareFrame](uint32_t frameTime) {
+      obj->DrawFrame(frameTime);
+      post(*ECSManager::GetInstance()->getStrand(), [drawSoftwareFrame, frameTime] {
+        (*drawSoftwareFrame)(frameTime + 100);
+      });
+    };
+    post(*ECSManager::GetInstance()->getStrand(), [drawSoftwareFrame, time] {
+      (*drawSoftwareFrame)(time);
+    });
+    return;
+  }
+
   // lock surface
   const auto obj = static_cast<ViewTarget*>(data);
   std::lock_guard<std::mutex> lock(obj->frameLock_);
