From 98f2b3e6b25420977c1eb4074b7254464d60fb9c Mon Sep 17 00:00:00 2001
From: Fluorite Devtool <fluorite-devtool@example.invalid>
Date: Sat, 19 Sep 2026 11:43:53 +0000
Subject: [PATCH] diag: add current pure native fixture control

---
 .../scene/serialization/scene_text_deserializer.cc  | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/plugins/filament_view/core/scene/serialization/scene_text_deserializer.cc b/plugins/filament_view/core/scene/serialization/scene_text_deserializer.cc
index a1cddd8ac..8e1a1c6d3 100644
--- a/plugins/filament_view/core/scene/serialization/scene_text_deserializer.cc
+++ b/plugins/filament_view/core/scene/serialization/scene_text_deserializer.cc
@@ -16,6 +16,7 @@
 #include "scene_text_deserializer.h"
 
 #include <asio/post.hpp>
+#include <cstdlib>
 #include <core/entity/base/entityobject.h>
 #include <core/include/literals.h>
 #include <core/systems/derived/collision_system.h>
@@ -195,6 +196,18 @@ void SceneTextDeserializer::DeserializeSceneLevel(const flutter::EncodableValue&
 void SceneTextDeserializer::RunPostSetupLoad() {
   spdlog::debug("Running post setup load...");
 
+  if (std::getenv("FLUORITE_NATIVE_PURE_FIXTURE") != nullptr) {
+    spdlog::info(
+      "FLUORITE_NATIVE_PURE_FIXTURE enabled=true models={} shapes={} lights={}",
+      models_.size(), shapes_.size(), lights_.size()
+    );
+    // Keep camera entities available to ViewTarget, but do not enqueue
+    // production GPU resources while the native fixture is isolated.
+    setUpEntities();
+    spdlog::info("FLUORITE_NATIVE_PURE_FIXTURE_SETUP_DONE");
+    return;
+  }
+
   spdlog::trace("setUpLoadingModels");
   setUpLoadingModels();
   spdlog::trace("setUpSkybox");
