#!/bin/sh
set -eu

# package.bbclass uses two fixed tar forms for perform_packagecopy. GNU tar
# 1.34's openat path handling fails under pseudo 1.9.0 on the build host, so
# translate only those forms to cpio while keeping cpio under pseudo.
if [ "${1:-}" = "--exclude=./sysroot-only" ]; then
    shift
fi

if [ "${1:-}" = "-cf" ] && [ "${2:-}" = "-" ] && [ "${3:-}" = "-C" ] && [ "${5:-}" = "-p" ] && [ "${6:-}" = "-S" ] && [ "${7:-}" = "." ]; then
    src=$4
    cd "$src"
    find . -path ./sysroot-only -prune -o -print0 | cpio --null -o -H newc
    exit $?
fi

if [ "${1:-}" = "-xf" ] && [ "${2:-}" = "-" ] && [ "${3:-}" = "-C" ] && [ "$#" -eq 4 ]; then
    dest=$4
    cd "$dest"
    cpio -idm
    exit $?
fi

exec /usr/bin/tar "$@"
