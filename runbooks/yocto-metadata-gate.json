{
  "schema": "fluorite.runbook/v1",
  "id": "yocto-metadata-gate",
  "title": "Bounded qemux86-64 metadata gate",
  "description": "Evaluate only the fixed AGL Flutter image metadata in the configured qemux86-64 build environment.",
  "risk": "metadata_write",
  "parameters": {},
  "steps": [{
    "id": "effective-image-metadata",
    "argv": ["bitbake", "-e", "agl-ivi-image-flutter"],
    "root": "yocto_build",
    "environment_profile": "yocto",
    "timeout_seconds": 600,
    "inactivity_timeout_seconds": 180
  }]
}
