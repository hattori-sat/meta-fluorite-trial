        "subject_id": "build-execution-snapshot",
        "revision_or_image_id": null
      },
      "roots": {
        "yocto_build": "/role/path/to/yocto/build"
      }
    }
  },
  "command_runner": {
    "allow_execution": false,
    "environment_profiles": {
      "yocto": {
        "setup_script": "/role/path/to/fixed-environment-wrapper.sh",
        "source_arguments": [],
        "environment": {}
      }
    }
  }
