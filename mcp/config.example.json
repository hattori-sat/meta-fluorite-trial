        "meta_agl": "/role/path/to/agl/source/meta-agl"
      }
    },
    "yocto": {
      "identity": {
        "subject_id": "yocto-build-snapshot",
        "revision_or_image_id": null
      },
      "roots": {
        "poky_metadata": "/role/path/to/agl/source/external/poky/meta",
        "project_metadata": "/role/path/to/agl/source/meta-local",
        "task_logs": "/role/path/to/yocto/build/tmp/work"
      }
    },
    "fluorite": {
      "identity": {
        "subject_id": "fluorite-source",
        "revision_or_image_id": null
      },
      "roots": {
        "fluorite_source": "/role/path/to/fluorite"
      }
    },
    "flutter_runtime": {
      "identity": {
        "subject_id": "flutter-runtime-source-set",
        "revision_or_image_id": null
      },
      "roots": {
